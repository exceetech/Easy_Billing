<?xml version="1.0" encoding="utf-8"?>
<!-- Downloadable Google Font (Caveat) — fetched via Google Play Services at
     runtime, same pattern as marcellus.xml, for the signature-style wordmark
     ("Ex" maroon / "POS" gold) on the splash screen and header. -->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="Caveat"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs">
</font-family>
