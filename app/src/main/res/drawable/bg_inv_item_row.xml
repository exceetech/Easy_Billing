<?xml version="1.0" encoding="utf-8"?>
<!-- Per-line-item card wrapper inside the Line Items list, same solid
     white, high-contrast treatment as bg_inv_field_contrast, so each
     item reads as its own separated row instead of blending together. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="13dp"/>
    <solid android:color="#FFFFFF"/>
    <stroke android:width="1dp" android:color="#D8CFB8"/>
</shape>
