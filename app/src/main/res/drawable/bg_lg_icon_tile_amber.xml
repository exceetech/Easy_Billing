<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient icon tile for the full-screen notice screens (force update / account suspended). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient android:type="linear" android:angle="315"
                android:startColor="#E0A243" android:centerColor="#BA7517" android:endColor="#8A5410"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#40FFFFFF"/>
        </shape>
    </item>
</layer-list>
