<?xml version="1.0" encoding="utf-8"?>
<!-- Tactile numeric key, resting state — a hairline-bordered cream tile
     lifted off the page by a thin bottom "shadow" strip, so pressing it
     (bg_pin_key_pressed) reads as the key physically settling down. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#EAE2D1"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FDFAF2"/>
            <stroke android:width="1dp" android:color="#EAE2D1"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
