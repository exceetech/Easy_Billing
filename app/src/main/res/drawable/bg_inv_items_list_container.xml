<?xml version="1.0" encoding="utf-8"?>
<!-- Wraps rvInvoiceItems as one unified list card, replacing the old
     per-item boxed cards, so rows separate with thin internal dividers
     instead of gaps and their own borders. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp"/>
    <solid android:color="#FFFFFF"/>
    <stroke android:width="1dp" android:color="#E9E1CE"/>
</shape>
