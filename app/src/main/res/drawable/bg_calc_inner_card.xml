<?xml version="1.0" encoding="utf-8"?>
<!-- Inner card holding the calculation rows, nested inside the outer
     "Profit calculation" card. Slightly smaller radius than the outer
     card so it reads as a card-within-a-card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp"/>
    <solid android:color="#FBFCFB"/>
    <stroke android:width="1dp" android:color="#E0E6E2"/>
</shape>
