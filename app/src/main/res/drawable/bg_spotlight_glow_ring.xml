<?xml version="1.0" encoding="utf-8"?>
<!-- Pulsing highlight ring used to spotlight a field during the
     "Add stock" quick-entry dialog. Sits behind the field's own
     background (bg_inv_field_light_grey) with a negative margin so
     only the glowing border peeks out. Its alpha is animated in
     Kotlin (PurchaseLineDialog) to create a slow breathing effect —
     purely visual, no behaviour change. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000"/>
    <stroke android:width="2.5dp" android:color="#F2A93B"/>
    <corners android:radius="14dp"/>
</shape>
