        android:pathData="M -60,100 Q 20,84 100,100 T 260,100 T 420,100 T 580,100 T 740,100 V 400 H -60 Z"
        android:fillColor="#40E9DABE"/>

    <path
        android:pathData="M -80,160 Q 0,142 80,160 T 240,160 T 400,160 T 560,160 T 720,160 V 400 H -80 Z"
        android:fillColor="#48E2CFAD"/>

    <path
        android:pathData="M -50,220 Q 30,204 110,220 T 270,220 T 430,220 T 590,220 T 750,220 V 400 H -50 Z"
        android:fillColor="#48F6EEDF"/>

    <path
        android:pathData="M -70,280 Q 10,266 90,280 T 250,280 T 410,280 T 570,280 T 730,280 V 400 H -70 Z"
