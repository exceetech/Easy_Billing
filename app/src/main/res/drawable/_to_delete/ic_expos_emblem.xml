<?xml version="1.0" encoding="utf-8"?>
<!-- Expos emblem — a continuous "E" letterform on a teal gradient
     icon-badge, matching the rounded-square + glass-sheen badge language
     used throughout the app (field icon chips, Save button icon, etc). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="78dp"
    android:height="78dp"
    android:viewportWidth="100.0"
    android:viewportHeight="100.0">

    <!-- Rounded-square badge background, diagonal teal gradient — same
         angle/colors as bg_pay_chip_green_premium. -->
    <path android:pathData="M26,4 L74,4 A22,22 0 0 1 96,26 L96,74 A22,22 0 0 1 74,96 L26,96 A22,22 0 0 1 4,74 L4,26 A22,22 0 0 1 26,4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="10"
                android:endX="90"
                android:endY="90"
                android:startColor="#18946E"
                android:centerColor="#0F6E56"
                android:endColor="#0A4C3C"/>
        </aapt:attr>
    </path>

    <!-- Glass sheen across the top of the badge. -->
    <path android:pathData="M26,4 L74,4 A22,22 0 0 1 96,26 L96,50 L4,50 L4,26 A22,22 0 0 1 26,4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="50"
                android:startY="4"
                android:endX="50"
                android:endY="50"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"/>
        </aapt:attr>
    </path>

    <!-- The "E" — one continuous shape (spine + three arms), solid white. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36.4,29.6 L63.6,29.6 L63.6,38.1 L44.9,38.1 L44.9,45.8 L60.2,45.8 L60.2,54.3 L44.9,54.3 L44.9,62.9 L63.6,62.9 L63.6,70.4 L36.4,70.4 Z" />
</vector>
