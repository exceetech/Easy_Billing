<?xml version="1.0" encoding="utf-8"?>
<!-- Soft purple pill used for the "brand" tag on purchase line items
     (item_purchase_line.xml / PurchaseLinesAdapter) — matches the light
     fill + stroke style of bg_pill_blue.xml used for the "type" tag. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp"/>
    <solid android:color="#F2EAFA"/>
    <stroke android:width="1dp" android:color="#E0CCF0"/>
</shape>
