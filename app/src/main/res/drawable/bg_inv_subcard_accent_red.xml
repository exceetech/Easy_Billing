<?xml version="1.0" encoding="utf-8"?>
<!-- Red-accent sub-card border, matching bg_inv_subcard_accent_green/_amber's
     pattern (cream fill, bordered, NOT solid-filled) — used for Bill Details'
     "Still owed" statement so it reads as a proper bordered statement card
     instead of a flat stretched pill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FCFAF4"/>
    <corners android:radius="13dp"/>
    <stroke android:width="1.5dp" android:color="#B23A3A"/>
</shape>
