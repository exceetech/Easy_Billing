<?xml version="1.0" encoding="utf-8"?>
<!-- Solid white input, used inside a tinted sub-card so the field itself
     stands out instead of blending into the card's own background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="11dp"/>
    <solid android:color="#FFFFFF"/>
    <stroke android:width="1dp" android:color="#D8CFB8"/>
</shape>
