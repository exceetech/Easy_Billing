<?xml version="1.0" encoding="utf-8"?>
<!-- Glass CTA (gold): gradient with a soft edge highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="0dp"/>
            <gradient android:type="linear" android:angle="315" android:startColor="#B58A3C" android:centerColor="#8A6526" android:endColor="#5E4316"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="0dp"/>
            <stroke android:width="1dp" android:color="#33FFFFFF"/>
        </shape>
    </item>
</layer-list>
