<?xml version="1.0" encoding="utf-8"?>
<!-- Glass numeric key for the quantity pad: white, soft edge, tints emerald when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <solid android:color="#E3F1EC"/>
            <stroke android:width="1dp" android:color="#330F6E56"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient android:type="linear" android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFF1F5F3"/>
            <stroke android:width="1dp" android:color="#1A0B3B30"/>
        </shape>
    </item>
</selector>
