<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <solid android:color="#F6DCDA"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient android:type="linear" android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFF8EFEE"/>
            <stroke android:width="1dp" android:color="#1AB23A3A"/>
        </shape>
    </item>
</selector>
