<?xml version="1.0" encoding="utf-8"?>
<!-- Plain glass card, same look as the login card: white pane, soft sheen, white inner highlight, neutral hairline edge. No colour tint. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#FFFFFFFF" android:endColor="#FFF4F5F5"/>
            <stroke android:width="1dp" android:color="#1F000000"/>
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient android:type="linear" android:angle="315"
                android:startColor="#99FFFFFF" android:centerColor="#1AFFFFFF" android:endColor="#00FFFFFF"/>
            <stroke android:width="1dp" android:color="#CCFFFFFF"/>
        </shape>
    </item>
</layer-list>
