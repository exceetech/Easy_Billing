<?xml version="1.0" encoding="utf-8"?>
<!--
    Champagne-theme rewrite of bg_batch_qty_input — cream fill, hairline
    stroke, teal on focus. Used by item_batch_pick.xml's etBatchQty in
    the full-screen Reduce Stock page.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#0F6E56" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FAF6EE" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#E4D9C4" />
        </shape>
    </item>
</selector>
