<?xml version="1.0" encoding="utf-8"?>

<!-- Background for the expanded product-detail box (item_profit_simple's
     layoutDetail). The row's own background (bg_inv_value_card) is opaque
     white and edge-to-edge, so without this the detail box's plain white
     fill was painting straight over the card's thin border on the right
     and bottom edges whenever a row was expanded, so the outer rounded
     border looked like it stopped at the header. This repeats that same
     stroke/corner radius, rounded only on the bottom-right corner.

     The bottom-left stays square on purpose: this box sits to the right
     of the colored stripe View, not at the card's true left edge, so a
     rounded bottom-left corner here would curve away from the stripe's
     straight edge and fight with it right at the corner. The card's own
     background (bg_inv_value_card) plus clipToOutline on the row already
     round the real bottom-left corner across the stripe + this box
     together, so nothing needs repeating here. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF"/>
    <stroke android:width="0.5dp" android:color="#ECE7DA"/>
    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="18dp"/>
</shape>
