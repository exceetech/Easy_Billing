<?xml version="1.0" encoding="utf-8"?>
<!-- Glass numeric key, pressed state: tile drops flush onto the strip and picks up a faint emerald tint. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F0B3B30"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#E6DDF3EC"/>
            <stroke android:width="1dp" android:color="#F2FFFFFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
