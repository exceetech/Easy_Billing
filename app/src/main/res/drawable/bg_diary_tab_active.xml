<?xml version="1.0" encoding="utf-8"?>
<!-- Active diary index-tab: same white as the calculation card, with
     only the top corners rounded, so it visually fuses into the card
     directly below it (like the page you have open in a diary). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:topLeftRadius="10dp" android:topRightRadius="10dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
    <solid android:color="#FFFDF8"/>
    <stroke android:width="1dp" android:color="#EEE7D8"/>
</shape>
