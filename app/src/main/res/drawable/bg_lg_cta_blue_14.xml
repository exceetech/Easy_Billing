<?xml version="1.0" encoding="utf-8"?>
<!-- Glass CTA (blue): gradient with a soft edge highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <gradient android:type="linear" android:angle="315" android:startColor="#3F7FD1" android:centerColor="#2563AB" android:endColor="#17407A"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#33FFFFFF"/>
        </shape>
    </item>
</layer-list>
