<?xml version="1.0" encoding="utf-8"?>
<!-- Floating cart bar: emerald glass gradient (replaces the near-black bar). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient android:type="linear" android:angle="315"
                android:startColor="#1E8F72" android:centerColor="#0F6E56" android:endColor="#0A4D3D"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient android:type="linear" android:angle="315"
                android:startColor="#40FFFFFF" android:centerColor="#0DFFFFFF" android:endColor="#00FFFFFF"/>
            <stroke android:width="1dp" android:color="#33FFFFFF"/>
        </shape>
    </item>
</layer-list>
