<?xml version="1.0" encoding="utf-8"?>
<!-- Diagonal light sheen for the glassmorphic login card — a soft
     white highlight top-left fading to nothing, mimicking light
     catching the top edge of frosted glass. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#33FFFFFF"
        android:centerColor="#0DFFFFFF"
        android:endColor="#00FFFFFF"
        android:type="linear"/>
</shape>
