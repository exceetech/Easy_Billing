<?xml version="1.0" encoding="utf-8"?>
<!-- Glass CTA (red): gradient with a soft edge highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient android:type="linear" android:angle="315" android:startColor="#CF5A5A" android:centerColor="#B23A3A" android:endColor="#7E2424"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#33FFFFFF"/>
        </shape>
    </item>
</layer-list>
