<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Pre-API-31 equivalent of data_extraction_rules.xml's cloud-backup
         exclusion — same reasoning: keep sales/billing/customer financial
         data out of Android's full-data backup. -->
    <exclude domain="database" path="easy_billing_db"/>
    <exclude domain="database" path="easy_billing_db-wal"/>
    <exclude domain="database" path="easy_billing_db-shm"/>
</full-backup-content>