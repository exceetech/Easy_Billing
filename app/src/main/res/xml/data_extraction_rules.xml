<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- The Room DB (easy_billing_db, plus its -wal/-shm files) holds
         sales/billing/customer financial data. Excluded from cloud-backup
         (Google Drive) so it never leaves the device over the network.
         Left IN for device-transfer (the direct device-to-device "copy
         your data" flow when a user sets up a new phone), since keeping
         billing history/continuity there is a real feature, not a risk —
         that path stays on-device/local, unlike cloud-backup. -->
    <cloud-backup>
        <exclude domain="database" path="easy_billing_db"/>
        <exclude domain="database" path="easy_billing_db-wal"/>
        <exclude domain="database" path="easy_billing_db-shm"/>
    </cloud-backup>
</data-extraction-rules>