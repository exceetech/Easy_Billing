<?xml version="1.0" encoding="utf-8"?>

<!--
  Profit-per-product leaderboard row — rank badge (gold-tinted for #1, neutral
  for the rest) + name/value line + a slim rounded progress bar underneath,
  instead of the old bold-name-and-flat-bar row.

  Bound by ProfitChartAdapter: tvRank, tvName, tvValue, barFill, barRest.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="7dp">

    <TextView
        android:id="@+id/tvRank"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:text="1"
        android:textSize="10.5sp"
        android:fontFamily="@font/googlesans_bold"
        android:textColor="#8A6526"
        android:background="@drawable/bg_credit_avatar"
        android:backgroundTint="#FAEEDA"
        android:includeFontPadding="false"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="Product name"
                android:textSize="12.5sp"
                android:fontFamily="@font/googlesans_medium"
                android:textColor="#1A1A18"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/tvValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:textColor="#0F6E56"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_bar_track">
            <View
                android:id="@+id/barFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_bar_fill"
                android:backgroundTint="#1D9E75"/>
            <View
                android:id="@+id/barRest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
