<?xml version="1.0" encoding="utf-8"?>
<!--
    Login screen — phone layout (branding stacked above the form).

    This is the DEFAULT (phone) version. The original side-by-side
    branding-pane + form design lives unchanged in
    layout-sw600dp/activity_main.xml — tablets load that version
    automatically via Android's screen-width resource qualifier, phones
    load this one. See phone_compatibility_plan.md Phase 7.

    IMPORTANT: brandingPane is NOT decorative — MainActivity.kt uses it
    for a swipe-to-navigate-to-Register gesture (setupSlideToToggle) and
    a shared-element transition (transitionName="shared_branding_pane")
    into RegisterActivity. Every id and transitionName here is preserved
    exactly as in the tablet version; only the OUTER arrangement changed
    from a horizontal weighted split to a vertical stack, so none of that
    Kotlin code needed to change.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_doodle"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- ============ CENTERED GLASS CARD ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mainContainerCard"
        android:theme="@style/ThemeOverlay.NoElevationOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="24dp"
        android:foreground="@drawable/bg_login_card_glass_sheen"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#F2FBF9F4"
        app:strokeColor="#D8C3A0"
        app:strokeWidth="1.5dp"
        app:rippleColor="#00000000"
        app:layout_constraintWidth_max="640dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false">

            <!-- ===== BRAND (stacked header, was a side pane on tablet) ===== -->
            <LinearLayout
                android:id="@+id/brandingPane"
                android:transitionName="shared_branding_pane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:paddingHorizontal="26dp"
                android:paddingTop="26dp"
                android:paddingBottom="16dp">

                <!-- hidden logo (kept for shared-element + entrance) -->
                <ImageView
                    android:id="@+id/brandLogo"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:contentDescription="@null"/>
                <ImageView
                    android:id="@+id/imgIllustration"
                    android:transitionName="shared_image_pane"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:contentDescription="@null"/>

                <LinearLayout
                    android:id="@+id/brandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ex_word"
                        android:textColor="#1A1A18"
                        android:textSize="30sp"
                        android:fontFamily="@font/marcellus"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pos_word"
                        android:textColor="#B8895A"
                        android:textSize="30sp"
                        android:fontFamily="@font/marcellus"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/brandTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/point_of_sale_tagline"
                    android:textColor="#9A8F79"
                    android:textSize="10sp"
                    android:letterSpacing="0.18"
                    android:fontFamily="@font/googlesans_semibold"/>

                <LinearLayout
                    android:id="@+id/brandFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_feat_receipt"
                            android:contentDescription="@null"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/feature_gst_billing"
                            android:textColor="#3A3733"
                            android:textSize="13sp"
                            android:fontFamily="@font/googlesans_medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="15dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_feat_package"
                            android:contentDescription="@null"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/feature_live_inventory"
                            android:textColor="#3A3733"
                            android:textSize="13sp"
                            android:fontFamily="@font/googlesans_medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="15dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_feat_chart"
                            android:contentDescription="@null"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/feature_business_analytics"
                            android:textColor="#3A3733"
                            android:textSize="13sp"
                            android:fontFamily="@font/googlesans_medium"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- divider (horizontal now, between the stacked brand header and form) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="26dp"
                android:background="#E6DDCB"/>

            <!-- ===== FORM (was the right pane, now full width below the brand header) ===== -->
            <LinearLayout
                android:id="@+id/loginContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="26dp"
                android:paddingVertical="26dp">

                <!-- Tabs (loginHeader) -->
                <LinearLayout
                    android:id="@+id/loginHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_login_tab_track"
                    android:padding="3dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="@string/login"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:background="@drawable/bg_login_tab_active"/>
                    <TextView
                        android:id="@+id/tvRegister"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="@string/sign_up"
                        android:textColor="#8C8576"
                        android:textSize="13sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/loginForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/lblEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/email_address"
                        android:textSize="12.5sp"
                        android:textColor="#9A968C"
                        android:fontFamily="@font/googlesans_regular"/>

                    <FrameLayout
                        android:id="@+id/usernameContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_input">
                        <ImageView
                            android:id="@+id/iconUsername"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="14dp"
                            android:src="@drawable/ic_lc_mail"
                            app:tint="#B8895A"
                            android:contentDescription="@null"/>
                        <EditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="50dp"
                            android:background="@null"
                            android:paddingVertical="10dp"
                            android:paddingStart="44dp"
                            android:paddingEnd="14dp"
                            android:hint="@string/email"
                            android:textColor="#1A1A18"
                            android:textColorHint="#A99E88"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:textSize="14sp"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/lblPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/password"
                        android:textSize="12.5sp"
                        android:textColor="#9A968C"
                        android:fontFamily="@font/googlesans_regular"/>

                    <FrameLayout
                        android:id="@+id/passwordContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_input">
                        <ImageView
                            android:id="@+id/iconPassword"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="14dp"
                            android:src="@drawable/ic_lc_lock"
                            app:tint="#B8895A"
                            android:contentDescription="@null"/>
                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="50dp"
                            android:background="@null"
                            android:paddingVertical="10dp"
                            android:paddingStart="44dp"
                            android:paddingEnd="46dp"
                            android:hint="@string/enter_your_password_hint"
                            android:textColor="#1A1A18"
                            android:textColorHint="#A99E88"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:textSize="14sp"/>
                        <ImageView
                            android:id="@+id/btnTogglePassword"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_lc_eye_off"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#B8895A"
                            android:contentDescription="@null"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="9dp"
                        android:text="@string/forgot_password_2"
                        android:textColor="#0F6E56"
                        android:textSize="12sp"
                        android:fontFamily="@font/googlesans_medium"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_login_cta_green"
                        app:backgroundTint="@null"
                        android:text="@string/login"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textAllCaps="false"
                        android:fontFamily="@font/googlesans_semibold"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_cta_arrow"
                        app:iconGravity="textEnd"
                        app:iconTint="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/loginFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="14dp">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_security_login"
                        app:tint="#9A8F79"
                        android:contentDescription="@null"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="@string/secured_encryption_note"
                        android:textColor="#9A8F79"
                        android:textSize="10sp"/>
                </LinearLayout>

                <!-- Powered-by footer: wax-seal style monogram badge. -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_powered_by_divider"/>

                <LinearLayout
                    android:id="@+id/poweredByFooter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_powered_by_seal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="19dp"
                            android:layout_gravity="center"
                            android:adjustViewBounds="true"
                            android:src="@drawable/ic_scalancer_emblem"
                            android:contentDescription="@string/powered_by_scalancer"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/powered_by_label"
                        android:textColor="#B4A98F"
                        android:textSize="7sp"
                        android:letterSpacing="0.16"
                        android:fontFamily="@font/googlesans_medium"/>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"
                        android:layout_marginTop="3dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_scalancer_wordmark"
                        android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Shown only while checkExistingSession() (an auto-login network
         call, up to 35s worst-case on slow/no connectivity) is deciding
         whether to keep this screen hidden and jump straight to
         Dashboard. This is a separate opaque overlay drawn ON TOP of
         mainContainerCard rather than mainContainerCard itself being
         hidden — mainContainerCard is a shared-element transition target
         (transitionName via brandingPane) animating in from
         SplashActivity, and toggling ITS visibility mid-transition is
         what caused the silent crash/quit this replaced. See
         MainActivity.checkExistingSession(). -->
    <FrameLayout
        android:id="@+id/sessionCheckOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_login_doodle"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressSessionCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#0F6E56" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
