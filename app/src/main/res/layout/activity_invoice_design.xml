<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0E6">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Title + Edit action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/print_layout_eyebrow"
                        android:textColor="#B8895A"
                        android:textSize="10sp"
                        android:letterSpacing="0.16"
                        android:fontFamily="@font/googlesans_semibold"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/invoice_document_type_invoice"
                            android:textColor="#1A1A18"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02"
                            android:fontFamily="@font/googlesans_bold"
                            android:includeFontPadding="false"
                            android:accessibilityHeading="true"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/design_word"
                            android:textColor="#0F6E56"
                            android:textSize="21sp"
                            android:fontFamily="serif"
                            android:textStyle="italic"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Edit pill (toggles edit mode) — gold gradient, same
                     as the Unlock pill in activity_data_security.xml. -->
                <LinearLayout
                    android:id="@+id/btnEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_inv_seg_selected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_si_edit"
                        app:tint="#1A1A18"
                        android:contentDescription="@string/edit"/>

                    <TextView
                        android:id="@+id/tvEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit"
                        android:textColor="#1A1A18"
                        android:textSize="13sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== RECEIPT FOOTER ===================== -->
            <!-- cardFooter/cardShowOnReceipt: faded (alpha 0.55) until
                 Edit is tapped, same locked/unlocked feel as
                 activity_data_security.xml's protected rows. -->
            <!-- ===================== RECEIPT FOOTER ===================== -->
            <LinearLayout android:id="@+id/cardFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_inv_card_cream"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_inv_items_header"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@drawable/bg_step_circle_ring_champagne"/>
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:layout_gravity="center" android:src="@drawable/ic_si_message"
                            app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:text="Receipt footer" android:textColor="#1A1A18" android:textSize="14sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Custom message on printed bills" android:textColor="#5C6B65"
                            android:textSize="11sp" android:layout_marginTop="1dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView android:text="1 field" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="#8A6526" android:paddingHorizontal="11dp" android:paddingVertical="5dp"
                        android:background="@drawable/bg_pill_amber" android:letterSpacing="0.06"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/footer_message"
                        android:textSize="11sp"
                        android:textColor="#6E6A60"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:paddingHorizontal="12dp">
                        <FrameLayout android:layout_width="26dp" android:layout_height="26dp"
                            android:background="@drawable/bg_circle_soft_teal">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                android:layout_gravity="center" android:src="@drawable/ic_si_message"
                                app:tint="#0F6E56" android:contentDescription="@null"/>
                        </FrameLayout>
                        <EditText
                            android:id="@+id/etFooter"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:layout_marginStart="12dp"
                            android:hint="@string/footer_message"
                            android:textColor="#1A1A18"
                            android:textColorHint="#A99E88"
                            android:inputType="textCapSentences"
                            android:singleLine="true"
                            android:textSize="15sp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/printed_bottom_receipt_helper"
                        android:textColor="#9A8F79"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== SHOW ON RECEIPT ===================== -->
            <!-- ===================== SHOW ON RECEIPT ===================== -->
            <LinearLayout
                android:id="@+id/cardShowOnReceipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_inv_card_cream"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_inv_tax_header"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@drawable/bg_step_circle_ring"/>
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:layout_gravity="center" android:src="@drawable/ic_lucide_eye"
                            app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:text="Show on receipt" android:textColor="#1A1A18" android:textSize="14sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Choose what appears on invoices" android:textColor="#5C6B65"
                            android:textSize="11sp" android:layout_marginTop="1dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView android:text="5 toggles" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="#0F6E56" android:paddingHorizontal="11dp" android:paddingVertical="5dp"
                        android:background="@drawable/bg_pill_green" android:letterSpacing="0.06"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">

                    <!-- Store logo -->
                    <LinearLayout android:id="@+id/rowLogo"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:paddingHorizontal="12dp">
                        <FrameLayout android:layout_width="26dp" android:layout_height="26dp"
                            android:background="@drawable/bg_circle_soft_purple">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                android:layout_gravity="center" android:src="@drawable/ic_si_image"
                                app:tint="#7A4FA3" android:contentDescription="@null"/>
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:text="@string/show_store_logo"
                            android:textColor="#1A1A18" android:textSize="13.5sp" android:textStyle="bold"/>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchShowLogo" style="@style/EpSwitch"/>
                    </LinearLayout>

                    <!-- GSTIN -->
                    <LinearLayout android:id="@+id/rowGstin"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:paddingHorizontal="12dp">
                        <FrameLayout android:layout_width="26dp" android:layout_height="26dp"
                            android:background="@drawable/bg_circle_soft_rose">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                android:layout_gravity="center" android:src="@drawable/ic_si_tax"
                                app:tint="#791F1F" android:contentDescription="@null"/>
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:text="@string/show_gstin"
                            android:textColor="#1A1A18" android:textSize="13.5sp" android:textStyle="bold"/>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchShowGstin" style="@style/EpSwitch"/>
                    </LinearLayout>

                    <!-- Phone number -->
                    <LinearLayout android:id="@+id/rowPhone"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:paddingHorizontal="12dp">
                        <FrameLayout android:layout_width="26dp" android:layout_height="26dp"
                            android:background="@drawable/bg_circle_soft_amber">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                android:layout_gravity="center" android:src="@drawable/ic_si_phone"
                                app:tint="#8A6526" android:contentDescription="@null"/>
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:text="@string/show_phone_number"
                            android:textColor="#1A1A18" android:textSize="13.5sp" android:textStyle="bold"/>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchShowPhone" style="@style/EpSwitch"/>
                    </LinearLayout>

                    <!-- Discount section -->
                    <LinearLayout android:id="@+id/rowDiscount"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:paddingHorizontal="12dp">
                        <FrameLayout android:layout_width="26dp" android:layout_height="26dp"
                            android:background="@drawable/bg_circle_soft_teal">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                android:layout_gravity="center" android:src="@drawable/ic_si_percent"
                                app:tint="#0F6E56" android:contentDescription="@null"/>
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:text="@string/show_discount_section"
                            android:textColor="#1A1A18" android:textSize="13.5sp" android:textStyle="bold"/>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchShowDiscount" style="@style/EpSwitch"/>
                    </LinearLayout>

                    <!-- Round off total -->
                    <LinearLayout android:id="@+id/rowRoundOff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:minHeight="58dp">
                        <FrameLayout android:layout_width="26dp" android:layout_height="26dp"
                            android:background="@drawable/bg_circle_soft_amber">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                android:layout_gravity="center" android:src="@drawable/ic_si_calc"
                                app:tint="#B8895A" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:text="@string/enable_round_off" android:textColor="#1A1A18"
                                android:textSize="13.5sp" android:textStyle="bold"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="@string/round_grand_total_helper" android:textColor="#9A8F79"
                                android:textSize="10.5sp" android:layout_marginTop="1dp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRoundOff" style="@style/EpSwitch"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Save — solid teal CTA matching the app's confirm buttons
                 (bg_login_cta_green), instead of SiSavePill's navy. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveDesign"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="@string/save_design_settings"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="13.5sp"
                android:fontFamily="@font/googlesans_semibold"
                android:includeFontPadding="false"
                android:background="@drawable/bg_login_cta_green"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                app:elevation="0dp"
                app:icon="@drawable/ic_lucide_check"
                app:iconTint="#FFFFFF"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:iconPadding="7dp"
                app:cornerRadius="14dp"
                app:rippleColor="#33FFFFFF"
                android:visibility="gone"
            android:gravity="center"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
