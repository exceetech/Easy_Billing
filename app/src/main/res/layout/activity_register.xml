<?xml version="1.0" encoding="utf-8"?>
<!--
    Sign-up screen — phone layout (branding stacked above the form).

    This is the DEFAULT (phone) version. The original side-by-side
    branding-pane + form design lives unchanged in
    layout-sw600dp/activity_register.xml — tablets load that version
    automatically via Android's screen-width resource qualifier, phones
    load this one. See phone_compatibility_plan.md Phase 7.

    IMPORTANT: brandingPane is NOT decorative — RegisterActivity.kt uses
    it for a swipe-to-navigate-back-to-Login gesture (setupSlideToToggle)
    and a shared-element transition (transitionName="shared_branding_pane")
    from MainActivity. Every id and transitionName here is preserved
    exactly as in the tablet version; only the OUTER arrangement changed
    from a horizontal weighted split to a vertical stack.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_doodle"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mainContainerCard"
        android:theme="@style/ThemeOverlay.NoElevationOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="22dp"
        android:foreground="@drawable/bg_login_card_glass_sheen"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#F2FBF9F4"
        app:strokeColor="#D8C3A0"
        app:strokeWidth="1.5dp"
        app:rippleColor="#00000000"
        app:layout_constraintWidth_max="660dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false">

            <!-- ===== BRAND (stacked header, was a side pane on tablet) ===== -->
            <LinearLayout
                android:id="@+id/brandingPane"
                android:transitionName="shared_branding_pane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:paddingHorizontal="26dp"
                android:paddingTop="26dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/brandLogo"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:contentDescription="@null"/>

                <LinearLayout
                    android:id="@+id/brandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ex"
                        android:textColor="#1A1A18"
                        android:textSize="30sp"
                        android:fontFamily="@font/marcellus"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POS"
                        android:textColor="#B8895A"
                        android:textSize="30sp"
                        android:fontFamily="@font/marcellus"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/brandTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/point_of_sale_tagline"
                    android:textColor="#9A8F79"
                    android:textSize="10sp"
                    android:letterSpacing="0.18"
                    android:fontFamily="@font/googlesans_semibold"/>

                <LinearLayout
                    android:id="@+id/brandFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_feat_receipt" android:contentDescription="@null"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" android:text="@string/feature_gst_billing"
                            android:textColor="#3A3733" android:textSize="13sp" android:fontFamily="@font/googlesans_medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="15dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_feat_package" android:contentDescription="@null"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" android:text="@string/feature_live_inventory"
                            android:textColor="#3A3733" android:textSize="13sp" android:fontFamily="@font/googlesans_medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="15dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_feat_chart" android:contentDescription="@null"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" android:text="@string/feature_business_analytics"
                            android:textColor="#3A3733" android:textSize="13sp" android:fontFamily="@font/googlesans_medium"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- divider (horizontal now, between the stacked brand header and form) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24dp"
                android:background="#E6DDCB"/>

            <!-- ===== SIGN-UP FORM (was the right pane, now full width below the brand header) ===== -->
            <LinearLayout
                android:id="@+id/registerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="22dp">

                <LinearLayout
                    android:id="@+id/registerHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_login_tab_track"
                    android:padding="3dp">
                    <TextView
                        android:id="@+id/tvBackToLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="@string/login_2"
                        android:textColor="#8C8576"
                        android:textSize="13sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="@string/sign_up"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:background="@drawable/bg_login_tab_active"/>
                </LinearLayout>

                <TextView android:id="@+id/lblFullName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:layout_marginBottom="6dp"
                    android:text="@string/full_name_2" android:textSize="12.5sp" android:textColor="#9A968C"
                    android:fontFamily="@font/googlesans_regular"/>
                <FrameLayout
                    android:id="@+id/nameContainer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_glass_input">
                    <ImageView android:id="@+id/iconFullName" android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_gravity="center_vertical|start" android:layout_marginStart="13dp"
                        android:src="@drawable/ic_lc_user" app:tint="#B8895A" android:contentDescription="@null"/>
                    <EditText android:id="@+id/etFullName" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:paddingStart="42dp" android:paddingEnd="13dp"
                        android:hint="@string/as_per_your_id_hint" android:textColor="#1A1A18" android:textColorHint="#A99E88"
                        android:inputType="textPersonName" android:singleLine="true" android:textSize="15sp"/>
                </FrameLayout>

                <TextView android:id="@+id/lblEmail" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:layout_marginBottom="6dp"
                    android:text="@string/email_address" android:textSize="12.5sp" android:textColor="#9A968C"
                    android:fontFamily="@font/googlesans_regular"/>
                <FrameLayout
                    android:id="@+id/emailContainer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_glass_input">
                    <ImageView android:id="@+id/iconEmail" android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_gravity="center_vertical|start" android:layout_marginStart="13dp"
                        android:src="@drawable/ic_lc_mail" app:tint="#B8895A" android:contentDescription="@null"/>
                    <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:paddingStart="42dp" android:paddingEnd="13dp"
                        android:hint="@string/for_login_receipts_hint" android:textColor="#1A1A18" android:textColorHint="#A99E88"
                        android:inputType="textEmailAddress" android:singleLine="true" android:textSize="15sp"/>
                </FrameLayout>

                <TextView android:id="@+id/lblPhone" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:layout_marginBottom="6dp"
                    android:text="@string/invoice_hint_phone_number" android:textSize="12.5sp" android:textColor="#9A968C"
                    android:fontFamily="@font/googlesans_regular"/>
                <FrameLayout
                    android:id="@+id/phoneContainer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_glass_input">
                    <ImageView android:id="@+id/iconPhone" android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_gravity="center_vertical|start" android:layout_marginStart="13dp"
                        android:src="@drawable/ic_lc_phone" app:tint="#B8895A" android:contentDescription="@null"/>
                    <EditText android:id="@+id/etPhoneNumber" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:paddingStart="42dp" android:paddingEnd="13dp"
                        android:hint="@string/digit_mobile_hint" android:textColor="#1A1A18" android:textColorHint="#A99E88"
                        android:inputType="phone" android:singleLine="true" android:textSize="15sp"/>
                </FrameLayout>

                <TextView android:id="@+id/lblShopName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:layout_marginBottom="6dp"
                    android:text="@string/shop_name_2" android:textSize="12.5sp" android:textColor="#9A968C"
                    android:fontFamily="@font/googlesans_regular"/>
                <FrameLayout
                    android:id="@+id/shopContainer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_glass_input">
                    <ImageView android:id="@+id/iconShop" android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_gravity="center_vertical|start" android:layout_marginStart="13dp"
                        android:src="@drawable/ic_lc_store" app:tint="#B8895A" android:contentDescription="@null"/>
                    <EditText android:id="@+id/ShopName" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:paddingStart="42dp" android:paddingEnd="13dp"
                        android:hint="@string/shown_on_your_bills_hint" android:textColor="#1A1A18" android:textColorHint="#A99E88"
                        android:inputType="text" android:singleLine="true" android:textSize="15sp"/>
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_login_cta_green"
                    app:backgroundTint="@null"
                    android:text="@string/create_account_3"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:fontFamily="@font/googlesans_semibold"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_cta_arrow"
                    app:iconGravity="textEnd"
                    app:iconTint="#FFFFFF"/>

                <!-- Powered-by footer: wax-seal style monogram badge. -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_powered_by_divider"/>

                <LinearLayout
                    android:id="@+id/poweredByFooter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_powered_by_seal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="19dp"
                            android:layout_gravity="center"
                            android:adjustViewBounds="true"
                            android:src="@drawable/ic_scalancer_emblem"
                            android:contentDescription="@string/powered_by_scalancer"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/powered_by_label"
                        android:textColor="#B4A98F"
                        android:textSize="7sp"
                        android:letterSpacing="0.16"
                        android:fontFamily="@font/googlesans_medium"/>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"
                        android:layout_marginTop="3dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_scalancer_wordmark"
                        android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
