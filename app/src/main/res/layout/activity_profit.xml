<?xml version="1.0" encoding="utf-8"?>

<!--
  Profit analytics — champagne redesign, matching Inventory / GST reports /
  Sales report: eyebrow + serif accent header, bg_inv_value_card hero
  (serif figure + amber/red tiles), tinted 2-up stat row, bg_inv_stat_card
  search + icon buttons, plain caps section label, bg_inv_value_card list
  frame, teal CTA. Structure (fixed header/hero/chips/search, RecyclerView
  filling the remaining space, Print pinned at the bottom) is unchanged
  from the previous layout — only colors, drawables and typography moved
  onto the shared champagne language.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3ECDD">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <!-- The whole body scrolls (header through product list) so the
         RecyclerView is never squeezed into a small leftover weight=1
         area — each product card renders at full natural height and the
         page scrolls, same pattern GST reports / Inventory use for
         content-heavy screens. Print stays pinned below, outside the
         scroll, so it's always reachable. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROFIT ANALYTICS"
            android:textColor="#B8895A"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/googlesans_semibold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Savings "
                android:textColor="#1A1A18"
                android:textSize="21sp"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/googlesans_bold"
                android:includeFontPadding="false"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="analytics"
                android:textColor="#0F6E56"
                android:textSize="21sp"
                android:textStyle="italic"
                android:fontFamily="serif"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== HERO: NET PROFIT VALUE CARD ===================== -->
    <!-- Same shape as Inventory's "Total stock value" hero: label + serif
         figure with a trend pill on the baseline, then two tinted tiles
         below (Expense amber, Loss red) reusing bg_credit_tile_amber/red. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_inv_value_card"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Net profit"
            android:textSize="11sp"
            android:textColor="#9A8F79"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="2dp"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tvNetProfit"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="30sp"
                android:textColor="#1A1A18"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:singleLine="true"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="20sp"
                app:autoSizeMaxTextSize="30sp"/>

            <LinearLayout
                android:id="@+id/layoutMarginPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_inv_a_trend_pill"
                android:backgroundTint="#DDEEEE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">
                <ImageView
                    android:id="@+id/ivMarginTrend"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/ic_si_trend_up"
                    app:tint="#085041"
                    android:contentDescription="@null"/>
                <TextView
                    android:id="@+id/tvMargin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0% margin"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#085041"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_credit_tile_amber"
                android:padding="10dp">
                <TextView
                    android:id="@+id/tvExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="16sp"
                    android:textColor="#854F0B"
                    android:singleLine="true"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="16sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Expense"
                    android:textSize="9.5sp"
                    android:textColor="#BA7517"/>
            </LinearLayout>

            <View android:layout_width="8dp" android:layout_height="1dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_credit_tile_red"
                android:padding="10dp">
                <TextView
                    android:id="@+id/tvLoss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="16sp"
                    android:textColor="#791F1F"
                    android:singleLine="true"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="16sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Loss"
                    android:textSize="9.5sp"
                    android:textColor="#A32D2D"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== REVENUE / COST — TINTED STAT ROW ===================== -->
    <!-- Same tile language as Reports' "Best day / Avg per day" row:
         gold tint for revenue, teal tint for cost. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_ov_pay_icon"
            android:backgroundTint="#EEEDFE"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Revenue"
                android:textColor="#9A8F79"
                android:textSize="9.5sp"/>

            <TextView
                android:id="@+id/tvRevenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="₹0"
                android:textSize="16sp"
                android:fontFamily="@font/googlesans_semibold"
                android:textColor="#3C3489"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ov_pay_icon"
            android:backgroundTint="#DDEEEE"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total cost"
                android:textColor="#9A8F79"
                android:textSize="9.5sp"/>

            <TextView
                android:id="@+id/tvCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="₹0"
                android:textSize="16sp"
                android:fontFamily="@font/googlesans_semibold"
                android:textColor="#085041"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Period filters — outlined pills matching ReportsActivity's date chips
         (white bg, gold stroke + text when selected, cream stroke + muted
         text otherwise). -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipDateFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:chipSpacingHorizontal="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/btnToday"
            android:text="Today"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#E4DCC8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="12dp"
            app:chipEndPadding="12dp"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:textColor="#6E6A60"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="12sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/btnWeek"
            android:text="Week"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#E4DCC8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="12dp"
            app:chipEndPadding="12dp"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:textColor="#6E6A60"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="12sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/btnMonth"
            android:text="Month"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#E4DCC8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="12dp"
            app:chipEndPadding="12dp"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:textColor="#6E6A60"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="12sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/btnAll"
            android:text="All"
            android:checked="true"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#B8895A"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="12dp"
            app:chipEndPadding="12dp"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:textColor="#8A6526"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="12sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/btnCustom"
            android:text="Custom"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#E4DCC8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="12dp"
            app:chipEndPadding="12dp"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:textColor="#6E6A60"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="12sp"/>
    </com.google.android.material.chip.ChipGroup>

    <!-- ===================== SEARCH + CHART (icon buttons, Inventory style) ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_inv_stat_card"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_si_search"
                app:tint="#B8895A"
                android:contentDescription="@null"/>
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="Search products…"
                android:textSize="12.5sp"
                android:textColor="#1A1A18"
                android:textColorHint="#9A8F79"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnChart"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_inv_stat_card"
            android:src="@drawable/ic_si_chart_columns"
            app:tint="#B8895A"
            android:scaleType="centerInside"
            android:padding="13dp"
            android:contentDescription="View chart"/>
    </LinearLayout>

    <!-- By product -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="BY PRODUCT"
        android:textSize="11sp"
        android:textColor="#9CA3AF"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_inv_value_card"
        android:clipToOutline="true"
        android:paddingBottom="4dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"/>

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Print — pinned outside the scroll, always reachable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F3ECDD"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrint"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Print report"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/googlesans_semibold"
            android:includeFontPadding="false"
            app:icon="@drawable/ic_si_printer"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_login_cta_green"
            app:cornerRadius="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:elevation="0dp"/>
    </LinearLayout>

</LinearLayout>
