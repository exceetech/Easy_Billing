<?xml version="1.0" encoding="utf-8"?>

<!--
  Top Products — champagne redesign, matching Sales / Peak hours / Charts / Overview.
  header (eyebrow+serif title + sort chip) · donut (center total) ·
  legend · product breakdown list.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0E6">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true"
        app:cardBackgroundColor="#FFFFFF">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="110dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/products_eyebrow_breakdown"
                                android:textColor="#B8895A"
                                android:textSize="10sp"
                                android:letterSpacing="0.16"
                                android:fontFamily="@font/googlesans_semibold"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="2dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/products_title_top"
                                    android:textColor="#1A1A18"
                                    android:textSize="19sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/googlesans_bold"
                                    android:includeFontPadding="false"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/dialog_add_product_chooser_title_part3"
                                    android:textColor="#0F6E56"
                                    android:textSize="19sp"
                                    android:fontFamily="serif"
                                    android:textStyle="italic"
                                    android:includeFontPadding="false"/>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSortChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/products_sort_chip_default"
                            android:textSize="11sp"
                            android:textColor="#8A6526"
                            android:fontFamily="@font/googlesans_semibold"
                            android:background="#F3ECDD"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Donut + center total -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginBottom="16dp">

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/pieChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>

                        <LinearLayout
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvCenterVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="112dp"
                                android:text="@string/dash"
                                android:textSize="20sp"
                                android:fontFamily="@font/googlesans_bold"
                                android:textStyle="bold"
                                android:textColor="#1A1A18"
                                android:singleLine="true"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="11sp"
                                app:autoSizeMaxTextSize="20sp"
                                app:autoSizeStepGranularity="1sp"/>

                            <TextView
                                android:id="@+id/tvCenterLbl"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="112dp"
                                android:text="@string/dialog_quantity_pad_total_label"
                                android:textSize="10.5sp"
                                android:textColor="#9A8F79"
                                android:gravity="center"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Legend (filled in code, 2 columns) -->
                    <LinearLayout
                        android:id="@+id/llLegend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/products_breakdown_label"
                        android:textSize="11.5sp"
                        android:textColor="#9A8F79"
                        android:layout_marginBottom="2dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvProducts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                    <TextView
                        android:id="@+id/tvEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/products_empty_state"
                        android:textSize="13sp"
                        android:textColor="#9A8F79"
                        android:gravity="center"
                        android:paddingVertical="24dp"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </FrameLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
