<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lg_page">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:title=""
        android:elevation="0dp"
        android:background="@android:color/transparent"
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Header: eyebrow + serif-accented title, matching the rest of the app.
         Width stops short of the date pill so the pill can sit inline,
         vertically centered on the title row. -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_reports_header_title"
            android:textColor="#B8895A"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/googlesans_semibold"/>

        <LinearLayout
            android:id="@+id/reportsTitleRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xml_reports_title_bold"
                android:textColor="#1A1A18"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/googlesans_bold"
                android:includeFontPadding="false"
                android:accessibilityHeading="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/xml_reports_title_accent"
                android:textColor="#0F6E56"
                android:textSize="21sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:includeFontPadding="false"/>
        </LinearLayout>
      </LinearLayout>

        <!-- Date pill, inline with the title row (bottom-aligned) -->
        <TextView
            android:id="@+id/tvReportDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="—"
            android:textColor="#16A34A"
            android:textSize="11.5sp"
            android:fontFamily="@font/googlesans_semibold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_growth_chip"/>
    </LinearLayout>


    <!-- Date-range chips — same hashed-accent-per-chip concept as the
         dashboard's category rail (white bg, colored stroke + text when
         selected, cream stroke + muted text otherwise). Colors are driven
         programmatically by ReportsActivity.applyChipStyle(); these are
         just initial states. Stretched edge-to-edge, same as the period
         filters inside Profit Analytics (activity_profit.xml), instead of
         a wrap-content scrollable row. -->
    <LinearLayout
        android:id="@+id/scrollDateFilter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/headerRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipToday"
            android:text="@string/xml_reports_filter_today"
            android:checked="true"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#B8895A"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="#8A6526"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="11sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipWeek"
            android:text="@string/xml_reports_filter_week"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#D5DDD8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="#5B6660"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="11sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMonth"
            android:text="@string/xml_reports_filter_month"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#D5DDD8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="#5B6660"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="11sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipYear"
            android:text="@string/xml_reports_filter_year"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#D5DDD8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="#5B6660"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="11sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCustom"
            android:text="@string/xml_reports_filter_custom"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="30dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#D5DDD8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="#5B6660"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="11sp"/>

    </LinearLayout>

    <!-- Fragment selector — exact same plain underline-tab language as the
         Overview / Trend switch inside Profit Analytics (activity_profit.xml):
         just the word + a thin 3dp bar beneath the active one, no filled
         pill, nothing heavy. -->
    <LinearLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/scrollDateFilter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/tabOverview"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabOverview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xml_reports_overview_label"
                android:textColor="#1A1A18"
                android:textSize="12.5sp"
                android:fontFamily="@font/googlesans_semibold"/>

            <View
                android:id="@+id/indicatorOverview"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="#0F6E56"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabTrends"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabTrends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xml_reports_tab_trends"
                android:textColor="#7C8782"
                android:textSize="12.5sp"
                android:fontFamily="@font/googlesans_medium"/>

            <View
                android:id="@+id/indicatorTrends"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabBusyTimes"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabBusyTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xml_reports_tab_busy_times"
                android:textColor="#7C8782"
                android:textSize="12.5sp"
                android:fontFamily="@font/googlesans_medium"/>

            <View
                android:id="@+id/indicatorBusyTimes"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabBestSellers"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabBestSellers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xml_reports_tab_best_sellers"
                android:textColor="#7C8782"
                android:textSize="12.5sp"
                android:fontFamily="@font/googlesans_medium"/>

            <View
                android:id="@+id/indicatorBestSellers"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/tabDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Send report — solid teal CTA matching the app's other confirm
         buttons, instead of the old blue gradient. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendReport"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="@string/xml_reports_send_email_btn"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_lg_cta_green_12"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:icon="@drawable/ic_send_report"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        app:iconPadding="8dp"
        app:cornerRadius="14dp"
        app:strokeWidth="0dp"
        app:rippleColor="#33FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
