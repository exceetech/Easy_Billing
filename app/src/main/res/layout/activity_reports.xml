<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0E6">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:title=""
        android:elevation="0dp"
        android:background="@android:color/transparent"
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Header: eyebrow + serif-accented title, matching the rest of the app -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANALYTICS"
            android:textColor="#B8895A"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/googlesans_semibold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sales"
                android:textColor="#1A1A18"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/googlesans_bold"
                android:includeFontPadding="false"
                android:accessibilityHeading="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="reports"
                android:textColor="#0F6E56"
                android:textSize="21sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Date-range chips — outlined pills matching InventoryActivity's
         category chips (white bg, gold stroke + text when selected, cream
         stroke + muted text otherwise). Colors are driven programmatically
         by ReportsActivity.applyChipStyle(); these are just initial states. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipDateFilter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="4dp"
        app:singleSelection="true"
        app:chipSpacingHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipToday"
            android:text="Today"
            android:checked="true"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#B8895A"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="12dp"
            app:chipEndPadding="12dp"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:textColor="#8A6526"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="12sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipWeek"
            android:text="Week"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#E4DCC8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="12dp"
            app:chipEndPadding="12dp"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:textColor="#6E6A60"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="12sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMonth"
            android:text="Month"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#E4DCC8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="12dp"
            app:chipEndPadding="12dp"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:textColor="#6E6A60"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="12sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipYear"
            android:text="Year"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#E4DCC8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="12dp"
            app:chipEndPadding="12dp"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:textColor="#6E6A60"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="12sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCustom"
            android:text="Custom"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            app:chipBackgroundColor="@android:color/white"
            app:chipStrokeColor="#E4DCC8"
            app:chipStrokeWidth="1.5dp"
            app:chipCornerRadius="8dp"
            app:chipStartPadding="12dp"
            app:chipEndPadding="12dp"
            app:checkedIconVisible="false"
            app:chipMinTouchTargetSize="0dp"
            android:textColor="#6E6A60"
            android:fontFamily="@font/googlesans_medium"
            android:textSize="12sp"/>

    </com.google.android.material.chip.ChipGroup>

    <!-- Fragment selector — same tappable-pill pattern as the Reason
         picker in Inventory's Clear Stock dialog: muted label on the left,
         a gold pill with the current section + chevron on the right,
         opening a ThemedDropdown instead of a fixed tab row. -->
    <LinearLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_inv_value_card"
        android:paddingVertical="6dp"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        app:layout_constraintTop_toBottomOf="@id/chipDateFilter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="View"
            android:textSize="11.5sp"
            android:textColor="#9A8F79"/>

        <LinearLayout
            android:id="@+id/btnTabPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_credit_tile_teal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabChoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overview"
                android:textSize="11.5sp"
                android:fontFamily="@font/googlesans_semibold"
                android:textColor="#085041"/>

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#085041"
                android:contentDescription="@null"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/tabDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Send report — solid teal CTA matching the app's other confirm
         buttons, instead of the old blue gradient. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendReport"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Send report to email"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_login_cta_green"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:icon="@drawable/ic_send_report"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        app:iconPadding="8dp"
        app:cornerRadius="14dp"
        app:strokeWidth="0dp"
        app:rippleColor="#33FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
