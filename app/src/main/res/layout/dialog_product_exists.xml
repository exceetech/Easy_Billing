<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_dialog_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- ICON BADGE -->
    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_dialog_soft_amber_circle">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lc_package"
            app:tint="#8A6526" />
    </FrameLayout>

    <!-- EYEBROW -->
    <TextView
        android:text="@string/dialog_product_exists_duplicate_found"
        android:textSize="10sp"
        android:letterSpacing="0.16"
        android:fontFamily="@font/googlesans_semibold"
        android:textColor="#B8895A"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- TITLE -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="3dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_product_exists_product"
            android:textColor="#1A1A18"
            android:textSize="19sp"
            android:fontFamily="@font/googlesans_bold"
            android:includeFontPadding="false"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_product_exists_exists"
            android:textColor="#8A6526"
            android:textSize="19sp"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <!-- MESSAGE -->
    <TextView
        android:id="@+id/tvMessage"
        android:text="@string/dialog_product_exists_update_existing_or_replace"
        android:textSize="12.5sp"
        android:textColor="#8A8272"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- PRODUCT DETAILS -->
    <TextView
        android:id="@+id/tvDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:padding="13dp"
        android:background="@drawable/bg_inv_value_card"
        android:text="@string/dialog_product_exists_price_0nvariant_nunit_nstock"
        android:textSize="12.5sp"
        android:fontFamily="serif"
        android:textColor="#1A1A18"
        android:lineSpacingExtra="2dp"/>

    <!-- BUTTONS -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpdate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:text="@string/dialog_product_exists_restore"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textSize="13.5sp"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        app:backgroundTint="#0F6E56"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        app:cornerRadius="14dp"
        android:gravity="center"
        android:insetLeft="0dp"
        android:insetRight="0dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReplace"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:text="@string/dialog_product_exists_create_new_instead"
        android:textColor="#1A1A18"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:background="@drawable/bg_cta_champagne_outline"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        app:cornerRadius="14dp"
        android:gravity="center"
        android:insetLeft="0dp"
        android:insetRight="0dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:text="@string/dialog_product_exists_cancel"
        android:textColor="#9A2E2E"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:background="@drawable/bg_inv_action_close"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        app:cornerRadius="14dp"
        android:gravity="center"
        android:insetLeft="0dp"
        android:insetRight="0dp"/>

</LinearLayout>
