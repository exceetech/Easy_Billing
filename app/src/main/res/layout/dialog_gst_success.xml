<?xml version="1.0" encoding="utf-8"?>

<!--
  Generic success/export-complete dialog in the app's champagne dialog
  language — teal circular check badge, gold eyebrow, bold+italic-serif
  title, white info card for the file/path details, neutral secondary
  button + solid teal primary action.

  Reused across GstReportsActivity's CSV/Excel "Export Complete" prompts.
  Bound programmatically: tvEyebrow, tvTitleBold, tvTitleAccent, tvMessage,
  cardInfo (visibility toggle), tvInfoLabel, tvInfoValue, btnSecondary,
  btnPrimary.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_dialog_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_circle_soft_teal">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lc_circle_check"
            app:tint="#085041" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvEyebrow"
        android:text="EXPORT COMPLETE"
        android:textSize="10sp"
        android:letterSpacing="0.16"
        android:fontFamily="@font/googlesans_semibold"
        android:textColor="#B8895A"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">
        <TextView
            android:id="@+id/tvTitleBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export "
            android:textColor="#1A1A18"
            android:textSize="19sp"
            android:fontFamily="@font/googlesans_bold"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"/>
        <TextView
            android:id="@+id/tvTitleAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="complete"
            android:textColor="#0F6E56"
            android:textSize="19sp"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvMessage"
        android:text="Your files are ready."
        android:textSize="12.5sp"
        android:textColor="#8A8272"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/cardInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_inv_value_card"
        android:padding="13dp"
        android:layout_marginTop="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvInfoLabel"
            android:text="SAVED TO"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:textColor="#9A8F79"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_ov_pay_icon"
                android:backgroundTint="#DDEEEE">
                <ImageView
                    android:id="@+id/ivInfoIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lc_file_text"
                    app:tint="#085041" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvInfoValue"
                android:text="—"
                android:textSize="12.5sp"
                android:fontFamily="serif"
                android:textColor="#1A1A18"
                android:layout_marginStart="10dp"
                android:maxLines="3"
                android:ellipsize="middle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrimary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:text="Share all"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textSize="13.5sp"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        app:backgroundTint="#0F6E56"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        app:cornerRadius="14dp"
        android:gravity="center"
        android:insetLeft="0dp"
        android:insetRight="0dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSecondary"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:text="OK"
        android:textColor="#1A1A18"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:background="@drawable/bg_cta_champagne_outline"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        app:cornerRadius="14dp"
        android:gravity="center"
        android:insetLeft="0dp"
        android:insetRight="0dp"/>

</LinearLayout>
