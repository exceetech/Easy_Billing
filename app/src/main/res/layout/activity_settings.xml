<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0E6">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_eyebrow"
                android:textColor="#B8895A"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/googlesans_semibold"
                android:layout_marginTop="6dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_2"
                    android:textColor="#1A1A18"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:fontFamily="@font/googlesans_bold"
                    android:includeFontPadding="false"
                    android:accessibilityHeading="true"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/and_store_word"
                    android:textColor="#0F6E56"
                    android:textSize="21sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:includeFontPadding="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_inv_card_cream"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_inv_customer_header"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@drawable/bg_step_circle_ring"/>
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:layout_gravity="center" android:src="@drawable/ic_set_store"
                            app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:text="Store setup" android:textColor="#1A1A18" android:textSize="14sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Business identity &amp; regional format" android:textColor="#5C6B65"
                            android:textSize="11sp" android:layout_marginTop="1dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView android:text="2 items" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="#16A34A" android:paddingHorizontal="11dp" android:paddingVertical="5dp"
                        android:background="@drawable/bg_pill_green" android:letterSpacing="0.06"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">

                    <LinearLayout android:id="@+id/btnStoreSettings"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:paddingHorizontal="12dp" android:paddingVertical="10dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_green">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_set_store"
                                app:tint="#16A34A" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/store_information"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/name_address_contact_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnLocalization"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="12dp" android:paddingVertical="10dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_blue">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_set_languages"
                                app:tint="#2A5CA8" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/localization_settings"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/language_currency_format_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="15dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_inv_card_cream"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_inv_items_header"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@drawable/bg_step_circle_ring_champagne"/>
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:layout_gravity="center" android:src="@drawable/ic_set_receipt"
                            app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:text="Billing setup" android:textColor="#1A1A18" android:textSize="14sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Tax, payments &amp; invoice design" android:textColor="#5C6B65"
                            android:textSize="11sp" android:layout_marginTop="1dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView android:text="3 items" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="#8A6526" android:paddingHorizontal="11dp" android:paddingVertical="5dp"
                        android:background="@drawable/bg_pill_amber" android:letterSpacing="0.06"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">

                    <LinearLayout android:id="@+id/btnBillingSettings"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:paddingHorizontal="12dp" android:paddingVertical="10dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_amber">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_set_receipt"
                                app:tint="#8A6526" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/billing_settings"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/gst_tax_rates_defaults_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnPaymentSetup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="12dp" android:paddingVertical="10dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_teal">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_lucide_credit_card"
                                app:tint="#0F6E56" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/payment_setup_row_title"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/payment_setup_row_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnInvoiceDesign"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="12dp" android:paddingVertical="10dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_amber">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_set_file_text"
                                app:tint="#8A6526" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/invoice_design"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/template_branding_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="15dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_inv_card_cream"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_inv_tax_header"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@drawable/bg_step_circle_ring"/>
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:layout_gravity="center" android:src="@drawable/ic_set_shield"
                            app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:text="Data &amp; security" android:textColor="#1A1A18" android:textSize="14sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Backup, workspace &amp; reset" android:textColor="#5C6B65"
                            android:textSize="11sp" android:layout_marginTop="1dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView android:text="1 item" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="#0F6E56" android:paddingHorizontal="11dp" android:paddingVertical="5dp"
                        android:background="@drawable/bg_pill_green" android:letterSpacing="0.06"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">

                    <LinearLayout android:id="@+id/btnDataManagement"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_light_grey"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:paddingHorizontal="12dp" android:paddingVertical="10dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_rose">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_set_shield"
                                app:tint="#B91C1C" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/data_security_management"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/backup_workspace_reset_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="15dp"/>
            </LinearLayout>


            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/activity_settings_expos"
                android:textColor="#C9C3B4"
                android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
