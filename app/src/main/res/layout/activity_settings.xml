<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0E6">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANAGE"
                android:textColor="#B8895A"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/googlesans_semibold"
                android:layout_marginTop="6dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#1A1A18"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:fontFamily="@font/googlesans_bold"
                    android:includeFontPadding="false"
                    android:accessibilityHeading="true"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="&amp; store"
                    android:textColor="#0F6E56"
                    android:textSize="21sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:includeFontPadding="false"/>
            </LinearLayout>

            <!-- ===================== STORE ===================== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp">
                <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D4A574"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="9dp" android:text="STORE"
                    android:textColor="#8A6526" android:textSize="11sp" android:textStyle="bold"
                    android:letterSpacing="0.08"/>
            </LinearLayout>

            <LinearLayout style="@style/SettingsCard">

                <LinearLayout android:id="@+id/btnStoreSettings" style="@style/SettingsRow">
                    <ImageView style="@style/SettingsIcon" android:backgroundTint="#F3ECDD"
                        android:src="@drawable/ic_set_store" app:tint="#B8895A"/>
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/store_information"/>
                        <TextView style="@style/SettingsRowSub" android:text="Name, address, contact"/>
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/btnLocalization" style="@style/SettingsRow">
                    <ImageView style="@style/SettingsIcon" android:backgroundTint="#EFE5F7"
                        android:src="@drawable/ic_set_languages" app:tint="#7A4FA3"/>
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/localization_settings"/>
                        <TextView style="@style/SettingsRowSub" android:text="Language, currency, format"/>
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== BILLING ===================== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp">
                <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D4A574"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="9dp" android:text="BILLING"
                    android:textColor="#8A6526" android:textSize="11sp" android:textStyle="bold"
                    android:letterSpacing="0.08"/>
            </LinearLayout>

            <LinearLayout style="@style/SettingsCard">

                <LinearLayout android:id="@+id/btnBillingSettings" style="@style/SettingsRow">
                    <ImageView style="@style/SettingsIcon" android:backgroundTint="#DDEEEE"
                        android:src="@drawable/ic_set_receipt" app:tint="#0F6E56"/>
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/billing_settings"/>
                        <TextView style="@style/SettingsRowSub" android:text="GST, tax rates, defaults"/>
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/btnInvoiceDesign" style="@style/SettingsRow">
                    <ImageView style="@style/SettingsIcon" android:backgroundTint="#FAEEDA"
                        android:src="@drawable/ic_set_file_text" app:tint="#8A6526"/>
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/invoice_design"/>
                        <TextView style="@style/SettingsRowSub" android:text="Template &amp; branding"/>
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== DATA ===================== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp">
                <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D4A574"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="9dp" android:text="DATA"
                    android:textColor="#8A6526" android:textSize="11sp" android:textStyle="bold"
                    android:letterSpacing="0.08"/>
            </LinearLayout>

            <LinearLayout style="@style/SettingsCard">

                <LinearLayout android:id="@+id/btnDataManagement" style="@style/SettingsRow">
                    <ImageView style="@style/SettingsIcon" android:backgroundTint="#FBEDED"
                        android:src="@drawable/ic_set_shield" app:tint="#791F1F"/>
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/data_security_management"/>
                        <TextView style="@style/SettingsRowSub" android:text="Backup, workspace, reset"/>
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="ExPOS"
                android:textColor="#C9C3B4"
                android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
