<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3ECDD">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_eyebrow"
                android:textColor="#B8895A"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/googlesans_semibold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:accessibilityHeading="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title1"
                    android:textColor="#1A1A18"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:fontFamily="@font/googlesans_bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/settings_title2"
                    android:textColor="#0F6E56"
                    android:textSize="21sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_inv_card_cream">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_inv_customer_header"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_step_circle_ring"/>
                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_set_store"
                            app:tint="#FFFFFF"
                            android:contentDescription="@null"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:text="@string/settings_card_title"
                            android:textColor="#1A1A18"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:text="@string/settings_card_sub"
                            android:textColor="#5C6B65"
                            android:textSize="11sp"
                            android:layout_marginTop="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="14dp">

                    <LinearLayout android:id="@+id/btnStoreSettings"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_contrast"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:paddingHorizontal="12dp" android:paddingVertical="12dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_green">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_set_store"
                                app:tint="#16A34A" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_row_shop"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/settings_row_shop_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/btnPaymentSetup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_contrast"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="12dp" android:paddingVertical="12dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_teal">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_lucide_credit_card"
                                app:tint="#0F6E56" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_row_payments"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/settings_row_payments_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/btnInvoiceDesign"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_contrast"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="12dp" android:paddingVertical="12dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_amber">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_set_file_text"
                                app:tint="#8A6526" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_row_print"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/settings_row_print_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/btnDataManagement"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_contrast"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="12dp" android:paddingVertical="12dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_rose">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_set_shield"
                                app:tint="#B91C1C" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_row_security"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/settings_row_security_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/btnLocalization"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_contrast"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="12dp" android:paddingVertical="12dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_blue">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_set_languages"
                                app:tint="#2A5CA8" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_row_language"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/settings_row_language_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/btnAdminTools"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_field_contrast"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:paddingHorizontal="12dp" android:paddingVertical="12dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_rose">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_set_wrench"
                                app:tint="#B91C1C" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout style="@style/SettingsRowText" android:layout_marginStart="12dp">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_row_admin"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/settings_row_admin_sub"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersion"
                android:padding="12dp"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/activity_settings_expos"
                android:textColor="#C9C3B4"
                android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
