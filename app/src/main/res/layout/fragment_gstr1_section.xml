<?xml version="1.0" encoding="utf-8"?>
<!-- Section page — champagne. Sits inside the white section card in
     activity_gst_reports (cardSection), so the background stays transparent. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <!-- Row count -->
    <TextView
        android:id="@+id/tvRowCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        android:textSize="10.5sp"
        android:textColor="#B8895A"
        android:letterSpacing="0.06"
        android:fontFamily="@font/googlesans_semibold"
        tools:text="42 ROWS" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="28dp"
        android:text="@string/xml_gstr1_section_empty"
        android:textColor="#9A8F79"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Data rows -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:nestedScrollingEnabled="true"
        android:scrollbars="none" />

</LinearLayout>
