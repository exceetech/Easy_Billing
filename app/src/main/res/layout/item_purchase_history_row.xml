<?xml version="1.0" encoding="utf-8"?>
<!--
    Purchase-history row. Champagne theme, same language as item_credit:
    a left stripe carrying status (red = on credit, neutral = cash, grey =
    cancelled), a monogram tile from the supplier name, name + invoice/date,
    and the amount right-aligned with a small status caption.

    Bound by PurchaseHistoryAdapter: viewStatusStripe, tvAvatar, tvSupplier,
    tvSub, tvAmount, tvStatus, viewRowDivider.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewStatusStripe"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#1D6E6E" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="13dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="S"
                android:textSize="16sp"
                android:textColor="#1D6E6E"
                android:fontFamily="@font/googlesans_semibold"
                android:background="@drawable/bg_credit_avatar"
                android:backgroundTint="#DDEEEE"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvSupplier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xml_purchase_history_row_supplier_placeholder"
                    android:textSize="13.5sp"
                    android:textColor="#1A1A18"
                    android:fontFamily="@font/googlesans_medium"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="INV-0000 · 01 Jan"
                    android:textSize="11sp"
                    android:textColor="#9A8F79"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="18sp"
                    android:textColor="#1A1A18"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="cash"
                    android:textSize="9.5sp"
                    android:textColor="#A99E88" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/viewRowDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="14dp"
        android:background="#F1EBDD" />

</LinearLayout>
