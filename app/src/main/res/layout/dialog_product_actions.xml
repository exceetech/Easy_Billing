<?xml version="1.0" encoding="utf-8"?>
<!--
    Long-press action dialog for a product tile on the dashboard grid.
    Modeled on dialog_add_product_chooser.xml (rounded card, icon-tile
    rows, chevron, top-right close) with the product-name chip pattern
    from dialog_confirm_delete.xml so it's never ambiguous which item
    the dialog is talking about.

    Wired in DashboardActivity.showProductActionsDialog():
      • Edit   → EditProductActivity (for this product)
      • Delete → dismisses this dialog, then calls the EXISTING
                 showDeleteDialog(product) — not duplicated here.
      • Close  → dismiss only.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="20dp"
    android:background="@drawable/bg_dialog_card"
    android:paddingHorizontal="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Product name chip, same pattern as dialog_confirm_delete's productChip -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_soft_card_row"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_stock_dot"
                android:backgroundTint="#0F6E56"/>

            <TextView
                android:id="@+id/tvActionsProductName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="13.5sp"
                android:textColor="#1A1A18"
                android:fontFamily="@font/googlesans_medium"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnProductActionsClose"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_confirm_close_button"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_x"
                app:tint="#1A1A18"
                android:contentDescription="Close"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Option 1: Edit -->
    <LinearLayout
        android:id="@+id/btnProductActionEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chooser_row"
        android:foreground="?attr/selectableItemBackground"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tile_violet">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/ic_lucide_pencil" app:tint="#6C4EA0" android:contentDescription="@null"/>
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/dialog_product_actions_edit_title" android:textColor="#1A1A18" android:textSize="14.5sp"
                android:fontFamily="@font/googlesans_semibold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@string/dialog_product_actions_edit_body"
                android:textColor="#8A8272" android:textSize="11.5sp"/>
        </LinearLayout>
        <ImageView android:layout_width="19dp" android:layout_height="19dp"
            android:src="@drawable/ic_lc_chevron_right" app:tint="#C7A15A" android:contentDescription="@null"/>
    </LinearLayout>

    <!-- Option 2: Delete -->
    <LinearLayout
        android:id="@+id/btnProductActionDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chooser_row"
        android:foreground="?attr/selectableItemBackground"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tile_red">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/ic_lc_trash" app:tint="#B23A3A" android:contentDescription="@null"/>
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/dialog_product_actions_delete_title" android:textColor="#1A1A18" android:textSize="14.5sp"
                android:fontFamily="@font/googlesans_semibold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@string/dialog_product_actions_delete_body"
                android:textColor="#8A8272" android:textSize="11.5sp"/>
        </LinearLayout>
        <ImageView android:layout_width="19dp" android:layout_height="19dp"
            android:src="@drawable/ic_lc_chevron_right" app:tint="#C7A15A" android:contentDescription="@null"/>
    </LinearLayout>

</LinearLayout>
