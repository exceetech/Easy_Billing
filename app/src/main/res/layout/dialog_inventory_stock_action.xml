<?xml version="1.0" encoding="utf-8"?>
<!--
    Add / Reduce / Clear stock picker — "Option 14" select-then-confirm
    dialog. Header (avatar/name/stock caption) unchanged; below it three
    radio-style rows (tap to select, doesn't act immediately), and a
    single solid "Continue" button that fires whichever action is
    currently selected. Add stock is selected by default since it's the
    most common action.

    Ids bound by InventoryAdapter.showStockActionDialog: tvActionAvatar,
    tvActionProductName, tvActionStockCaption, rowAddStock, rowReduceStock,
    rowClearStock, radioAddStock, radioReduceStock, radioClearStock,
    btnContinueAction.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvActionAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="PB"
            android:textSize="12sp"
            android:fontFamily="@font/googlesans_bold"
            android:textColor="#633806"
            android:background="@drawable/bg_credit_avatar"
            android:backgroundTint="#FAEEDA"
            android:includeFontPadding="false"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tvActionProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xml_inventory_stock_action_product_placeholder"
                android:textSize="13.5sp"
                android:fontFamily="@font/googlesans_medium"
                android:textColor="#1A1A18"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvActionStockCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0 units"
                android:textSize="10.5sp"
                android:fontFamily="@font/googlesans_medium"
                android:textColor="#854F0B"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#E4DCC8" />

    <LinearLayout
        android:id="@+id/rowAddStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_inv_action_row_selected"
        android:paddingHorizontal="13dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/radioAddStock"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_radio_selected"/>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_lucide_plus"
            app:tint="#27500A"
            android:contentDescription="@null"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="@string/xml_inventory_stock_action_add_stock"
            android:textSize="13sp"
            android:textColor="#1A1A18"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowReduceStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_inv_action_row"
        android:paddingHorizontal="13dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/radioReduceStock"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_radio_unselected"/>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_lucide_minus"
            app:tint="#854F0B"
            android:contentDescription="@null"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="@string/xml_inventory_stock_action_reduce_stock"
            android:textSize="13sp"
            android:textColor="#1A1A18"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowClearStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_inv_action_row"
        android:paddingHorizontal="13dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/radioClearStock"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_radio_unselected"/>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_lucide_trash"
            app:tint="#791F1F"
            android:contentDescription="@null"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="@string/xml_inventory_stock_action_clear_stock"
            android:textSize="13sp"
            android:textColor="#1A1A18"/>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_login_cta_green"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/xml_inventory_stock_action_continue_button"
        android:textAllCaps="false"
        android:textSize="13.5sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:stateListAnimator="@null"
        app:cornerRadius="14dp"
        app:rippleColor="#33FFFFFF" />

</LinearLayout>
