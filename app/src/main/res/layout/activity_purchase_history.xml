<?xml version="1.0" encoding="utf-8"?>
<!--
    Purchase history — champagne theme, same language as the credit accounts
    (khata) screen: eyebrow + serif accent header, one summary card with a
    serif lead number and two tinted tiles, a search field, icon-only
    Filter/Sort buttons (same pattern as activity_bill_history.xml), and one
    white card holding hairline-separated rows.

    Ids bound by PurchaseHistoryActivity: toolbar, tvBought, tvBoughtCount,
    tvOnCredit, tvCash, etSearch, btnFilter, btnSort, tvFilterBadge,
    tvResultSummary, btnResetFilters, cardPurchases, rvPurchases,
    layoutPurchasesEmpty, tvPurchasesEmptyTitle, tvPurchasesEmptyTitleAccent,
    tvPurchasesEmptyBody, progressBar.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3ECDD">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purchase_history_eyebrow"
            android:textColor="#B8895A"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/googlesans_semibold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/purchase_history_title_lead"
                android:textColor="#1A1A18"
                android:textSize="21sp"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/googlesans_bold"
                android:includeFontPadding="false"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/bill_history_title_accent"
                android:textColor="#0F6E56"
                android:textSize="21sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== SUMMARY ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_inv_value_card"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purchase_history_bought_this_month"
            android:textSize="11sp"
            android:textColor="#9A8F79" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="2dp"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tvBought"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="30sp"
                android:textColor="#1A1A18"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:singleLine="true"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="20sp"
                app:autoSizeMaxTextSize="30sp" />

            <TextView
                android:id="@+id/tvBoughtCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/xml_purchase_history_invoices_count_placeholder"
                android:textSize="11sp"
                android:textColor="#9A8F79" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_credit_tile_red"
                android:padding="10dp">
                <TextView
                    android:id="@+id/tvOnCredit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="16sp"
                    android:textColor="#791F1F"
                    android:singleLine="true"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/purchase_history_tile_on_credit"
                    android:textSize="9.5sp"
                    android:textColor="#A32D2D" />
            </LinearLayout>

            <View android:layout_width="8dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_credit_tile_teal"
                android:padding="10dp">
                <TextView
                    android:id="@+id/tvCash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="16sp"
                    android:textColor="#085041"
                    android:singleLine="true"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/cash"
                    android:textSize="9.5sp"
                    android:textColor="#0F6E56" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== SEARCH ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_imp_filter"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_search"
            app:tint="#B8895A"
            android:contentDescription="@null" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="@string/purchase_history_search_hint"
            android:textColorHint="#A99E88"
            android:textColor="#1A1A18"
            android:textSize="12.5sp"
            android:singleLine="true"
            android:paddingStart="8dp"
            android:importantForAutofill="no"
            android:inputType="text" />
    </LinearLayout>

    <!-- ===================== FILTER + SORT ===================== -->
    <!-- Icon-only square buttons (same pattern as activity_bill_history.xml)
         instead of a chip row — Filter carries a red count badge when a
         non-"All" filter is active, and a result pill shows "N purchases ·
         sort label" plus a one-tap Reset once anything's non-default. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/btnFilter"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_credit_phone_chip"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_filter"
                app:tint="#B8895A"
                android:contentDescription="Filter" />

            <TextView
                android:id="@+id/tvFilterBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="1dp"
                android:minWidth="14dp"
                android:minHeight="14dp"
                android:gravity="center"
                android:paddingHorizontal="3dp"
                android:background="@drawable/bg_hdr_badge_red"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="8.5sp"
                android:fontFamily="@font/googlesans_semibold"
                android:includeFontPadding="false"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnSort"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_credit_phone_chip"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lc_sliders"
                app:tint="#B8895A"
                android:contentDescription="Sort" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_credit_phone_chip"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvResultSummary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/xml_purchase_history_sort_newest_first"
                android:textColor="#9A8F79"
                android:fontFamily="@font/googlesans_medium"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:id="@+id/btnResetFilters"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_close"
                    app:tint="#B23A3A"
                    android:contentDescription="Reset filters" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/dialog_product_filter_reset"
                    android:textColor="#B23A3A"
                    android:fontFamily="@font/googlesans_medium"
                    android:textSize="11.5sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- One card, one background — the list and the empty state are both
         inside it as alternate contents (same structure as bill history and
         the GSTR-2 import-services records card). -->
    <FrameLayout
        android:id="@+id/cardPurchases"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_inv_value_card">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPurchases"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="4dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- ===================== EMPTY STATE =====================
             Same design as bill history / import services: 72dp icon
             circle, centred title with the italic serif accent word, centred
             body copy, hairline, then two tip rows. Title/accent/body are
             updated from Kotlin to switch between "nothing recorded at all"
             and "search/filter found nothing". -->
        <ScrollView
            android:id="@+id/layoutPurchasesEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="26dp"
                android:paddingTop="30dp"
                android:paddingBottom="26dp">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_imp_empty_circle">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_receipt"
                        app:tint="#B8895A"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:id="@+id/tvPurchasesEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_history_no_purchases_title"
                        android:textSize="19sp"
                        android:textColor="#1A1A18"
                        android:fontFamily="@font/googlesans_bold"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/tvPurchasesEmptyTitleAccent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/credit_no_customers_accent"
                        android:textSize="19sp"
                        android:textColor="#0F6E56"
                        android:fontFamily="serif"
                        android:textStyle="italic"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPurchasesEmptyBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="@string/purchase_history_no_purchases_body"
                    android:textSize="12.5sp"
                    android:textColor="#8A8272"
                    android:lineSpacingExtra="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="#F1EBDD" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="11dp">
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_receipt"
                        app:tint="#B8895A"
                        android:contentDescription="@null" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/purchase_history_tip_record_title"
                            android:textSize="12sp"
                            android:textColor="#1A1A18" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/purchase_history_tip_record_body"
                            android:textSize="11sp"
                            android:textColor="#9A8F79" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_search"
                        app:tint="#B8895A"
                        android:contentDescription="@null" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/purchase_history_tip_search_title"
                            android:textSize="12sp"
                            android:textColor="#1A1A18" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/purchase_history_tip_search_body"
                            android:textSize="11sp"
                            android:textColor="#9A8F79" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
