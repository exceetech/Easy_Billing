<?xml version="1.0" encoding="utf-8"?>
<!--
    Credit note (sales return) — champagne theme, same language and structure
    as activity_debit_note.xml: eyebrow + serif-italic accent header, invoice
    pill, one card of hairline-separated item rows, cardless footer total.
    Recoloured teal (vs. debit note's gold) to match the "Credit Note" tint
    used elsewhere in Bill Details.

    Ids bound by SalesReturnActivity: tvInvoiceNumber, tvInvoiceDate,
    rvReturnItems, tvTotalReturnValue, tvGstReversal, btnConfirmReturn,
    btnCancelReturn.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3ECDD">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_sales_return_sales_return"
                android:textColor="#B8895A"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/googlesans_semibold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_sales_return_credit"
                    android:textColor="#1A1A18"
                    android:textSize="21sp"
                    android:letterSpacing="-0.02"
                    android:fontFamily="@font/googlesans_bold"
                    android:includeFontPadding="false"
                    android:accessibilityHeading="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/activity_sales_return_note"
                    android:textColor="#1D6E6E"
                    android:textSize="21sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Invoice pill — same pattern as activity_debit_note.xml, just
                 recoloured teal to match the Credit Note tint. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_credit_phone_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginTop="5dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_lc_file_text"
                    app:tint="#1D6E6E"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvInvoiceNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/activity_sales_return_invoice"
                    android:textColor="#0F6E56"
                    android:fontFamily="@font/googlesans_medium"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Date — top-right aligned with the header. -->
        <TextView
            android:id="@+id/tvInvoiceDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="—"
            android:textColor="#8A8272"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Section label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="6dp"
        android:text="@string/activity_sales_return_select_items_and_quantity"
        android:textSize="11sp"
        android:textColor="#9A8F79"
        android:letterSpacing="0.08"
        android:fontFamily="@font/googlesans_semibold" />

    <!-- Items list — each row draws its own card (see item_sales_return_row.xml)
         with a left accent stripe, rather than one shared list card. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReturnItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="4dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"/>

    <!-- ===================== BOTTOM SUMMARY + CONFIRM ===================== -->
    <!-- No card here on purpose — cardless running footer, matching
         activity_debit_note.xml. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/activity_sales_return_total_return_value"
                android:textSize="11.5sp"
                android:textColor="#9A8F79" />

            <TextView
                android:id="@+id/tvTotalReturnValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textColor="#1A1A18"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:singleLine="true"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="18sp"
                app:autoSizeMaxTextSize="26sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_sales_return_taxable"
                android:textSize="10.5sp"
                android:textColor="#8A6526" />

            <TextView
                android:id="@+id/tvTaxableTile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textSize="10.5sp"
                android:textColor="#8A6526"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/activity_sales_return_gst_reversal"
                android:textSize="10.5sp"
                android:textColor="#0F6E56" />

            <TextView
                android:id="@+id/tvGstReversal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textSize="10.5sp"
                android:textColor="#0F6E56"
                android:fontFamily="serif" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:background="#DDD3BB" />

        <!-- Confirm button — same solid-fill structure as btnConfirmDebit in
             activity_debit_note.xml (white text/icon on a solid fill), just
             using the teal #0F6E56 already used for the Credit Note tint
             instead of debit note's green. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmReturn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/activity_sales_return_confirm_and_issue_credit"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="13.5sp"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            app:backgroundTint="@null"
            android:background="@drawable/bg_login_cta_green"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_lc_check"
            app:iconTint="#FFFFFF"
            app:iconSize="17dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="14dp"/>

        <!-- Cancel button — same rose "ghost destructive" treatment as
             btnCancelDebit in activity_debit_note.xml. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReturn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/activity_sales_return_cancel"
            android:textColor="#9A2E2E"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:background="@drawable/bg_inv_action_close"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_close"
            app:iconTint="#B91C1C"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconPadding="7dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@null"
            app:rippleColor="#F6D8D4"/>

    </LinearLayout>

</LinearLayout>
