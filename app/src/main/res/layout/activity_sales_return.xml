<?xml version="1.0" encoding="utf-8"?>
<!--
    Credit note (sales return) — redesigned to match the step-card language
    used by activity_purchase_return.xml (the debit/credit note screen
    opened from Purchase Details): same eyebrow + serif-italic accent
    header, items wrapped in a teal step-1 card with a running-total accent
    sub-card, cardless footer with the same confirm/cancel button styling.
    No GSTR-2/ITC fields here — those are purchase-side only; a sales
    credit note only needs the item list and the refund total.

    Ids bound by SalesReturnActivity: tvInvoiceNumber, tvInvoiceDate,
    rvReturnItems, tvTotalReturnValue, tvTaxableTile, tvGstReversal,
    rowCessReversal, tvCessReversal, btnConfirmReturn, btnCancelReturn.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3ECDD">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_sales_return_sales_return"
                android:textColor="#B8895A"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/googlesans_semibold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="1dp"
                android:accessibilityHeading="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_sales_return_credit"
                    android:textColor="#1A1A18"
                    android:textSize="21sp"
                    android:letterSpacing="-0.02"
                    android:fontFamily="@font/googlesans_bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/activity_sales_return_note"
                    android:textColor="#0F6E56"
                    android:textSize="21sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Invoice chip — same pattern as activity_purchase_return.xml. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_credit_phone_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_lc_file_text"
                    app:tint="#1D6E6E"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvInvoiceNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/activity_sales_return_invoice"
                    android:textColor="#0F6E56"
                    android:fontFamily="@font/googlesans_medium"
                    android:textSize="11sp"
                    android:maxWidth="180dp"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Date — top-right aligned with the header. -->
        <TextView
            android:id="@+id/tvInvoiceDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="—"
            android:textColor="#8A8272"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Main Content Area (Scrollable) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CARD 1 — teal, step 1: items to return -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_addp_card"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_inv_customer_header"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp">

                        <View
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_step_circle_ring"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/googlesans_bold"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sales_return_step1_title"
                            android:textColor="#123B31"
                            android:textSize="15sp"
                            android:fontFamily="@font/googlesans_semibold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sales_return_step1_hint"
                            android:textColor="#3E6F62"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Items list — each row draws its own card (see
                         item_sales_return_row.xml) with a left accent
                         stripe, rather than one shared list card. -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvReturnItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="2dp"/>

                    <!-- Running refund total — same accent sub-card design
                         as activity_purchase_return.xml's debit total, teal
                         to match this screen's Credit Note tint. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="11dp"
                        android:background="@drawable/bg_inv_subcard_accent">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_circle_soft_teal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lc_indian_rupee"
                                app:tint="#0F6E56"
                                android:contentDescription="@null"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="11dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/activity_sales_return_total_return_value"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A18"/>

                            <LinearLayout
                                android:id="@+id/rowReturnBreakdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                android:layout_marginTop="1dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/activity_sales_return_taxable"
                                    android:textSize="10.5sp"
                                    android:textColor="#8A8578" />

                                <TextView
                                    android:id="@+id/tvTaxableTile"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="0"
                                    android:textSize="10.5sp"
                                    android:textColor="#8A8578"
                                    android:fontFamily="serif" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text="@string/activity_sales_return_gst_reversal"
                                    android:textSize="10.5sp"
                                    android:textColor="#8A8578" />

                                <TextView
                                    android:id="@+id/tvGstReversal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="0"
                                    android:textSize="10.5sp"
                                    android:textColor="#8A8578"
                                    android:fontFamily="serif" />

                                <LinearLayout
                                    android:id="@+id/rowCessReversal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:visibility="gone"
                                    android:layout_marginStart="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/activity_sales_return_cess_reversal"
                                        android:textSize="10.5sp"
                                        android:textColor="#8A8578" />

                                    <TextView
                                        android:id="@+id/tvCessReversal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="0"
                                        android:textSize="10.5sp"
                                        android:textColor="#8A8578"
                                        android:fontFamily="serif" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTotalReturnValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="0"
                            android:textSize="22sp"
                            android:textColor="#0F6E56"
                            android:fontFamily="serif"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="16sp"
                            app:autoSizeMaxTextSize="22sp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ===================== CONFIRM / CANCEL ===================== -->
    <!-- Running total now lives inside Card 1; footer is just the actions,
         same styling as activity_purchase_return.xml's buttons. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmReturn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/activity_sales_return_confirm_and_issue_credit"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="13.5sp"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            app:backgroundTint="@null"
            android:background="@drawable/bg_login_cta_green"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_lc_check"
            app:iconTint="#FFFFFF"
            app:iconSize="17dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="14dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReturn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/activity_sales_return_cancel"
            android:textColor="#9A2E2E"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            app:backgroundTint="@null"
            android:background="@drawable/bg_inv_action_close"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_close"
            app:iconTint="#B91C1C"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconPadding="7dp"
            app:rippleColor="#F6D8D4"
            app:cornerRadius="14dp"/>

    </LinearLayout>

</LinearLayout>
