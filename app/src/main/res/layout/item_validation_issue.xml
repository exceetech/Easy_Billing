<?xml version="1.0" encoding="utf-8"?>

<!--
  One row inside the validation-results dialog's issue list — a small
  tinted icon tile (red X for errors, amber triangle for warnings),
  section label, and message. Bound by GstReportsActivity.showValidationDialog().
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:id="@+id/ivTileBg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/bg_ov_pay_icon">
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="center"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/tvSection"
            android:text="B2B"
            android:textSize="10sp"
            android:letterSpacing="0.04"
            android:textColor="#9A8F79"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvMessage"
            android:text="Issue description"
            android:textSize="12.5sp"
            android:textColor="#1A1A18"
            android:layout_marginTop="1dp"
            android:lineSpacingExtra="1dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</LinearLayout>
