<?xml version="1.0" encoding="utf-8"?>
<!--
    "Corrected invoice" popup — champagne dialog shell shared with
    dialog_cancel_purchase_confirm.xml. Header and Done button stay fixed; the
    hero total and the tap-to-open item rows (added in code) scroll.
    Ids bound by PurchaseDetailsActivity: tvCorrEyebrow, svCorr, llCorrList,
    tvCorrWas, tvCorrNow, tvCorrChg, btnCorrDone.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="20dp" android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:paddingHorizontal="22dp" android:paddingTop="24dp" android:paddingBottom="20dp">

    <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_circle_soft_teal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
            android:src="@drawable/ic_lc_check" app:tint="#0F6E56" android:contentDescription="@null"/>
    </FrameLayout>

    <TextView android:id="@+id/tvCorrEyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:gravity="center" android:textColor="#B8895A" android:textSize="10sp"
        android:letterSpacing="0.14" android:fontFamily="@font/googlesans_semibold" android:singleLine="true" android:ellipsize="end"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:orientation="horizontal" android:layout_marginTop="2dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/corr_inv_title1" android:textColor="#1A1A18" android:textSize="20sp"
            android:fontFamily="@font/googlesans_bold" android:includeFontPadding="false"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="@string/corr_inv_title2" android:textColor="#0F6E56" android:textSize="20sp"
            android:fontFamily="serif" android:textStyle="italic" android:includeFontPadding="false"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:gravity="center" android:text="@string/corr_inv_body" android:textColor="#8A8272"
        android:textSize="12.5sp" android:lineSpacingExtra="3dp"/>

    <ScrollView android:id="@+id/svCorr" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:background="@drawable/bg_corr_hero" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/corr_inv_total_now" android:textSize="11sp"
                    android:fontFamily="@font/googlesans_bold" android:textColor="#5C4A22"/>
                <TextView android:id="@+id/tvCorrWas" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="#8A8272"/>
                <TextView android:id="@+id/tvCorrNow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:fontFamily="serif" android:textStyle="bold"
                    android:textSize="32sp" android:textColor="#0F6E56"/>
                <TextView android:id="@+id/tvCorrChg" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:paddingHorizontal="10dp" android:paddingVertical="3dp"
                    android:textSize="11.5sp" android:fontFamily="@font/googlesans_bold" android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/llCorrList" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView android:id="@+id/tvCorrSay" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_amber_note" android:padding="12dp"
                android:textSize="12.5sp" android:textColor="#5C4A22" android:lineSpacingExtra="2dp" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCorrDone" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp"
        android:background="@drawable/bg_cta_save_green" app:backgroundTint="@null"
        android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"
        android:text="@string/corr_inv_done" android:textAllCaps="false" android:textSize="13.5sp"
        android:textColor="@android:color/white" android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false" android:gravity="center" android:stateListAnimator="@null"
        app:icon="@drawable/ic_lc_check" app:iconTint="@android:color/white" app:iconSize="17dp"
        app:iconGravity="textStart" app:iconPadding="8dp" app:cornerRadius="14dp" app:rippleColor="#33FFFFFF"/>
</LinearLayout>
