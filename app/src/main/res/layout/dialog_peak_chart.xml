<!-- dialog_peak_chart.xml — champagne redesign: eyebrow+serif header, 2x2 stat cards, cream-inset bubble chart -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_peak_chart_header_title"
            android:textColor="#B8895A"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/googlesans_semibold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xml_peak_chart_title_bold"
                android:textColor="#1A1A18"
                android:textSize="24sp"
                android:fontFamily="@font/googlesans_bold"
                android:textStyle="bold"
                android:includeFontPadding="false"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/xml_peak_chart_title_accent"
                android:textColor="#0F6E56"
                android:textSize="24sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <!-- ═══ KPI stat cards (2 × 2) ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Peak revenue -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_ov_pay_icon"
                android:backgroundTint="#F3ECDD"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xml_peak_chart_peak_revenue_label"
                    android:textColor="#9A8F79"
                    android:textSize="11sp"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:id="@+id/tvDlgPeakRevenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#8A6526"
                    android:textSize="20sp"
                    android:fontFamily="@font/googlesans_semibold"/>
            </LinearLayout>

            <!-- Peak hour -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ov_pay_icon"
                android:backgroundTint="#DDEEEE"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xml_peak_chart_peak_hour_label"
                    android:textColor="#9A8F79"
                    android:textSize="11sp"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:id="@+id/tvDlgPeakHour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#085041"
                    android:textSize="20sp"
                    android:fontFamily="@font/googlesans_semibold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <!-- Total bills -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_ov_pay_icon"
                android:backgroundTint="#DDEEEE"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xml_peak_chart_total_bills_label"
                    android:textColor="#9A8F79"
                    android:textSize="11sp"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:id="@+id/tvDlgTotalBills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#085041"
                    android:textSize="20sp"
                    android:fontFamily="@font/googlesans_semibold"/>
            </LinearLayout>

            <!-- Avg bills / hr -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ov_pay_icon"
                android:backgroundTint="#F3ECDD"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xml_peak_chart_avg_bills_label"
                    android:textColor="#9A8F79"
                    android:textSize="11sp"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:id="@+id/tvDlgAvgBills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#8A6526"
                    android:textSize="20sp"
                    android:fontFamily="@font/googlesans_semibold"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_peak_chart_hint_bubble_size"
            android:textColor="#9A8F79"
            android:textSize="11.5sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

        <!-- Cream inset panel wrapping the bubble chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_ov_payment_list"
            android:padding="10dp">

            <com.github.mikephil.charting.charts.BubbleChart
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_peak_chart_hint_tap_bubble"
            android:textColor="#9A8F79"
            android:textSize="11.5sp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_ov_pay_icon"
        android:backgroundTint="#F3ECDD">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </FrameLayout>
</FrameLayout>
