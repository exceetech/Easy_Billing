<?xml version="1.0" encoding="utf-8"?>

<!--
  Sales — champagne redesign, matching Peak hours / Charts / Overview.
  header (eyebrow+serif title + period chip) · Daily/Monthly toggle
    · total + growth delta · legend · cream-inset bar chart · 2 stat cards
    · breakdown list.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0E6">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true"
        app:cardBackgroundColor="#FFFFFF">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="110dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_dashboard_col_revenue"
                        android:textColor="#B8895A"
                        android:textSize="10sp"
                        android:letterSpacing="0.16"
                        android:fontFamily="@font/googlesans_semibold"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reports_title_sales"
                            android:textColor="#1A1A18"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/googlesans_bold"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/reports_title_report_suffix"
                            android:textColor="#0F6E56"
                            android:textSize="19sp"
                            android:fontFamily="serif"
                            android:textStyle="italic"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPeriodChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xml_reports_period_chip_default"
                    android:textSize="11sp"
                    android:textColor="#8A6526"
                    android:fontFamily="@font/googlesans_semibold"
                    android:background="#F3ECDD"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Daily / Monthly toggle -->
            <LinearLayout
                android:id="@+id/segContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="3dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/segDaily"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reports_toggle_daily"
                    android:gravity="center"
                    android:paddingVertical="7dp"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/googlesans_semibold"/>

                <TextView
                    android:id="@+id/segMonthly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reports_toggle_monthly"
                    android:gravity="center"
                    android:paddingVertical="7dp"
                    android:textSize="12.5sp"/>
            </LinearLayout>

            <!-- Total revenue + growth delta -->
            <TextView
                android:id="@+id/tvTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reports_total_revenue_label"
                android:textSize="11.5sp"
                android:textColor="#9A8F79"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvTotalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dash"
                    android:textSize="28sp"
                    android:fontFamily="@font/googlesans_bold"
                    android:textColor="#1A1A18"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tvDelta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dash"
                    android:textSize="11sp"
                    android:fontFamily="@font/googlesans_semibold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#B8895A"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:id="@+id/tvLegendMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reports_legend_daily_revenue"
                    android:textSize="11sp"
                    android:textColor="#9A8F79"
                    android:layout_marginEnd="14dp"/>

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#0F6E56"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reports_legend_best_day"
                    android:id="@+id/tvLegendBest"
                    android:textSize="11sp"
                    android:textColor="#9A8F79"/>
            </LinearLayout>

            <!-- Bar chart — cream inset panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ov_payment_list"
                android:padding="10dp"
                android:layout_marginBottom="16dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"/>
            </LinearLayout>

            <!-- Metric cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_ov_pay_icon"
                    android:backgroundTint="#F3ECDD"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvBestLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_legend_best_day"
                        android:textColor="#9A8F79"
                        android:textSize="9.5sp"/>

                    <TextView
                        android:id="@+id/tvBestValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/dash"
                        android:textSize="16sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:textColor="#8A6526"/>

                    <TextView
                        android:id="@+id/tvBestSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dash"
                        android:textSize="11sp"
                        android:textColor="#9A8F79"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_ov_pay_icon"
                    android:backgroundTint="#DDEEEE"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvAvgLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_metric_avg_day_label"
                        android:textColor="#9A8F79"
                        android:textSize="9.5sp"/>

                    <TextView
                        android:id="@+id/tvAvgValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/dash"
                        android:textSize="16sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:textColor="#085041"/>

                    <TextView
                        android:id="@+id/tvAvgSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dash"
                        android:textSize="11sp"
                        android:textColor="#9A8F79"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Breakdown list -->
            <TextView
                android:id="@+id/tvBreakdownLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reports_breakdown_daily"
                android:textSize="11.5sp"
                android:textColor="#9A8F79"
                android:layout_marginBottom="2dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        </FrameLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
