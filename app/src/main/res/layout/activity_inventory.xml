<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3ECDD">

    <!-- ===================== TOOLBAR ===================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:navigationIconTint="#1A1A18" />

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INVENTORY"
                android:textColor="#B8895A"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/googlesans_semibold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock"
                    android:textColor="#1A1A18"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/googlesans_bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="room"
                    android:textColor="#0F6E56"
                    android:textSize="21sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:includeFontPadding="false" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ===================== HERO: STOCK VALUE CARD ===================== -->
    <!-- Same shape as CreditAccountsActivity's "Net position" card: big
         label + serif figure with a status caption on the baseline, then
         two side-by-side tiles below (bg_credit_tile_amber / _red). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_inv_value_card"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total stock value"
            android:textSize="11sp"
            android:textColor="#9A8F79" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="2dp"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tvKpiValue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="30sp"
                android:textColor="#1A1A18"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:singleLine="true"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="20sp"
                app:autoSizeMaxTextSize="30sp" />

            <TextView
                android:id="@+id/tvKpiCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:text="all in stock"
                android:textSize="11sp"
                android:textColor="#8A8272" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_credit_tile_amber"
                android:padding="10dp">
                <TextView
                    android:id="@+id/tvKpiLow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textColor="#854F0B"
                    android:singleLine="true"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Low stock"
                    android:textSize="9.5sp"
                    android:textColor="#BA7517" />
            </LinearLayout>

            <View android:layout_width="8dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_credit_tile_red"
                android:padding="10dp">
                <TextView
                    android:id="@+id/tvKpiOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textColor="#791F1F"
                    android:singleLine="true"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Out of stock"
                    android:textSize="9.5sp"
                    android:textColor="#A32D2D" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvHeroSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="0 active SKUs"
        android:textSize="11sp"
        android:textColor="#9A8F79"
        android:fontFamily="@font/googlesans_medium" />

    <!-- ===================== SEARCH + FILTER + SORT (inline) ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_inv_stat_card"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_search"
                app:tint="#B8895A"
                android:contentDescription="@null" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="@string/search_products"
                android:inputType="text"
                android:maxLength="50"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:textSize="12.5sp"
                android:textColor="#1A1A18"
                android:textColorHint="#9A8F79"
                android:minHeight="0dp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnFilter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_inv_stat_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_filter"
                app:tint="#B8895A"
                android:contentDescription="Filter" />

            <TextView
                android:id="@+id/tvFilterBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="1dp"
                android:minWidth="13dp"
                android:minHeight="13dp"
                android:gravity="center"
                android:paddingHorizontal="3dp"
                android:background="@drawable/bg_hdr_badge_red"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:fontFamily="@font/googlesans_semibold"
                android:includeFontPadding="false"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnSort"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_inv_stat_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lc_sliders"
                app:tint="#B8895A"
                android:contentDescription="Sort" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnResetFilters"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_credit_tile_red"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="#B23A3A"
                android:contentDescription="Reset filters" />

        </FrameLayout>

    </LinearLayout>

    <!-- Kept off-screen: InventoryActivity still writes the "N products ·
         sort label" summary text here for badge/reset bookkeeping, but the
         pill itself is no longer shown — Reset now lives inline in the
         search row above as an icon button. -->
    <TextView
        android:id="@+id/tvResultSummary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- ===================== CATEGORY CHIPS ===================== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:paddingHorizontal="12dp"
        android:scrollbars="none"
        android:clipToPadding="false">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/layoutChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:singleLine="true"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatAll"
                android:text="All categories"
                android:checked="true"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:checkable="true"
                app:chipBackgroundColor="@android:color/white"
                app:chipStrokeColor="@color/chip_stroke_inv_selector"
                app:chipStrokeWidth="1.5dp"
                app:chipCornerRadius="8dp"
                app:chipStartPadding="12dp"
                app:chipEndPadding="12dp"
                app:checkedIconVisible="false"
                app:chipMinTouchTargetSize="0dp"
                android:textColor="@color/chip_text_inv_selector"
                android:fontFamily="@font/googlesans_medium"
                android:textSize="12sp"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ===================== BULK ACTION BAR (conditional) ===================== -->
    <LinearLayout
        android:id="@+id/layoutBulk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_inv_bulk"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="11dp"
        android:paddingHorizontal="11dp"
        android:paddingVertical="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="2 selected"
            android:textSize="12sp"
            android:textColor="#CFE0F7"/>

        <TextView android:id="@+id/btnBulkEditPrice" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Edit price" android:textSize="11sp" android:textColor="#CFE0F7"
            android:background="@drawable/bg_inv_bulk_act" android:paddingHorizontal="8dp" android:paddingVertical="4dp"/>
        <TextView android:id="@+id/btnBulkCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp"
            android:text="Category" android:textSize="11sp" android:textColor="#CFE0F7"
            android:background="@drawable/bg_inv_bulk_act" android:paddingHorizontal="8dp" android:paddingVertical="4dp"/>
        <TextView android:id="@+id/btnBulkInactive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp"
            android:text="Mark inactive" android:textSize="11sp" android:textColor="#412402"
            android:background="@drawable/bg_inv_bulk_act_gold" android:paddingHorizontal="8dp" android:paddingVertical="4dp"/>
    </LinearLayout>

    <!-- ===================== SECTION LABEL ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="ALL PRODUCTS" android:textSize="11sp" android:textColor="#9CA3AF"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInventory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_inv_value_card"
            android:clipToPadding="false"
            android:paddingBottom="4dp"
            android:overScrollMode="never"
            android:scrollbars="none"/>

        <TextView
            android:id="@+id/tvInventoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="No matching products"
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
