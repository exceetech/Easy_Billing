<?xml version="1.0" encoding="utf-8"?>
<!--
    "Session Expiring" — offline-timeout warning shown by
    BaseActivity.showSessionWarning() / SessionTimeoutGuard.showWarning()
    ~15 seconds before an auto-logout for no internet.

    Same card shell as dialog_sign_out.xml (soft circle icon + centered
    title/message + stacked buttons), tinted red throughout — icon badge,
    countdown pill, and warning strip — since this is warning the user their
    session is about to be ended, not just an informational amber notice.

    tvSessionExpiringCountdown holds JUST the number of seconds (e.g. "15s"),
    set from code each time the dialog is shown/refreshed; the surrounding
    message text stays static in the layout. Kept as two separate views
    (rather than one interpolated string) so the countdown can read as its
    own visual beat — a pill, not prose.

    Ids bound from BaseActivity/SessionTimeoutGuard: tvSessionExpiringCountdown,
    btnSessionExpiringOk.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:paddingHorizontal="22dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_circle_soft_red">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_kpi_cloud_off"
            app:tint="#9A2E2E"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Session Expiring"
        android:textColor="#1A1A18"
        android:textSize="20sp"
        android:fontFamily="@font/googlesans_bold"
        android:includeFontPadding="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="No internet connection detected"
        android:textColor="#8A8272"
        android:textSize="12.5sp"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:id="@+id/tvSessionExpiringCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_red"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="Logging out in 15s"
        android:textColor="#9A2E2E"
        android:textSize="12sp"
        android:maxLines="1"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_warning_strip_red"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lc_alert_triangle"
            app:tint="#9A2E2E"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Reconnect now to stay signed in — your work is saved locally either way."
            android:textColor="#9A2E2E"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="@font/googlesans_medium" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSessionExpiringOk"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        app:backgroundTint="#0F6E56"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Got it"
        android:textAllCaps="false"
        android:textSize="13.5sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:icon="@drawable/ic_check"
        app:iconTint="@android:color/white"
        app:iconSize="15dp"
        app:iconGravity="textStart"
        app:iconPadding="7dp"
        app:cornerRadius="14dp"
        app:rippleColor="#33FFFFFF" />

</LinearLayout>
