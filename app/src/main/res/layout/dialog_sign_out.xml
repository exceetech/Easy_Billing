<?xml version="1.0" encoding="utf-8"?>
<!--
    "Sign out?" confirmation — same card shell as dialog_confirm_credit_note.xml
    (soft circle icon + centered title/message + stacked buttons), rose
    instead of teal since this is a destructive/session-ending action,
    with the title/message center-aligned per the requested design
    (Option 1: icon tile, "Sign out?" label centered).

    Ids bound by ProfileFragment: btnConfirmSignOut, btnCancelSignOut.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:paddingHorizontal="22dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_circle_soft_red">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_logout"
            app:tint="#9A2E2E"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Sign out?"
        android:textColor="#1A1A18"
        android:textSize="20sp"
        android:fontFamily="@font/googlesans_bold"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/tvSignOutMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="You'll need to log in again to access your store."
        android:textColor="#8A8272"
        android:textSize="12.5sp"
        android:lineSpacingExtra="3dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmSignOut"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_cta_red"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Sign out"
        android:textAllCaps="false"
        android:textSize="13.5sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:icon="@drawable/ic_logout"
        app:iconTint="@android:color/white"
        app:iconSize="16dp"
        app:iconGravity="textStart"
        app:iconPadding="7dp"
        app:cornerRadius="14dp"
        app:rippleColor="#33FFFFFF" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelSignOut"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_imp_filter"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Stay signed in"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="#1A1A18"
        android:fontFamily="@font/googlesans_medium"
        android:includeFontPadding="false"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:cornerRadius="14dp"
        app:rippleColor="#14000000" />

</LinearLayout>
