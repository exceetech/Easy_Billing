<?xml version="1.0" encoding="utf-8"?>
<!--
    "Cancel / void invoice?" confirmation — champagne theme, same card shell
    as dialog_cancel_purchase_confirm.xml: soft-red circle + ban icon,
    invoice number eyebrow, serif-italic destructive title, a gold warning
    strip calling out the immediate GST/inventory effect, solid red confirm
    + ghost keep.

    Ids bound by BillDetailsActivity: tvCancelInvoiceEyebrow,
    tvCancelInvoiceMessage, btnConfirmCancelInvoice, btnKeepInvoice.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:paddingHorizontal="22dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_circle_soft_red">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_cancel"
            app:tint="#B23A3A"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCancelInvoiceEyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/dialog_cancel_void_invoice_invoice"
        android:textColor="#B8895A"
        android:textSize="10sp"
        android:letterSpacing="0.16"
        android:fontFamily="@font/googlesans_semibold"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_cancel_void_invoice_cancel"
            android:textColor="#1A1A18"
            android:textSize="20sp"
            android:fontFamily="@font/googlesans_bold"
            android:includeFontPadding="false" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/dialog_cancel_void_invoice_void_invoice"
            android:textColor="#B23A3A"
            android:textSize="20sp"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCancelInvoiceMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/dialog_cancel_void_invoice_mark_this_invoice_as"
        android:textColor="#8A8272"
        android:textSize="12.5sp"
        android:lineSpacingExtra="3dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_warning_strip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="14dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_warning"
            app:tint="#8A6526"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/dialog_cancel_void_invoice_gst_reporting_and_inventory"
            android:textColor="#8A6526"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmCancelInvoice"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_cta_red"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/dialog_cancel_void_invoice_yes_cancel_invoice"
        android:textAllCaps="false"
        android:textSize="13.5sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:icon="@drawable/ic_cancel"
        app:iconTint="@android:color/white"
        app:iconSize="16dp"
        app:iconGravity="textStart"
        app:iconPadding="7dp"
        app:cornerRadius="14dp"
        app:rippleColor="#33FFFFFF" 
            android:gravity="center"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKeepInvoice"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_cta_green_tonal"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/dialog_cancel_void_invoice_keep_invoice"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="#0F6E56"
        android:fontFamily="@font/googlesans_medium"
        android:includeFontPadding="false"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:icon="@drawable/ic_lc_check"
        app:iconTint="#0F6E56"
        app:iconSize="15dp"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:cornerRadius="14dp"
        app:rippleColor="#220F6E56" 
            android:gravity="center"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>

</LinearLayout>
