<?xml version="1.0" encoding="utf-8"?>

<!--
  Generic destructive-confirm dialog (delete draft, etc.) in the app's
  champagne dialog language — red circular icon badge, gold eyebrow,
  bold+italic-serif title, plain message, neutral Cancel + red-tint action.

  Reused across GstReportsActivity's "Delete Draft?" prompts.
  Bound programmatically: tvEyebrow, tvTitleBold, tvTitleAccent, tvMessage,
  btnNegative, btnPositive.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_dialog_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_circle_soft_red">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lc_trash"
            app:tint="#B23A3A" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvEyebrow"
        android:text="@string/xml_gst_confirm_eyebrow"
        android:textSize="10sp"
        android:letterSpacing="0.16"
        android:fontFamily="@font/googlesans_semibold"
        android:textColor="#B8895A"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">
        <TextView
            android:id="@+id/tvTitleBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_gst_confirm_title_bold"
            android:textColor="#1A1A18"
            android:textSize="19sp"
            android:fontFamily="@font/googlesans_bold"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"/>
        <TextView
            android:id="@+id/tvTitleAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_gst_confirm_title_accent"
            android:textColor="#B23A3A"
            android:textSize="19sp"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvMessage"
        android:text="@string/xml_gst_confirm_message"
        android:textSize="12.5sp"
        android:textColor="#8A8272"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPositive"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:text="@string/xml_gst_confirm_positive_btn"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textSize="13.5sp"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        app:backgroundTint="#791F1F"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_lc_trash"
        app:iconTint="@android:color/white"
        app:iconSize="16dp"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        android:gravity="center"
        android:insetLeft="0dp"
        android:insetRight="0dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNegative"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:text="@string/xml_gst_confirm_cancel_btn"
        android:textColor="#9A2E2E"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:background="@drawable/bg_inv_action_close"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        app:icon="@drawable/ic_close"
        app:iconTint="#B91C1C"
        app:iconSize="16dp"
        app:iconGravity="textStart"
        app:iconPadding="7dp"
        app:cornerRadius="14dp"
        app:rippleColor="#F6D8D4"
        android:gravity="center"
        android:insetLeft="0dp"
        android:insetRight="0dp"/>

</LinearLayout>
