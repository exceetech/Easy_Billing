<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch line item — same structure as item_sales_return_row.xml (the
    credit-note line item card): price-led header with left accent
    stripe, monogram avatar, hairline divider, footer stepper row with
    the qty centered between outlined −/+ buttons, and a return-value
    preview line that only appears once a quantity is entered.

    Bound by BatchPickerAdapter: viewItemStripe, tvAvatar, tvBatchLabel,
    tvOldestTag (hidden unless this is the oldest batch with stock),
    tvBatchMeta ("14 Jul 2026 · ₹42/unit · 18 left"), tvUnitCost,
    tvMaxReturn, etBatchQty, tvBatchAmount, btnDecrement, btnIncrement.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_inv_value_card"
    android:clipToOutline="true"
    android:clipChildren="true">

    <View
        android:id="@+id/viewItemStripe"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#1D6E6E" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="B"
                android:textSize="13sp"
                android:textColor="#1D6E6E"
                android:fontFamily="@font/googlesans_semibold"
                android:background="@drawable/bg_credit_avatar"
                android:backgroundTint="#DDEEEE"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvBatchLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xml_batch_pick_number_placeholder"
                        android:textSize="13.5sp"
                        android:textColor="#1A1A18"
                        android:fontFamily="@font/googlesans_medium"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:maxWidth="150dp" />

                    <TextView
                        android:id="@+id/tvOldestTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="1dp"
                        android:background="@drawable/bg_credit_avatar"
                        android:backgroundTint="#F1EBDD"
                        android:textSize="9.5sp"
                        android:textColor="#8A6526"
                        android:visibility="gone"
                        android:text="@string/xml_batch_pick_oldest_tag"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBatchMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="10sp"
                    android:textColor="#9A8F79"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/xml_batch_pick_date_cost_placeholder"/>

                <!-- Remaining — labelled caption instead of a bare
                     number, so it reads as "Max reducible: 18" rather
                     than a stray unstyled digit. -->
                <TextView
                    android:id="@+id/tvMaxReturn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10sp"
                    android:textColor="#8A6526"
                    android:fontFamily="@font/googlesans_medium"
                    android:text="@string/xml_batch_pick_max_reducible_placeholder"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvUnitCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="₹0"
                android:textSize="18sp"
                android:textColor="#1A1A18"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="9dp"
            android:background="#F1EBDD" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="11.5sp"
                android:textColor="#3A322A"
                android:fontFamily="@font/googlesans_medium"
                android:text="@string/xml_batch_pick_reduce_qty_label"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDecrement"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="−"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="#1D6E6E"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                app:elevation="0dp"
                app:cornerRadius="9dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#E1DAC8"
                app:strokeWidth="1dp"
                app:rippleColor="#14000000"/>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBatchQty"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:textSize="15sp"
                android:textColor="#1A1A18"
                android:fontFamily="serif"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:hint="0"
                android:textColorHint="#A99E88"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIncrement"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="+"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                app:elevation="0dp"
                app:cornerRadius="9dp"
                app:backgroundTint="#1D6E6E"
                app:strokeWidth="0dp"
                app:rippleColor="#33FFFFFF"/>
        </LinearLayout>

        <!-- Reduce value preview — only takes space once a qty is entered. -->
        <TextView
            android:id="@+id/tvBatchAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="end"
            android:textSize="10.5sp"
            android:textColor="#0F6E56"
            android:fontFamily="@font/googlesans_medium"
            android:visibility="gone"
            android:text="@string/xml_batch_pick_reduce_value_placeholder"/>

    </LinearLayout>

</LinearLayout>
