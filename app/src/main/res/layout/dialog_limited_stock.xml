<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_dialog_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- ICON BADGE -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_circle_soft_amber">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="#854F0B" />
    </FrameLayout>

    <TextView
        android:text="INVENTORY"
        android:textSize="10sp"
        android:letterSpacing="0.14"
        android:fontFamily="@font/googlesans_semibold"
        android:textColor="#B8895A"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- TITLE -->
    <TextView
        android:id="@+id/tvTitle"
        android:text="Limited stock"
        android:textSize="18sp"
        android:textColor="#1A1A18"
        android:fontFamily="@font/googlesans_bold"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- MESSAGE -->
    <TextView
        android:id="@+id/tvMessage"
        android:text="Only X available.\nDo you want to add available quantity?"
        android:textSize="12sp"
        android:textColor="#8A8272"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- ACTIONS: stacked, primary on top -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddAvailable"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:text="Add available"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textSize="13.5sp"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:gravity="center"
        app:backgroundTint="#854F0B"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:stateListAnimator="@null"
        app:icon="@drawable/ic_lc_check"
        app:iconTint="@android:color/white"
        app:iconSize="17dp"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:cornerRadius="14dp"
        app:rippleColor="#33FFFFFF"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_inv_action_close"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textSize="13.5sp"
        android:textColor="#9A2E2E"
        android:textStyle="bold"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:gravity="center"
        android:stateListAnimator="@null"
        app:icon="@drawable/ic_close"
        app:iconTint="#B91C1C"
        app:iconSize="16dp"
        app:iconGravity="textStart"
        app:iconPadding="7dp"
        app:cornerRadius="14dp"
        app:rippleColor="#F6D8D4"/>

</LinearLayout>
