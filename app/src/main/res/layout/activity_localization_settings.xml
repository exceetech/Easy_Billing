<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0E6">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Title + Edit action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/localization_region_label"
                        android:textColor="#B8895A"
                        android:textSize="10sp"
                        android:letterSpacing="0.16"
                        android:fontFamily="@font/googlesans_semibold"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/localization_language_title_part1"
                            android:textColor="#1A1A18"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02"
                            android:fontFamily="@font/googlesans_bold"
                            android:includeFontPadding="false"
                            android:accessibilityHeading="true"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/localization_language_title_part2"
                            android:textColor="#0F6E56"
                            android:textSize="21sp"
                            android:fontFamily="serif"
                            android:textStyle="italic"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Edit pill (toggles edit mode) — gold gradient, matching
                     the Unlock/Edit pills elsewhere. -->
                <LinearLayout
                    android:id="@+id/btnEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_inv_seg_selected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_si_edit"
                        app:tint="#1A1A18"
                        android:contentDescription="@string/edit"/>

                    <TextView
                        android:id="@+id/tvEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit"
                        android:textColor="#1A1A18"
                        android:textSize="13sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== PREFERENCES ===================== -->
            <!-- cardPreferences: faded (alpha 0.6) until Edit is tapped,
                 same locked/unlocked feel as the other settings screens. -->
            <LinearLayout android:id="@+id/cardPreferences" style="@style/AddCard"
                android:layout_marginTop="16dp"
                android:paddingTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D4A574"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="9dp" android:text="@string/localization_preferences_label"
                        android:textColor="#8A6526" android:textSize="12sp" android:textStyle="bold"
                        android:letterSpacing="0.08"/>
                </LinearLayout>

                <!-- Language -->
                <LinearLayout style="@style/SiBlock" android:layout_marginTop="0dp">
                    <TextView style="@style/SiFieldLabel" android:text="@string/language"/>
                    <LinearLayout
                        android:id="@+id/rowLanguage"
                        style="@style/SiFieldBox"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView style="@style/SiIcon"
                            android:src="@drawable/ic_set_languages" app:tint="#534AB7"/>
                        <TextView
                            android:id="@+id/tvLanguage"
                            style="@style/SiValue"
                            android:text="@string/localization_language_default_value"/>
                        <ImageView
                            android:id="@+id/icLanguageChevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#C9C3B4"
                            android:contentDescription="@null"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Currency -->
                <LinearLayout style="@style/SiBlock">
                    <TextView style="@style/SiFieldLabel" android:text="@string/currency"/>
                    <LinearLayout
                        android:id="@+id/rowCurrency"
                        style="@style/SiFieldBox"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView style="@style/SiIcon"
                            android:src="@drawable/ic_si_currency" app:tint="#8A6526"/>
                        <TextView
                            android:id="@+id/tvCurrency"
                            style="@style/SiValue"
                            android:text="@string/localization_currency_default_value"/>
                        <ImageView
                            android:id="@+id/icCurrencyChevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#C9C3B4"
                            android:contentDescription="@null"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Restart note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="4dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="7dp"
                    android:src="@drawable/ic_info_circle"
                    app:tint="#9A968C"
                    android:contentDescription="@null"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/localization_restart_note"
                    android:textColor="#9A8F79"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"/>
            </LinearLayout>

            <!-- Save — solid teal CTA matching the app's other confirm
                 buttons, instead of SiSavePill's navy. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveLocalization"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="@string/save_changes"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="13.5sp"
                android:fontFamily="@font/googlesans_semibold"
                android:includeFontPadding="false"
                android:background="@drawable/bg_login_cta_green"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                app:elevation="0dp"
                app:icon="@drawable/ic_lucide_check"
                app:iconTint="#FFFFFF"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:iconPadding="7dp"
                app:cornerRadius="14dp"
                app:rippleColor="#33FFFFFF"
                android:visibility="gone"
            android:gravity="center"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
