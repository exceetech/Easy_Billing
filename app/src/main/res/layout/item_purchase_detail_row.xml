<?xml version="1.0" encoding="utf-8"?>
<!--
    Purchase-detail line item — redesigned to match the batch-row card used
    in Inventory's Reduce Stock page (item_batch_clear.xml): each item is its
    own rounded card with a left accent stripe, a circular monogram avatar,
    name + meta on the left, and a serif amount on the right. Rows are no
    longer stacked inside one long card with thin dividers — this one reads
    as a clear standalone row, same as Reduce Stock.

    Bound by PurchaseDetailsActivity.buildItemsList: viewItemStripe, tvAvatar,
    tvProductName, tvReturnedChip, tvHsnQty, tvLineTotal, tvCostAndGst,
    viewItemDivider (kept, always collapsed — cards are separated by margin
    now instead of a divider line).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginVertical="5dp"
        android:background="@drawable/bg_inv_value_card"
        android:clipToOutline="true"
        android:clipChildren="true">

        <View
            android:id="@+id/viewItemStripe"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#E4DBC6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="P"
                android:textSize="13sp"
                android:textColor="#8A8272"
                android:fontFamily="@font/googlesans_semibold"
                android:background="@drawable/bg_credit_avatar"
                android:backgroundTint="#F3ECDD"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvProductName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xml_purchase_detail_row_product_placeholder"
                        android:textSize="13.5sp"
                        android:textColor="#1A1A18"
                        android:fontFamily="@font/googlesans_medium"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvReturnedChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textSize="9.5sp"
                        android:textColor="#8A6526"
                        android:background="@drawable/bg_credit_avatar"
                        android:backgroundTint="#F1EBDD"
                        android:visibility="gone"
                        android:text="@string/xml_purchase_detail_row_returned_placeholder" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHsnQty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/xml_purchase_detail_row_hsn_qty_placeholder"
                    android:textSize="11sp"
                    android:textColor="#9A8F79"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/tvLineTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textColor="#1A1A18"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvCostAndGst"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="0%"
                    android:textSize="9.5sp"
                    android:textColor="#A99E88" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Kept so PurchaseDetailsActivity's findViewById(R.id.viewItemDivider)
         call still works; always collapsed since cards are separated by
         margin now, not a divider line. -->
    <View
        android:id="@+id/viewItemDivider"
        android:layout_width="0dp"
        android:layout_height="0dp" />

</LinearLayout>
