<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0E6">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true"
        app:cardBackgroundColor="#FFFFFF">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="100dp">

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- HEADER: avatar + greeting/shop (left) | date pill (right)     -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/llAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_ov_avatar">

                    <TextView
                        android:id="@+id/tvInitials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="?"
                        android:textColor="#8A6526"
                        android:textSize="13sp"
                        android:fontFamily="@font/googlesans_semibold"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="11dp">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_overview_good_morning"
                        android:textColor="#9A8F79"
                        android:textSize="11.5sp"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvShopName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_overview_your_store"
                        android:textColor="#1A1A18"
                        android:textSize="15sp"
                        android:fontFamily="@font/googlesans_semibold"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#9A8F79"
                android:textSize="11.5sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_date_pill"/>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- HERO CARD — teal, sparkle mark, inline delta + comparison,    -->
        <!-- full-width sparkline underneath                                -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#085041"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fragment_overview_total_revenue"
                            android:textColor="#9FE1CB"
                            android:textSize="9.5sp"
                            android:letterSpacing="0.18"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="32sp"
                            android:fontFamily="@font/googlesans_semibold"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_lucide_sparkles"
                        app:tint="#9FE1CB"
                        android:contentDescription="@null"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tvRevenueGrowth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#9FE1CB"
                        android:textSize="11.5sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/bg_ov_hero_growth_pos"
                        android:fontFamily="@font/googlesans_semibold"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvRevenuePrev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#61FFFFFF"
                        android:textSize="11.5sp"/>
                </LinearLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chartRevenueMini"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- TODAY AT A GLANCE — 2×2 metrics grid                          -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D4A574"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@string/fragment_overview_glance"
                android:textColor="#8A6526"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>
        </LinearLayout>

        <!-- Row 1: Bills / Avg bill (with growth chips) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#DDEEEE"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:src="@drawable/ic_lucide_receipt"
                            app:tint="#0F6E56"
                            android:contentDescription="Bills"/>

                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/tvBillsGrowth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#0F6E56"
                            android:textSize="9.5sp"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:background="@drawable/bg_growth_positive"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBills"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#085041"
                        android:textSize="20sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_overview_total_bills"
                        android:textColor="#0F6E56"
                        android:textSize="10.5sp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="#F3ECDD"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:src="@drawable/ic_lucide_chart_bar"
                            app:tint="#B8895A"
                            android:contentDescription="Avg bill"/>

                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/tvAverageGrowth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#8A6526"
                            android:textSize="9.5sp"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:background="@drawable/bg_growth_positive"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAverage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#8A6526"
                        android:textSize="20sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_overview_avg_bill"
                        android:textColor="#B8895A"
                        android:textSize="10.5sp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Row 2: Returns / Cancelled (no growth chip) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="18dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#FAEEDA"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <!-- Same icon+chip row shape as Bills/Avg bill (chip
                         placeholder invisible) so all 4 KPI cards match height. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:src="@drawable/ic_lucide_corner_up_left"
                            app:tint="#8A6526"
                            android:contentDescription="Returns"/>

                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="9.5sp"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:visibility="invisible"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvReturns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#8A6526"
                        android:textSize="20sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/tvReturnsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_overview_returns"
                        android:textColor="#8A6526"
                        android:textSize="10.5sp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="#FBEDED"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <!-- Same icon+chip row shape as Bills/Avg bill (chip
                         placeholder invisible) so all 4 KPI cards match height. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:src="@drawable/ic_lucide_circle_x"
                            app:tint="#791F1F"
                            android:contentDescription="Cancelled"/>

                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="9.5sp"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:visibility="invisible"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCancelled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#791F1F"
                        android:textSize="20sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/tvCancelledAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_overview_cancelled"
                        android:textColor="#9A2E2E"
                        android:textSize="10.5sp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- PAYMENT SPLIT — single stacked bar + list rows                -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D4A574"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@string/fragment_overview_payment_split"
                android:textColor="#8A6526"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ov_payment_list"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/fragment_overview_total_collected"
                    android:textColor="#9A8F79"
                    android:textSize="11.5sp"/>
                <TextView
                    android:id="@+id/tvPaymentTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#1A1A18"
                    android:textSize="17sp"
                    android:fontFamily="@font/googlesans_semibold"/>
            </LinearLayout>

            <!-- Single stacked bar — one continuous track, 4 colored segments
                 sized by weight (share of revenue), clipped to the track's
                 rounded corners so the segments never poke past the ends. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_ov_stack_track"
                android:clipToOutline="true"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/vBarCashFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/ov_green_cash"/>
                <View
                    android:id="@+id/vBarUpiFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/ov_purple"/>
                <View
                    android:id="@+id/vBarCardFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/ov_blue"/>
                <View
                    android:id="@+id/vBarCreditFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/ov_amber"/>
                <View
                    android:id="@+id/vBarSpacer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="100"
                    android:background="@android:color/transparent"/>
            </LinearLayout>

            <!-- CASH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <FrameLayout android:layout_width="26dp" android:layout_height="26dp"
                    android:background="@drawable/bg_ov_pay_icon" android:backgroundTint="#DDEEEE">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:layout_gravity="center" android:src="@drawable/ic_lucide_cash"
                        app:tint="@color/ov_green_cash" android:contentDescription="Cash"/>
                </FrameLayout>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/fragment_overview_cash"
                    android:textColor="#1A1A18" android:textSize="12.5sp"/>
                <TextView android:id="@+id/tvCashPct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp" android:text="0%"
                    android:textColor="#9A8F79" android:textSize="11.5sp"/>
                <TextView android:id="@+id/tvCashAmount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/ov_green_cash" android:textSize="12.5sp"
                    android:fontFamily="@font/googlesans_semibold"/>
            </LinearLayout>

            <!-- UPI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <FrameLayout android:layout_width="26dp" android:layout_height="26dp"
                    android:background="@drawable/bg_ov_pay_icon" android:backgroundTint="#EEEDFE">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:layout_gravity="center" android:src="@drawable/ic_lucide_device_mobile"
                        app:tint="@color/ov_purple" android:contentDescription="UPI"/>
                </FrameLayout>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/fragment_overview_upi"
                    android:textColor="#1A1A18" android:textSize="12.5sp"/>
                <TextView android:id="@+id/tvUpiPct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp" android:text="0%"
                    android:textColor="#9A8F79" android:textSize="11.5sp"/>
                <TextView android:id="@+id/tvUpiAmount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/ov_purple" android:textSize="12.5sp"
                    android:fontFamily="@font/googlesans_semibold"/>
            </LinearLayout>

            <!-- CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <FrameLayout android:layout_width="26dp" android:layout_height="26dp"
                    android:background="@drawable/bg_ov_pay_icon" android:backgroundTint="#E6F1FB">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:layout_gravity="center" android:src="@drawable/ic_lucide_credit_card"
                        app:tint="@color/ov_blue" android:contentDescription="Card"/>
                </FrameLayout>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/fragment_overview_card"
                    android:textColor="#1A1A18" android:textSize="12.5sp"/>
                <TextView android:id="@+id/tvCardPct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp" android:text="0%"
                    android:textColor="#9A8F79" android:textSize="11.5sp"/>
                <TextView android:id="@+id/tvCardAmount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/ov_blue" android:textSize="12.5sp"
                    android:fontFamily="@font/googlesans_semibold"/>
            </LinearLayout>

            <!-- CREDIT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <FrameLayout android:layout_width="26dp" android:layout_height="26dp"
                    android:background="@drawable/bg_ov_pay_icon" android:backgroundTint="#F3ECDD">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:layout_gravity="center" android:src="@drawable/ic_lucide_wallet"
                        app:tint="@color/ov_amber" android:contentDescription="Credit"/>
                </FrameLayout>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/fragment_overview_credit"
                    android:textColor="#1A1A18" android:textSize="12.5sp"/>
                <TextView android:id="@+id/tvCreditPct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp" android:text="0%"
                    android:textColor="#9A8F79" android:textSize="11.5sp"/>
                <TextView android:id="@+id/tvCreditAmount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/ov_amber" android:textSize="12.5sp"
                    android:fontFamily="@font/googlesans_semibold"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

    </FrameLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
