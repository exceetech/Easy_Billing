<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown row for PurchaseReturnActivity's GSTR-2 AutoCompleteTextViews —
     same bg_pos_dropdown popup sheet as item_dropdown_ep, plus a highlighted
     background + trailing check mark for whichever row matches the field's
     current value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowDropdownItem"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvDropdownItemText"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:textColor="#1A1A18"
        android:textSize="14sp"
        android:fontFamily="@font/googlesans_medium"
        android:ellipsize="end"
        android:singleLine="true"/>

    <ImageView
        android:id="@+id/ivDropdownItemCheck"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_lc_check"
        app:tint="#0F6E56"
        android:visibility="gone"
        android:contentDescription="@null"/>

</LinearLayout>
