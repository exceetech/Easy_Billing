<?xml version="1.0" encoding="utf-8"?>

<!--
  Peak hours — champagne redesign: cream page + white card.
  eyebrow+serif header (Peak *hours* + 24 Hour gold chip + bubble-chart button)
    · peak-revenue hero · legend · cream-inset bar chart · 2 stat cards
    · hourly breakdown list. Bubble-chart button opens the full-screen bubble dialog.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0E6">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true"
        app:cardBackgroundColor="#FFFFFF">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="110dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/peak_hours_eyebrow_today"
                        android:textColor="#B8895A"
                        android:textSize="10sp"
                        android:letterSpacing="0.16"
                        android:fontFamily="@font/googlesans_semibold"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/peak_hours_title_peak"
                            android:textColor="#1A1A18"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/googlesans_bold"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/peak_hours_title_hours_suffix"
                            android:textColor="#0F6E56"
                            android:textSize="19sp"
                            android:fontFamily="serif"
                            android:textStyle="italic"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPeriodChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peak_hours_period_chip_default"
                    android:textSize="11sp"
                    android:textColor="#8A6526"
                    android:fontFamily="@font/googlesans_semibold"
                    android:background="#F3ECDD"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"/>
            </LinearLayout>

            <!-- Peak revenue hero -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peak_hours_hero_label"
                android:textSize="11.5sp"
                android:textColor="#9A8F79"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPeakRevenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dash"
                    android:textSize="28sp"
                    android:fontFamily="@font/googlesans_bold"
                    android:textColor="#1A1A18"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tvDelta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dash"
                    android:textSize="11sp"
                    android:fontFamily="@font/googlesans_semibold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPeakAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dash"
                android:textSize="11.5sp"
                android:textColor="#9A8F79"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"/>

            <!-- Legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#B8895A"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peak_hours_legend_hourly_revenue"
                    android:textSize="11sp"
                    android:textColor="#9A8F79"
                    android:layout_marginEnd="14dp"/>

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#0F6E56"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peak_hours_legend_peak_hour"
                    android:textSize="11sp"
                    android:textColor="#9A8F79"/>
            </LinearLayout>

            <!-- Hourly bar chart — cream inset panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ov_payment_list"
                android:padding="10dp"
                android:layout_marginBottom="16dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"/>
            </LinearLayout>

            <!-- Metric cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_ov_pay_icon"
                    android:backgroundTint="#F3ECDD"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/peak_hours_metric_best_hour_label"
                        android:textColor="#9A8F79"
                        android:textSize="9.5sp"/>

                    <TextView
                        android:id="@+id/tvBestValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/dash"
                        android:textSize="16sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:textColor="#8A6526"/>

                    <TextView
                        android:id="@+id/tvBestSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dash"
                        android:textSize="11sp"
                        android:textColor="#9A8F79"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_ov_pay_icon"
                    android:backgroundTint="#DDEEEE"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/peak_hours_metric_avg_hour_label"
                        android:textColor="#9A8F79"
                        android:textSize="9.5sp"/>

                    <TextView
                        android:id="@+id/tvAvgValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/dash"
                        android:textSize="16sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:textColor="#085041"/>

                    <TextView
                        android:id="@+id/tvAvgSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dash"
                        android:textSize="11sp"
                        android:textColor="#9A8F79"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Hourly breakdown list -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peak_hours_breakdown_label"
                android:textSize="11.5sp"
                android:textColor="#9A8F79"
                android:layout_marginBottom="2dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPeakHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        </FrameLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
