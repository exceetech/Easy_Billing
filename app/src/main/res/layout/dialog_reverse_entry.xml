<?xml version="1.0" encoding="utf-8"?>
<!-- Reverse manual entry confirm. Bound by ManualEntryDialog.confirmReverse(): btnReverse, btnCancel. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_lg_dialog" android:fillViewport="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="20dp" android:paddingBottom="18dp">
        <FrameLayout android:id="@+id/flBadge" android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="center" android:layout_marginBottom="10dp" android:background="@drawable/bg_mae_ic_rose_big">
            <ImageView android:id="@+id/ivBadge" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_lc_rotate_ccw" app:tint="#9A2E2E"/>
        </FrameLayout>
        <TextView android:id="@+id/tvEyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mae_rev_eyebrow" android:textSize="11sp" android:letterSpacing="0.16" android:fontFamily="@font/googlesans_semibold" android:textColor="#8A6526" android:gravity="center"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="1dp">
            <TextView android:id="@+id/tvTitleA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mae_rev_a" android:textColor="#1A1A18" android:textSize="19sp" android:fontFamily="@font/googlesans_bold" android:includeFontPadding="false"/>
            <TextView android:id="@+id/tvTitleB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/mae_rev_b" android:textColor="#9A2E2E" android:textSize="19sp" android:textStyle="italic" android:fontFamily="serif" android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView android:id="@+id/tvSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mae_rev_sub" android:textSize="12.5sp" android:textColor="#5B6660" android:gravity="center" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="13dp" android:background="@drawable/bg_lg_card" android:text="@string/mae_rev_info" android:textSize="12.5sp" android:lineSpacingExtra="2dp" android:textColor="#4C5650" android:fontFamily="@font/googlesans_regular"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnReverse" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:text="@string/mae_rev_btn" android:textColor="@android:color/white" android:textAllCaps="false" android:textSize="13.5sp" android:fontFamily="@font/googlesans_semibold" android:includeFontPadding="false" android:background="@drawable/bg_lg_cta_red_14"
        app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp" android:stateListAnimator="@null" app:cornerRadius="14dp" app:icon="@drawable/ic_lc_rotate_ccw" app:iconTint="@android:color/white" app:iconSize="17dp" app:iconGravity="textStart" app:iconPadding="8dp" android:gravity="center"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"
            android:text="@string/dialog_confirm_print_cancel" android:textColor="#4B554F" android:textAllCaps="false" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/googlesans_semibold" android:includeFontPadding="false"
            android:background="@drawable/bg_dialog_cancel_neutral" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp" android:stateListAnimator="@null"
            app:icon="@drawable/ic_close" app:iconTint="#B91C1C" app:iconSize="16dp" app:iconGravity="textStart" app:iconPadding="7dp" app:cornerRadius="14dp" app:rippleColor="#F6D8D4" android:gravity="center"/>
    </LinearLayout>
</ScrollView>
