<?xml version="1.0" encoding="utf-8"?>

<!--
  Product profit detail — same premium shell as dialog_ledger_summary.xml:
  centered icon badge, eyebrow + serif-italic title, an icon-tile
  reconciliation card (Revenue/Cost/Loss) resolving into a big serif "Net
  profit" hero with a margin caption, an "at a glance" 2-up stat strip,
  the stock-flow bar, and a teal Close CTA.

  Bound by ProfitActivity.showProductDialog: tvEyebrow, tvName (title
  accent word, static "profit"), tvNameSub, tvRevenue, tvCost, tvLoss,
  tvLossCaption, tvNetProfit, tvMargin, tvRemaining, tvAdded (repurposed as
  "Total added" tile value), barSold, barLoss, barRemaining, tvSold,
  tvLossQty, tvRemaining (bar legend), btnClose.

  ivInsight/tvInsight/chipInsight ids are kept (hidden, 0dp) so
  ProfitActivity's existing insight-chip binding code doesn't crash;
  the insight text now appears inline in tvNameSub instead.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_card"
        android:paddingHorizontal="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_dialog_soft_amber_circle">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_si_trend_up"
                app:tint="#8A6526"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="PRODUCT"
            android:textColor="#B8895A"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/googlesans_semibold"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product"
                android:textColor="#1A1A18"
                android:textSize="20sp"
                android:fontFamily="@font/googlesans_bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="profit"
                android:textColor="#0F6E56"
                android:textSize="20sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Product name"
            android:textColor="#1A1A18"
            android:textSize="14sp"
            android:fontFamily="@font/googlesans_medium"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvNameSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="—"
            android:textColor="#9A8F79"
            android:textSize="11.5sp" />

        <!-- Retained so ProfitActivity's insight-chip binding code doesn't
             need touching; the insight text now lives in tvNameSub. -->
        <LinearLayout android:id="@+id/chipInsight" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
            <ImageView android:id="@+id/ivInsight" android:layout_width="0dp" android:layout_height="0dp"/>
            <TextView android:id="@+id/tvInsight" android:layout_width="0dp" android:layout_height="0dp"/>
        </LinearLayout>

        <!-- ===================== RECONCILIATION → NET PROFIT ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_credit_compare_card"
            android:paddingHorizontal="14dp"
            android:paddingVertical="13dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_lc_arrow_up_right"
                    app:tint="#8A6526"
                    android:background="@drawable/bg_credit_action_tile"
                    android:backgroundTint="#FAEEDA"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Revenue"
                    android:textSize="12.5sp"
                    android:textColor="#1A1A18" />
                <TextView
                    android:id="@+id/tvRevenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="16sp"
                    android:textColor="#8A6526"
                    android:fontFamily="serif"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_lc_arrow_down_left"
                    app:tint="#B23A3A"
                    android:background="@drawable/bg_credit_action_tile"
                    android:backgroundTint="#FCEBEB"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Cost"
                    android:textSize="12.5sp"
                    android:textColor="#1A1A18" />
                <TextView
                    android:id="@+id/tvCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="16sp"
                    android:textColor="#B23A3A"
                    android:fontFamily="serif"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_si_alert"
                    app:tint="#8A6526"
                    android:background="@drawable/bg_credit_action_tile"
                    android:backgroundTint="#F3ECDD"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loss"
                        android:textSize="12.5sp"
                        android:textColor="#1A1A18" />
                    <TextView
                        android:id="@+id/tvLossCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="no shrinkage"
                        android:textSize="10sp"
                        android:textColor="#A99E88" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvLoss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="16sp"
                    android:textColor="#8A6526"
                    android:fontFamily="serif"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="8dp"
                android:background="#EAE2D1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Net profit"
                    android:textSize="12.5sp"
                    android:textColor="#9A8F79" />
                <TextView
                    android:id="@+id/tvNetProfit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="22sp"
                    android:textColor="#1A1A18"
                    android:fontFamily="serif"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMargin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="end"
                android:text="0% margin"
                android:textSize="10sp"
                android:textColor="#085041" />
        </LinearLayout>

        <!-- Retained (hidden) so the old margin-pill binding code has
             somewhere to land without touching ProfitActivity's structure
             more than necessary. -->
        <LinearLayout android:id="@+id/layoutMarginPill" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
            <ImageView android:id="@+id/ivMargin" android:layout_width="0dp" android:layout_height="0dp"/>
        </LinearLayout>

        <!-- ===================== AT A GLANCE ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ov_pay_icon"
                android:backgroundTint="#DDEEEE"
                android:paddingHorizontal="11dp"
                android:paddingVertical="9dp">
                <TextView
                    android:id="@+id/tvRemainingStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="15sp"
                    android:fontFamily="@font/googlesans_semibold"
                    android:textColor="#085041"
                    android:singleLine="true"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Remaining stock"
                    android:textSize="9.5sp"
                    android:textColor="#9A8F79" />
            </LinearLayout>

            <View android:layout_width="8dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ov_pay_icon"
                android:backgroundTint="#FAEEDA"
                android:paddingHorizontal="11dp"
                android:paddingVertical="9dp">
                <TextView
                    android:id="@+id/tvAdded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="15sp"
                    android:fontFamily="@font/googlesans_semibold"
                    android:textColor="#8A6526"
                    android:singleLine="true"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Total added"
                    android:textSize="9.5sp"
                    android:textColor="#9A8F79" />
            </LinearLayout>
        </LinearLayout>

        <!-- Stock flow -->
        <TextView style="@style/AddSectionLabel" android:text="STOCK FLOW"
            android:layout_marginStart="4dp"
            android:layout_marginTop="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_imp_card"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="7dp">
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:textSize="11sp" android:textColor="#9A968C" android:text="Stock movement"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_bar_track"
                android:clipToOutline="true">
                <View android:id="@+id/barSold" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="#1D9E75"/>
                <View android:id="@+id/barLoss" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="0" android:background="#E24B4A"/>
                <View android:id="@+id/barRemaining" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="0" android:background="#D3D1C7"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="9dp">
                <TextView android:id="@+id/tvSold" style="@style/PdLegend"
                    android:textColor="#0F6E56" android:text="● Sold 0"/>
                <TextView android:id="@+id/tvLossQty" style="@style/PdLegend"
                    android:layout_marginStart="14dp"
                    android:textColor="#A32D2D" android:text="● Loss 0"/>
                <TextView android:id="@+id/tvRemaining" style="@style/PdLegend"
                    android:layout_marginStart="14dp"
                    android:textColor="#6E6A60" android:text="● Remaining 0"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_inv_action_close"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="#9A2E2E"
            android:fontFamily="@font/googlesans_semibold"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            app:rippleColor="#F6D8D4"
            app:icon="@drawable/ic_close"
            app:iconTint="#B91C1C"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
