<?xml version="1.0" encoding="utf-8"?>
<!--
    Debit note (additional charge) — champagne theme, same language as
    purchase details / credit accounts: eyebrow + serif-italic accent header,
    white bg_inv_value_card summary with tinted tiles, one card of
    hairline-separated item rows, green CTA.

    Ids bound by DebitNoteActivity: tvInvoiceNumber, tvInvoiceDate,
    rvDebitItems, tvTotalDebitValue, tvAdditionalGst, btnConfirmDebit,
    btnCancelDebit.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3ECDD">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_debit_note_additional_charge"
                android:textColor="#B8895A"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/googlesans_semibold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_debit_note_debit"
                    android:textColor="#1A1A18"
                    android:textSize="21sp"
                    android:letterSpacing="-0.02"
                    android:fontFamily="@font/googlesans_bold"
                    android:includeFontPadding="false"
                    android:accessibilityHeading="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/activity_debit_note_note"
                    android:textColor="#0F6E56"
                    android:textSize="21sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Invoice pill — same pattern as chipHeaderPhone in
                 activity_customer_transactions.xml. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_credit_phone_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginTop="5dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_lc_file_text"
                    app:tint="#B8895A"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvInvoiceNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/activity_debit_note_invoice"
                    android:textColor="#8A6526"
                    android:fontFamily="@font/googlesans_medium"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Date — top-right aligned with the header. -->
        <TextView
            android:id="@+id/tvInvoiceDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="—"
            android:textColor="#8A8272"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Section label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="6dp"
        android:text="@string/activity_debit_note_enter_additional_quantity_per"
        android:textSize="11sp"
        android:textColor="#9A8F79"
        android:letterSpacing="0.08"
        android:fontFamily="@font/googlesans_semibold" />

    <!-- Items list — each row draws its own card (see item_debit_note_line.xml)
         with a left accent stripe, rather than one shared list card. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDebitItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="4dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"/>

    <!-- ===================== BOTTOM SUMMARY + CONFIRM ===================== -->
    <!-- No card here on purpose — this reads as a running footer total
         rather than another boxed section, unlike every card above it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/activity_debit_note_total_additional_value"
                android:textSize="11.5sp"
                android:textColor="#9A8F79" />

            <TextView
                android:id="@+id/tvTotalDebitValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textColor="#1A1A18"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:singleLine="true"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="18sp"
                app:autoSizeMaxTextSize="26sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_debit_note_taxable"
                android:textSize="10.5sp"
                android:textColor="#8A6526" />

            <TextView
                android:id="@+id/tvTaxableTile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textSize="10.5sp"
                android:textColor="#8A6526"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/activity_debit_note_gst"
                android:textSize="10.5sp"
                android:textColor="#0F6E56" />

            <TextView
                android:id="@+id/tvAdditionalGst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textSize="10.5sp"
                android:textColor="#0F6E56"
                android:fontFamily="serif" />
        </LinearLayout>

        <!-- Kept for the adapter binding; not surfaced in this cardless
             footer design. -->
        <TextView
            android:id="@+id/tvItemsAdjustedBadge"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="@string/activity_debit_note_0_items_adjusted"/>

        <TextView
            android:id="@+id/tvGrandTotalTile"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="0"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:background="#DDD3BB" />

        <!-- Confirm button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmDebit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/activity_debit_note_confirm_amp_issue_debit"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="13.5sp"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            app:backgroundTint="@null"
            android:background="@drawable/bg_login_cta_green"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_lc_check"
            app:iconTint="#FFFFFF"
            app:iconSize="17dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="14dp"/>

        <!-- Cancel button — same rose "ghost destructive" treatment as
             btnCancel in activity_purchase.xml. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDebit"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/activity_debit_note_cancel"
            android:textColor="#9A2E2E"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:background="@drawable/bg_inv_action_close"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_close"
            app:iconTint="#B91C1C"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconPadding="7dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@null"
            app:rippleColor="#F6D8D4"/>

    </LinearLayout>

</LinearLayout>
