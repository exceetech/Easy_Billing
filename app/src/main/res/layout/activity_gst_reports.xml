<?xml version="1.0" encoding="utf-8"?>
<!--
    GST reports — champagne theme, same language as credit accounts, purchase
    history and purchase details: eyebrow + serif accent header, white cards,
    serif numerals, tinted tiles, segmented toggle.

    Ids bound by GstReportsActivity (all preserved):
      toolbar, selectorReturnType, tvSelectorValue, tvGstin,
      chipGroupReturnType, chipMonthly, chipQuarterly, spinnerFY, spinnerPeriod,
      btnGenerate, progressGenerate, cardSummary, tvSummaryHeroLabel,
      tvSummaryTax, tvSummaryTaxable, tvSummaryInvoices, tvSummaryCreditNotes,
      llValidationBanner, tvValidationStatus, tabLayout, viewPager,
      btnValidate, btnSaveDraft, btnExportCsv, btnExportExcel,
      llDraftsSection, rvDrafts.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3ECDD"
    tools:context=".GstReportsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:navigationIcon="@drawable/ic_back_arrow"
        app:navigationIconTint="#1A1A18" />

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GST RETURNS"
                android:textColor="#B8895A"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/googlesans_semibold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GST "
                    android:textColor="#1A1A18"
                    android:textSize="22sp"
                    android:letterSpacing="-0.02"
                    android:fontFamily="@font/googlesans_bold"
                    android:includeFontPadding="false"
                    android:accessibilityHeading="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="reports"
                    android:textColor="#0F6E56"
                    android:textSize="22sp"
                    android:textStyle="italic"
                    android:fontFamily="serif"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_history"
            app:tint="#7A6E57"
            android:contentDescription="Saved drafts" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- GSTIN pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_gstin_pill"
                android:paddingStart="10dp"
                android:paddingEnd="13dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_lc_shield_check"
                    app:tint="#0F6E56"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="GSTIN"
                    android:textSize="9.5sp"
                    android:letterSpacing="0.08"
                    android:textColor="#9A8F79"
                    android:fontFamily="@font/googlesans_semibold" />

                <TextView
                    android:id="@+id/tvGstin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="#1A1A18"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    tools:text="33ABCDE1234F1Z5" />
            </LinearLayout>

            <!-- ===================== REPORT TYPE SELECTOR (dropdown chip) ===================== -->
            <LinearLayout
                android:id="@+id/selectorReturnType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="210dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_glass_input"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingVertical="9dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RETURN"
                        android:textColor="#B8895A"
                        android:textSize="9.5sp"
                        android:letterSpacing="0.14"
                        android:fontFamily="@font/googlesans_semibold" />

                    <TextView
                        android:id="@+id/tvSelectorValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="GSTR-1 · Sales"
                        android:textColor="#1A1A18"
                        android:textSize="16sp"
                        android:fontFamily="serif"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#8A7F68"
                    android:contentDescription="Change return type" />
            </LinearLayout>

            <!-- ===================== PERIOD CARD ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_inv_value_card"
                android:padding="16dp">

                <!-- Financial-year stepper -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FINANCIAL YEAR"
                    android:textSize="10sp"
                    android:textColor="#9A8F79"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/googlesans_semibold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_period_track"
                    android:padding="4dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/btnFyPrev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_stepper_btn"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="#8A7F68"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Previous year" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvFyValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2025–26"
                            android:textSize="19sp"
                            android:textColor="#1A1A18"
                            android:fontFamily="serif"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/tvFyRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Apr 2025 – Mar 2026"
                            android:textSize="10sp"
                            android:textColor="#A89E88" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnFyNext"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_stepper_btn"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#8A7F68"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Next year" />
                </LinearLayout>

                <!-- Period label + monthly/quarterly -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="PERIOD"
                        android:textSize="10sp"
                        android:textColor="#9A8F79"
                        android:letterSpacing="0.06"
                        android:fontFamily="@font/googlesans_semibold" />

                    <LinearLayout
                        android:id="@+id/segReturnType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_period_track"
                        android:padding="3dp">

                        <TextView
                            android:id="@+id/segMonthly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monthly"
                            android:textSize="12sp"
                            android:fontFamily="@font/googlesans_medium"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:gravity="center"
                            android:background="@drawable/bg_period_pill"
                            android:backgroundTint="#1A1A18"
                            android:textColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/segQuarterly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:text="Quarterly"
                            android:textSize="12sp"
                            android:fontFamily="@font/googlesans_medium"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:gravity="center"
                            android:background="@drawable/bg_period_pill"
                            android:backgroundTint="#00000000"
                            android:textColor="#8A7F68"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Month / quarter strip -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:id="@+id/llPeriodStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerate"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="52dp"
                        android:text="Generate report"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/bg_login_cta_green"
                        app:icon="@drawable/ic_lc_file_text"
                        app:iconTint="#FFFFFF"
                        app:iconSize="18dp"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:cornerRadius="14dp"
                        android:stateListAnimator="@null" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressGenerate"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="12dp"
                        android:visibility="gone"
                        app:indicatorColor="#0F6E56"
                        app:indicatorSize="28dp"
                        app:trackThickness="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== VALIDATION BANNER ===================== -->
            <LinearLayout
                android:id="@+id/llValidationBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="11dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_credit_avatar"
                android:backgroundTint="#E1F5EE"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvValidationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12.5sp"
                    android:textColor="#0F5943"
                    android:fontFamily="@font/googlesans_medium"
                    tools:text="✓ All checks passed — Ready to export" />
            </LinearLayout>

            <!-- ===================== SUMMARY HERO ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0.5dp"
                app:strokeColor="#ECE7DA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSummaryHeroLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total tax this period"
                        android:textSize="11sp"
                        android:textColor="#9A8F79" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="2dp"
                        android:baselineAligned="false">

                        <TextView
                            android:id="@+id/tvSummaryTax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textSize="30sp"
                            android:textColor="#1A1A18"
                            android:fontFamily="serif"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            tools:text="₹1,42,380" />

                        <TextView
                            android:id="@+id/tvSummaryTaxable"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:paddingBottom="4dp"
                            android:textSize="12sp"
                            android:textColor="#9A8F79"
                            android:gravity="end"
                            android:singleLine="true"
                            tools:text="on ₹7,91,000 taxable" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_credit_avatar"
                            android:backgroundTint="#F6F0E4"
                            android:padding="12dp">
                            <TextView
                                android:id="@+id/tvSummaryInvoices"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="20sp"
                                android:textColor="#3A322A"
                                android:fontFamily="@font/googlesans_bold"
                                android:includeFontPadding="false"
                                tools:text="128" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Invoices"
                                android:textSize="10.5sp"
                                android:textColor="#9A8F79" />
                        </LinearLayout>

                        <View android:layout_width="10dp" android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_credit_tile_red"
                            android:padding="12dp">
                            <TextView
                                android:id="@+id/tvSummaryCreditNotes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="20sp"
                                android:textColor="#791F1F"
                                android:fontFamily="@font/googlesans_bold"
                                android:includeFontPadding="false"
                                tools:text="6" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Credit notes"
                                android:textSize="10.5sp"
                                android:textColor="#A32D2D" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== SECTION CHIPS ===================== -->
            <HorizontalScrollView
                android:id="@+id/scrollSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/chipGroupSections"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0.5dp"
                app:strokeColor="#ECE7DA">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager"
                    android:layout_width="match_parent"
                    android:layout_height="360dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== EXPORT ACTIONS (list rows) ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0.5dp"
                app:strokeColor="#ECE7DA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Validate -->
                    <LinearLayout
                        android:id="@+id/btnValidate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="13dp"
                        android:enabled="false"
                        android:alpha="0.45"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:gravity="center" android:background="@drawable/bg_period_pill"
                            android:backgroundTint="#EAF3DE">
                            <ImageView android:layout_width="19dp" android:layout_height="19dp"
                                android:src="@drawable/ic_lc_shield_check" app:tint="#3B6D11"
                                android:contentDescription="@null" />
                        </LinearLayout>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:text="Validate report" android:textSize="14sp" android:textColor="#1A1A18"
                            android:fontFamily="@font/googlesans_medium" />
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:src="@drawable/ic_chevron_right" app:tint="#C9C3B4"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginHorizontal="14dp" android:background="#F0EBDD" />

                    <!-- Export Excel -->
                    <LinearLayout
                        android:id="@+id/btnExportExcel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="13dp"
                        android:enabled="false"
                        android:alpha="0.45"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:gravity="center" android:background="@drawable/bg_period_pill"
                            android:backgroundTint="#E1F5EE">
                            <ImageView android:layout_width="19dp" android:layout_height="19dp"
                                android:src="@drawable/ic_lc_bar_chart" app:tint="#0F6E56"
                                android:contentDescription="@null" />
                        </LinearLayout>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:text="Export to Excel" android:textSize="14sp" android:textColor="#1A1A18"
                            android:fontFamily="@font/googlesans_medium" />
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:src="@drawable/ic_chevron_right" app:tint="#C9C3B4"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginHorizontal="14dp" android:background="#F0EBDD" />

                    <!-- Export CSV -->
                    <LinearLayout
                        android:id="@+id/btnExportCsv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="13dp"
                        android:enabled="false"
                        android:alpha="0.45"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:gravity="center" android:background="@drawable/bg_period_pill"
                            android:backgroundTint="#FAEEDA">
                            <ImageView android:layout_width="19dp" android:layout_height="19dp"
                                android:src="@drawable/ic_lc_file_text" app:tint="#854F0B"
                                android:contentDescription="@null" />
                        </LinearLayout>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:text="Export to CSV" android:textSize="14sp" android:textColor="#1A1A18"
                            android:fontFamily="@font/googlesans_medium" />
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:src="@drawable/ic_chevron_right" app:tint="#C9C3B4"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginHorizontal="14dp" android:background="#F0EBDD" />

                    <!-- Save as draft -->
                    <LinearLayout
                        android:id="@+id/btnSaveDraft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="13dp"
                        android:enabled="false"
                        android:alpha="0.45"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:gravity="center" android:background="@drawable/bg_period_pill"
                            android:backgroundTint="#EEEDFE">
                            <ImageView android:layout_width="19dp" android:layout_height="19dp"
                                android:src="@drawable/ic_lc_file_plus" app:tint="#3C3489"
                                android:contentDescription="@null" />
                        </LinearLayout>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:text="Save as draft" android:textSize="14sp" android:textColor="#1A1A18"
                            android:fontFamily="@font/googlesans_medium" />
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:src="@drawable/ic_chevron_right" app:tint="#C9C3B4"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== DRAFTS ===================== -->
            <LinearLayout
                android:id="@+id/llDraftsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAVED DRAFTS"
                    android:textSize="11sp"
                    android:textColor="#9A8F79"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/googlesans_semibold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDrafts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
