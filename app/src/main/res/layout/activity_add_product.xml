<?xml version="1.0" encoding="utf-8"?>
<!--
    Add product screen — phone layout (single column, stacked).

    This is the DEFAULT (phone) version. The original two-card
    side-by-side design (Product Details | Pricing & Tax) plus a
    4-column GST/UQC/Cess row lives unchanged in
    layout-sw600dp/activity_add_product.xml — tablets load that version
    automatically via Android's screen-width resource qualifier, phones
    load this one. See phone_compatibility_plan.md Phase 8.

    Body (stacked, top to bottom): Product Details, Pricing & Tax, GST &
    Compliance (4 fields now stacked one per row instead of 4 across),
    Opening Stock. Every id is preserved exactly, so findViewById keeps
    working identically on both form factors.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3ECDD"
    android:paddingBottom="16dp">

    <!-- ══ Toolbar (usual back arrow) ══ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <!-- ══ Header — same design as Inventory ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INVENTORY"
                android:textColor="#B8895A"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/googlesans_semibold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add"
                    android:textColor="#1A1A18"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/googlesans_bold"
                    android:includeFontPadding="false"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="product"
                    android:textColor="#0F6E56"
                    android:textSize="21sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_addp_badge"
            android:paddingHorizontal="13dp"
            android:paddingVertical="7dp">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_lc_tag"
                app:tint="#B8895A"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"/>
            <TextView
                android:id="@+id/tvCatalogBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New to catalog"
                android:textColor="#8A8272"
                android:textSize="12.5sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ══ Scrollable body ══ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp">

            <!-- Product Details, then Pricing & Tax — stacked (was a
                 side-by-side row on tablet). -->

                <!-- ─ PRODUCT DETAILS ─ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_addp_card"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D4A574"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="PRODUCT DETAILS"
                            android:textColor="#8A6526"
                            android:textSize="12sp"
                            android:letterSpacing="0.12"
                            android:fontFamily="@font/googlesans_semibold"/>
                    </LinearLayout>

                    <TextView style="@style/AddpFieldLabel" android:text="Product name"/>
                    <AutoCompleteTextView
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_glass_input"
                        android:popupBackground="@drawable/bg_pos_dropdown"
                        android:paddingHorizontal="13dp"
                        android:drawablePadding="10dp"
                        app:drawableStartCompat="@drawable/ic_lc_box"
                        android:drawableTint="#B8895A"
                        android:hint="Search or type new"
                        android:textColorHint="#A99E88"
                        android:textColor="#1A1A18"
                        android:textSize="15sp"
                        android:inputType="textCapWords"
                        android:completionThreshold="1"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView style="@style/AddpFieldLabel" android:text="Variant"/>
                            <AutoCompleteTextView
                                android:id="@+id/etVariant"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:background="@drawable/bg_glass_input"
                                android:popupBackground="@drawable/bg_pos_dropdown"
                                android:paddingHorizontal="13dp"
                                android:drawablePadding="8dp"
                                app:drawableStartCompat="@drawable/ic_lc_ruler"
                                app:drawableEndCompat="@drawable/ic_lc_chevron_down"
                                android:drawableTint="#B8895A"
                                android:hint="Size or pack type"
                                android:textColorHint="#A99E88"
                                android:textColor="#1A1A18"
                                android:textSize="15sp"
                                android:inputType="textCapWords"
                                android:completionThreshold="1"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView style="@style/AddpFieldLabel" android:text="Unit"/>
                            <TextView
                                android:id="@+id/etUnit"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_glass_input"
                                android:paddingHorizontal="13dp"
                                android:drawablePadding="8dp"
                                app:drawableStartCompat="@drawable/ic_lc_scale"
                                app:drawableEndCompat="@drawable/ic_lc_chevron_down"
                                android:drawableTint="#B8895A"
                                android:hint="Tap to select"
                                android:textColorHint="#A99E88"
                                android:textColor="#1A1A18"
                                android:textSize="15sp"
                                android:clickable="true"
                                android:focusable="true"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView style="@style/AddpFieldLabel" android:text="Category"/>
                    <TextView
                        android:id="@+id/etCategory"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_glass_input"
                        android:paddingHorizontal="13dp"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_lc_tag"
                        app:drawableEndCompat="@drawable/ic_lc_chevron_down"
                        android:drawableTint="#B8895A"
                        android:hint="Tap to select"
                        android:textColorHint="#A99E88"
                        android:textColor="#1A1A18"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- ─ PRICING & TAX ─ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_addp_card"
                    android:padding="18dp"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D4A574"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="PRICING &amp; TAX"
                            android:textColor="#8A6526"
                            android:textSize="12sp"
                            android:letterSpacing="0.12"
                            android:fontFamily="@font/googlesans_semibold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView style="@style/AddpFieldLabel" android:text="Selling price"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:background="@drawable/bg_glass_input"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="13dp">
                                <ImageView
                                    android:layout_width="17dp"
                                    android:layout_height="17dp"
                                    android:src="@drawable/ic_lc_indian_rupee"
                                    app:tint="#B8895A"
                                    android:contentDescription="@null"/>
                                <EditText
                                    android:id="@+id/etPrice"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@android:color/transparent"
                                    android:paddingStart="9dp"
                                    android:hint="Rate per unit"
                                    android:textColorHint="#A99E88"
                                    android:textColor="#1A1A18"
                                    android:textSize="15sp"
                                    android:inputType="numberDecimal"/>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView style="@style/AddpFieldLabel" android:text="HSN / SAC"/>
                            <EditText
                                android:id="@+id/etHsn"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:background="@drawable/bg_glass_input"
                                android:paddingHorizontal="13dp"
                                android:drawablePadding="8dp"
                                app:drawableStartCompat="@drawable/ic_lc_file_text"
                                android:drawableTint="#B8895A"
                                android:hint="Tax code"
                                android:textColorHint="#A99E88"
                                android:textColor="#1A1A18"
                                android:textSize="15sp"
                                android:inputType="number"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- MRP toggle bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_addp_toggle_bar"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:paddingVertical="8dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price includes tax"
                                android:textColor="#1A1A18"
                                android:textSize="14sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Selling price is MRP (tax-inclusive)"
                                android:textColor="#8A8272"
                                android:textSize="11.5sp"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchTaxInclusive"
                            style="@style/EpSwitch"
                            android:checked="true"/>
                    </LinearLayout>

                    <!-- CGST / SGST / IGST -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView style="@style/AddpFieldLabel" android:text="CGST"/>
                            <EditText
                                android:id="@+id/etCgst"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_glass_input"
                                android:paddingHorizontal="10dp"
                                android:drawablePadding="5dp"
                                app:drawableStartCompat="@drawable/ic_lc_percent"
                                android:drawableTint="#B8895A"
                                android:hint="Central tax"
                                android:textColorHint="#A99E88"
                                android:textColor="#1A1A18"
                                android:textSize="15sp"
                                android:inputType="numberDecimal"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView style="@style/AddpFieldLabel" android:text="SGST"/>
                            <EditText
                                android:id="@+id/etSgst"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_glass_input"
                                android:paddingHorizontal="10dp"
                                android:drawablePadding="5dp"
                                app:drawableStartCompat="@drawable/ic_lc_percent"
                                android:drawableTint="#B8895A"
                                android:hint="State tax"
                                android:textColorHint="#A99E88"
                                android:textColor="#1A1A18"
                                android:textSize="15sp"
                                android:inputType="numberDecimal"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView style="@style/AddpFieldLabel" android:text="IGST · auto"/>
                            <EditText
                                android:id="@+id/etIgst"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_addp_field_disabled"
                                android:paddingHorizontal="10dp"
                                android:drawablePadding="5dp"
                                app:drawableStartCompat="@drawable/ic_lc_percent"
                                android:drawableTint="#B0A895"
                                android:hint="Auto-filled"
                                android:textColorHint="#B0A895"
                                android:textColor="#8A8272"
                                android:textSize="15sp"
                                android:enabled="false"
                                android:inputType="numberDecimal"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            <!-- ─ GST & COMPLIANCE ─ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_addp_card"
                android:padding="18dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D4A574"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="GST &amp; COMPLIANCE"
                        android:textColor="#8A6526"
                        android:textSize="12sp"
                        android:letterSpacing="0.12"
                        android:fontFamily="@font/googlesans_semibold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="optional — for GSTR-1 filing"
                        android:textColor="#A99E88"
                        android:textSize="11.5sp"/>
                </LinearLayout>

                <!-- UQC / supply classification / HSN description / cess —
                     stacked one per row (was a 4-column row on tablet). -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView style="@style/AddpFieldLabel" android:text="Official UQC"/>
                        <TextView
                            android:id="@+id/spinnerUqc"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_glass_input"
                            android:paddingHorizontal="13dp"
                            android:drawablePadding="8dp"
                            app:drawableStartCompat="@drawable/ic_lc_scale"
                            app:drawableEndCompat="@drawable/ic_lc_chevron_down"
                            android:drawableTint="#B8895A"
                            android:hint="Auto from unit"
                            android:textColorHint="#A99E88"
                            android:textColor="#1A1A18"
                            android:textSize="14.5sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">
                        <TextView style="@style/AddpFieldLabel" android:text="Supply classification"/>
                        <TextView
                            android:id="@+id/spinnerSupplyClass"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_glass_input"
                            android:paddingHorizontal="13dp"
                            android:drawablePadding="8dp"
                            app:drawableStartCompat="@drawable/ic_lc_truck"
                            app:drawableEndCompat="@drawable/ic_lc_chevron_down"
                            android:drawableTint="#B8895A"
                            android:hint="Tap to select"
                            android:textColorHint="#A99E88"
                            android:textColor="#1A1A18"
                            android:textSize="14.5sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">
                        <TextView style="@style/AddpFieldLabel" android:text="HSN description"/>
                        <EditText
                            android:id="@+id/etHsnDesc"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_glass_input"
                            android:paddingHorizontal="13dp"
                            android:drawablePadding="8dp"
                            app:drawableStartCompat="@drawable/ic_lc_file_text"
                            android:drawableTint="#B8895A"
                            android:hint="Short description"
                            android:textColorHint="#A99E88"
                            android:textColor="#1A1A18"
                            android:textSize="14.5sp"
                            android:maxLines="1"
                            android:inputType="textCapSentences"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">
                        <TextView style="@style/AddpFieldLabel" android:text="Cess %"/>
                        <EditText
                            android:id="@+id/etCessRate"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_glass_input"
                            android:paddingHorizontal="13dp"
                            android:drawablePadding="8dp"
                            app:drawableStartCompat="@drawable/ic_lc_percent"
                            android:drawableTint="#B8895A"
                            android:hint="If applicable"
                            android:textColorHint="#A99E88"
                            android:textColor="#1A1A18"
                            android:textSize="14.5sp"
                            android:inputType="numberDecimal"/>
                    </LinearLayout>
            </LinearLayout>

            <!-- ─ OPENING STOCK ─ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_addp_card"
                android:padding="18dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_addp_tile_green">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lc_package"
                            app:tint="#0F6E56"
                            android:contentDescription="@null"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="13dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add opening stock"
                            android:textColor="#1A1A18"
                            android:textSize="15sp"
                            android:fontFamily="@font/googlesans_semibold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Optional — sets current stock &amp; cost"
                            android:textColor="#8A8272"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchOpeningStock"
                        style="@style/EpSwitch"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/groupOpeningStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginTop="14dp"
                    android:gravity="bottom"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView style="@style/AddpFieldLabel" android:text="Quantity" android:layout_marginTop="0dp"/>
                        <EditText
                            android:id="@+id/etQty"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_glass_input"
                            android:paddingHorizontal="13dp"
                            android:drawablePadding="8dp"
                            app:drawableStartCompat="@drawable/ic_lc_package"
                            android:drawableTint="#B8895A"
                            android:hint="Current stock"
                            android:textColorHint="#A99E88"
                            android:textColor="#1A1A18"
                            android:textSize="15sp"
                            android:inputType="numberDecimal"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView style="@style/AddpFieldLabel" android:text="Cost / unit" android:layout_marginTop="0dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_glass_input"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="13dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹"
                                android:textColor="#1A1A18"
                                android:textSize="16sp"
                                android:fontFamily="@font/googlesans_semibold"/>
                            <EditText
                                android:id="@+id/etCost"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:paddingStart="6dp"
                                android:hint="What you paid"
                                android:textColorHint="#A99E88"
                                android:textColor="#1A1A18"
                                android:textSize="15sp"
                                android:inputType="numberDecimal"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1.4"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_addp_hint"
                        android:padding="12dp">
                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_lc_tag"
                            app:tint="#8A6526"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="No input credit. For GST ITC, use Record a purchase."
                            android:textColor="#8A6526"
                            android:textSize="12.5sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ══ Footer ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="18dp"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_inv_action_close"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_close"
                app:tint="#B91C1C"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#9A2E2E"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/googlesans_semibold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_weight="2.2"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_addp_save"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_lc_check"
                app:tint="#FFFFFF"
                android:layout_marginEnd="9dp"
                android:contentDescription="@null"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save product"
                android:textColor="#FFFFFF"
                android:textSize="16.5sp"
                android:fontFamily="@font/googlesans_semibold"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
