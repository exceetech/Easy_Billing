<?xml version="1.0" encoding="utf-8"?>
<!--
    Purchase invoice detail — champagne theme, same language as credit accounts
    and purchase history: eyebrow + serif accent header, white cards, serif
    numerals, tinted tiles.

    Ids bound by PurchaseDetailsActivity: toolbar, tvSupplierName, tvStatusPill,
    tvInvoiceInfo, tvSyncChip, tvTotalAmount, tvTaxableAmount, tvGstAmount,
    tvTaxBreakdown, tvPlaceOfSupply, tvSupplierGstin, layoutOwed,
    tvOwed, tvItemsHeader, llPurchaseItems, tvPriorReturnsHeader, llPriorReturns,
    rowNetReturns, tvNetAfterReturns, tvCancelledBanner, actionRow,
    btnDebitNote, btnCreditNote, btnClose, btnCancelPurchase.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3ECDD">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PURCHASE INVOICE"
            android:textColor="#B8895A"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/googlesans_semibold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="1dp">

            <TextView
                android:id="@+id/tvSupplierName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Supplier"
                android:textColor="#1A1A18"
                android:textSize="21sp"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/googlesans_bold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:accessibilityHeading="true" />

            <TextView
                android:id="@+id/tvStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="On credit"
                android:textSize="10.5sp"
                android:textColor="#A32D2D"
                android:fontFamily="@font/googlesans_medium"
                android:background="@drawable/bg_credit_avatar"
                android:backgroundTint="#FBEDED" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvInvoiceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INV-—  ·  —"
                android:textColor="#9A8F79"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvSyncChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1dp"
                android:text="not synced"
                android:textSize="9.5sp"
                android:textColor="#8A6526"
                android:background="@drawable/bg_credit_avatar"
                android:backgroundTint="#EFE6D5"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===================== CANCELLED BANNER ===================== -->
            <TextView
                android:id="@+id/tvCancelledBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:padding="10dp"
                android:gravity="center"
                android:text="This purchase was cancelled"
                android:textSize="12sp"
                android:textColor="#8A8272"
                android:background="@drawable/bg_credit_tile_red"
                android:backgroundTint="#F1EBDD"
                android:visibility="gone" />

            <!-- ===================== TOTALS CARD ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_inv_value_card"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invoice total"
                    android:textSize="11sp"
                    android:textColor="#9A8F79" />

                <TextView
                    android:id="@+id/tvTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="₹0"
                    android:textSize="30sp"
                    android:textColor="#1A1A18"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_credit_avatar"
                        android:backgroundTint="#F6F0E4"
                        android:padding="10dp">
                        <TextView
                            android:id="@+id/tvTaxableAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textSize="15sp"
                            android:textColor="#3A322A"
                            android:fontFamily="serif"
                            android:singleLine="true" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Taxable"
                            android:textSize="9.5sp"
                            android:textColor="#9A8F79" />
                    </LinearLayout>

                    <View android:layout_width="8dp" android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_credit_tile_teal"
                        android:padding="10dp">
                        <TextView
                            android:id="@+id/tvGstAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textSize="15sp"
                            android:textColor="#085041"
                            android:fontFamily="serif"
                            android:singleLine="true" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="GST"
                            android:textSize="9.5sp"
                            android:textColor="#0F6E56" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="12dp"
                    android:background="#F1EBDD" />

                <!-- Detail rows -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Tax breakdown" android:textSize="11sp" android:textColor="#9A8F79" />
                    <TextView android:id="@+id/tvTaxBreakdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="11sp" android:textColor="#3A322A" android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Place of supply" android:textSize="11sp" android:textColor="#9A8F79" />
                    <TextView android:id="@+id/tvPlaceOfSupply" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="11sp" android:textColor="#3A322A"
                        android:fontFamily="@font/googlesans_medium" android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Supplier GSTIN" android:textSize="11sp" android:textColor="#9A8F79" />
                    <TextView android:id="@+id/tvSupplierGstin" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="11sp" android:textColor="#3A322A"
                        android:fontFamily="@font/googlesans_medium" android:gravity="end" />
                </LinearLayout>

                <!-- Still owed (credit purchases only) -->
                <LinearLayout
                    android:id="@+id/layoutOwed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_credit_tile_red"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Still owed to this supplier" android:textSize="9.5sp" android:textColor="#A32D2D" />
                        <TextView android:id="@+id/tvOwed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="1dp" android:text="₹0" android:textSize="15sp"
                            android:textColor="#791F1F" android:fontFamily="serif" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="View ledger ›" android:textSize="11sp" android:textColor="#B23A3A" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== ITEMS ===================== -->
            <TextView
                android:id="@+id/tvItemsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="LINE ITEMS"
                android:textSize="11sp"
                android:textColor="#9A8F79"
                android:letterSpacing="0.08"
                android:fontFamily="@font/googlesans_semibold" />

            <LinearLayout
                android:id="@+id/llPurchaseItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_inv_value_card" />

            <!-- ===================== PRIOR RETURNS ===================== -->
            <TextView
                android:id="@+id/tvPriorReturnsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="DEBIT &amp; CREDIT NOTES"
                android:textSize="11sp"
                android:textColor="#9A8F79"
                android:letterSpacing="0.08"
                android:fontFamily="@font/googlesans_semibold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llPriorReturns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_inv_value_card" />

            <!-- ===================== NET AFTER RETURNS ===================== -->
            <LinearLayout
                android:id="@+id/rowNetReturns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:paddingTop="14dp"
                android:background="@drawable/bg_divider_top"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Net after returns"
                        android:textSize="13sp"
                        android:textColor="#1A1A18"
                        android:fontFamily="@font/googlesans_medium" />
                    <TextView
                        android:id="@+id/tvNetOriginalAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textSize="10.5sp"
                        android:textColor="#9A8F79" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNetAfterReturns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="₹0"
                    android:textSize="26sp"
                    android:textColor="#0F6E56"
                    android:fontFamily="serif" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===================== BOTTOM ACTIONS ===================== -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDebitNote"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Debit note"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:fontFamily="@font/googlesans_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                app:backgroundTint="@null"
                android:background="@drawable/bg_login_cta_green"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_lc_arrow_up_right"
                app:iconTint="#FFFFFF"
                app:iconSize="17dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="14dp"
                android:stateListAnimator="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreditNote"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:text="Credit note"
                android:textColor="#0F6E56"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:fontFamily="@font/googlesans_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_lc_arrow_down_left"
                app:iconTint="#0F6E56"
                app:iconSize="17dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="14dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#CDE0D8"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPurchase"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="Cancel purchase"
            android:textColor="#B23A3A"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_cancel"
            app:iconTint="#B23A3A"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:cornerRadius="14dp"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#E7C9C9"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Legacy id kept so existing click wiring compiles; hidden. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
