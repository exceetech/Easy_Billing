<?xml version="1.0" encoding="utf-8"?>
<!--
    Purchase invoice detail — card-wise redesign matching the Reduce Stock
    chrome (teal step-1 card, gold step-2/3 cards), per user approval of the
    mockup at the Purchase Details redesign stage. Same content and ids as
    before, now grouped into three themed cards so the page reads as clear
    sequential sections instead of one long scroll.

    Ids bound by PurchaseDetailsActivity: toolbar, tvSupplierName, tvStatusPill,
    tvInvoiceInfo, tvSyncChip, tvTotalAmount, tvTaxableAmount, tvGstAmount,
    tvCessKpiAmount, cardCessKpi, dividerCessKpi, tvTaxBreakdown,
    rowCessBreakdown, tvCessBreakdown, tvPlaceOfSupply, tvSupplierGstin,
    layoutOwed, tvOwed, tvItemsHeader, llPurchaseItems, tvPriorReturnsHeader,
    llPriorReturns, rowNetReturns, tvNetOriginalAmount, tvNetAfterReturns,
    tvCancelledBanner, actionRow, btnDebitNote, btnCreditNote, btnClose,
    btnCancelPurchase.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_lg_page">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_purchase_details_header"
            android:textColor="#B8895A"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/googlesans_semibold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="1dp">

            <TextView
                android:id="@+id/tvSupplierName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/xml_purchase_details_supplier_label"
                android:textColor="#1A1A18"
                android:textSize="21sp"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/googlesans_bold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:accessibilityHeading="true" />

            <TextView
                android:id="@+id/tvStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/purchase_history_tile_on_credit"
                android:textSize="10.5sp"
                android:textColor="#A32D2D"
                android:fontFamily="@font/googlesans_medium"
                android:background="@drawable/bg_credit_avatar"
                android:backgroundTint="#FBEDED" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvInvoiceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_purchase_details_inv"
                android:textColor="#7C8782"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvSyncChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1dp"
                android:text="@string/xml_purchase_details_not_synced"
                android:textSize="9.5sp"
                android:textColor="#8A6526"
                android:background="@drawable/bg_credit_avatar"
                android:backgroundTint="#EAEEEC"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===================== CANCELLED BANNER ===================== -->
            <TextView
                android:id="@+id/tvCancelledBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:padding="10dp"
                android:gravity="center"
                android:text="@string/xml_purchase_details_cancelled_note"
                android:textSize="12sp"
                android:textColor="#76867C"
                android:background="@drawable/bg_credit_tile_red"
                android:backgroundTint="#E3E8E4"
                android:visibility="gone" />

            <!-- ===================== CARD 1 · PURCHASE SUMMARY (teal, step 1) ===================== -->
            <com.example.easy_billing.ui.glass.GlassClipLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                
                android:background="@drawable/bg_lg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_lg_hdr_green"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                        <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_step_circle_ring"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/googlesans_bold"/>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/purchase_details_summary_card_title"
                            android:textColor="#123B31"
                            android:textSize="15sp"
                            android:fontFamily="@font/googlesans_semibold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/purchase_details_summary_card_hint"
                            android:textColor="#0F6E56"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Total row — matches the mockup's INVOICE TOTAL + big
                         serif figure. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xml_purchase_details_invoice_total_label"
                        android:textSize="10sp"
                        android:textColor="#7C8782"
                        android:fontFamily="@font/googlesans_medium" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textSize="28sp"
                        android:textColor="#1A1A18"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:includeFontPadding="false"
                        android:singleLine="true" />

                    <!-- Taxable / GST / CESS tiles — restored to the
                         original colored-tile design (neutral, teal, amber). -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_credit_avatar"
                            android:backgroundTint="#EEF2F0"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp">
                            <TextView
                                android:id="@+id/tvTaxableAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="14sp"
                                android:textColor="#2F3531"
                                android:fontFamily="serif"
                                android:singleLine="true"
                                android:ellipsize="end" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/gst_report_col_taxable"
                                android:textSize="9.5sp"
                                android:textColor="#7C8782" />
                        </LinearLayout>

                        <View android:layout_width="6dp" android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_credit_tile_teal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp">
                            <TextView
                                android:id="@+id/tvGstAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="14sp"
                                android:textColor="#085041"
                                android:fontFamily="serif"
                                android:singleLine="true"
                                android:ellipsize="end" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/gst"
                                android:textSize="9.5sp"
                                android:textColor="#0F6E56" />
                        </LinearLayout>

                        <View
                            android:id="@+id/dividerCessKpi"
                            android:layout_width="6dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:id="@+id/cardCessKpi"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_credit_tile_amber"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp">
                            <TextView
                                android:id="@+id/tvCessKpiAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="14sp"
                                android:textColor="#8A6526"
                                android:fontFamily="serif"
                                android:singleLine="true"
                                android:ellipsize="end" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="CESS"
                                android:textSize="9.5sp"
                                android:textColor="#8A6526" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Detail lines — each its own hairline-topped row,
                         same as the design's "detail-line" treatment. -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="12dp"
                        android:background="#D5DDD8" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="@string/tax_breakdown" android:textSize="11.5sp" android:textColor="#7C8782" />
                        <TextView android:id="@+id/tvTaxBreakdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textSize="11.5sp" android:textColor="#1A1A18"
                            android:fontFamily="@font/googlesans_semibold" android:gravity="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowCessBreakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="#D5DDD8" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="7dp">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:text="CESS" android:textSize="11.5sp" android:textColor="#7C8782" />
                            <TextView android:id="@+id/tvCessBreakdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="11.5sp" android:textColor="#1A1A18"
                                android:fontFamily="@font/googlesans_semibold" android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#D5DDD8" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="@string/place_of_supply" android:textSize="11.5sp" android:textColor="#7C8782" />
                        <TextView android:id="@+id/tvPlaceOfSupply" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textSize="11.5sp" android:textColor="#1A1A18"
                            android:fontFamily="@font/googlesans_semibold" android:gravity="end" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#D5DDD8" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="@string/invoice_hint_supplier_gstin" android:textSize="11.5sp" android:textColor="#7C8782" />
                        <TextView android:id="@+id/tvSupplierGstin" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textSize="11.5sp" android:textColor="#1A1A18"
                            android:fontFamily="@font/googlesans_semibold" android:gravity="end" />
                    </LinearLayout>

                    <!-- How this purchase was paid, refunds received and notes still due (display only). -->
                    <TextView
                        android:id="@+id/tvPaymentSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#1A1A18"
                        android:visibility="gone" />

                    <!-- Still owed (credit purchases only) — rounded red
                         banner, same as the design's owed-banner. -->
                    <LinearLayout
                        android:id="@+id/layoutOwed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_credit_tile_red"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/xml_purchase_details_still_owed_label"
                                android:textSize="9sp" android:textColor="#A32D2D"
                                android:fontFamily="@font/googlesans_semibold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/xml_purchase_details_view_ledger_link" android:textSize="10.5sp" android:textColor="#B23A3A" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvOwed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" android:text="0" android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#791F1F" android:fontFamily="serif" />
                    </LinearLayout>
                    <!-- Money still due on this purchase (supplier refund / payment not recorded yet). -->
                    <LinearLayout
                        android:id="@+id/layoutSupplierRefundDue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="11dp"
                        android:background="@drawable/bg_lg_inv_subcard_accent_red"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/due_banner_purchase_collect"
                                android:textSize="12.5sp" android:textStyle="bold" android:textColor="#1A1A18" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/due_banner_action" android:textSize="10.5sp" android:textColor="#B23A3A" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvSupplierRefundDue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" android:text="0" android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#791F1F" android:fontFamily="serif" />
                    </LinearLayout>
                    <!-- Money still due on this purchase (supplier refund / payment not recorded yet). -->
                    <LinearLayout
                        android:id="@+id/layoutSupplierPayDue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="11dp"
                        android:background="@drawable/bg_lg_inv_subcard_accent_red"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/due_banner_purchase_give"
                                android:textSize="12.5sp" android:textStyle="bold" android:textColor="#1A1A18" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/due_banner_action" android:textSize="10.5sp" android:textColor="#B23A3A" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvSupplierPayDue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" android:text="0" android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#791F1F" android:fontFamily="serif" />
                    </LinearLayout>
                </LinearLayout>
            </com.example.easy_billing.ui.glass.GlassClipLinearLayout>

            <!-- ===================== CARD 2 · ITEMS PURCHASED (gold, step 2) ===================== -->
            <com.example.easy_billing.ui.glass.GlassClipLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                
                android:background="@drawable/bg_lg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_lg_hdr_amber"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                        <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_step_circle_ring_champagne"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/googlesans_bold"/>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:id="@+id/tvItemsHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/invoice_line_items_header"
                            android:textColor="#5C4423"
                            android:textSize="15sp"
                            android:fontFamily="@font/googlesans_semibold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/purchase_details_items_card_hint"
                            android:textColor="#8A6526"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPurchaseItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />
            </com.example.easy_billing.ui.glass.GlassClipLinearLayout>

            <!-- ===================== CARD 3 · RETURNS & CORRECTIONS (green, step 3) =====================
                 The whole card (cardReturnsSection) is hidden together when
                 there are no returns — not just the title — so an empty
                 purchase never shows a half-visible card (step circle + hint
                 but no title and no body). Header is teal/green (same
                 treatment as Card 1) per user request, not champagne. -->
            <com.example.easy_billing.ui.glass.GlassClipLinearLayout
                android:id="@+id/cardReturnsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                
                android:background="@drawable/bg_lg_card"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_lg_hdr_green"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                        <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_step_circle_ring"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/googlesans_bold"/>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:id="@+id/tvPriorReturnsHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/xml_purchase_details_notes_header"
                            android:textColor="#123B31"
                            android:textSize="15sp"
                            android:fontFamily="@font/googlesans_semibold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/purchase_details_returns_card_hint"
                            android:textColor="#0F6E56"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPriorReturns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp" />

                <!-- ===================== NET AFTER RETURNS =====================
                     Same "Business Customer" accent-card design as
                     activity_invoice.xml, with a green border
                     (bg_inv_subcard_accent_green) to read as the final
                     settled figure. -->
                <LinearLayout
                    android:id="@+id/rowNetReturns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="12dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="11dp"
                    android:background="@drawable/bg_lg_inv_subcard_accent_green"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_circle_soft_green">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lc_indian_rupee"
                            app:tint="#16A34A"
                            android:contentDescription="@null"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="11dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/xml_purchase_details_net_after_returns"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A18" />
                        <TextView
                            android:id="@+id/tvNetOriginalAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text=""
                            android:textSize="10.5sp"
                            android:fontFamily="serif"
                            android:textColor="#79897F" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNetAfterReturns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="0"
                        android:textSize="22sp"
                        android:fontFamily="serif"
                        android:textStyle="bold"
                        android:textColor="#16A34A"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="16sp"
                        app:autoSizeMaxTextSize="22sp" />
                </LinearLayout>
            </com.example.easy_billing.ui.glass.GlassClipLinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===================== BOTTOM ACTIONS ===================== -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- "Add extra stock" (btnCreditNote / credit note) hidden for
                 now, per explicit request — not deleted. The investigation
                 showed it mechanically duplicates a new purchase (adds stock,
                 adjusts the credit balance) and only adds real value through
                 its GSTR-2 paperwork, which is being redesigned before this
                 comes back. Kotlin's click wiring and the whole credit-note
                 flow are untouched, so re-showing this button is enough to
                 bring it back. btnDebitNote takes the full width alone. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDebitNote"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="@string/txn_label_debit_note"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:fontFamily="@font/googlesans_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                app:backgroundTint="@null"
                android:background="@drawable/bg_lg_cta_green_12"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_lc_arrow_up_right"
                app:iconTint="#FFFFFF"
                app:iconSize="17dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="14dp"
                android:stateListAnimator="@null"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreditNote"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:text="@string/txn_label_credit_note"
                android:textColor="#0F6E56"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:fontFamily="@font/googlesans_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_lc_arrow_down_left"
                app:iconTint="#0F6E56"
                app:iconSize="17dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="14dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#CDE0D8"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCorrectBill"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Correct this bill"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:fontFamily="@font/googlesans_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_lc_sliders"
                app:iconTint="#FFFFFF"
                app:iconSize="17dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="14dp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_lg_cta_gold_14"
                android:stateListAnimator="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCorrectedInvoice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:text="Corrected invoice"
                android:textColor="#8A6526"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:fontFamily="@font/googlesans_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_lc_file_text"
                app:iconTint="#8A6526"
                app:iconSize="17dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="14dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#E3D3AE"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPurchase"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="@string/xml_purchase_details_cancel_button"
            android:textColor="#B23A3A"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_cancel"
            app:iconTint="#B23A3A"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:cornerRadius="14dp"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#E7C9C9"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>

        <!-- Legacy id kept so existing click wiring compiles; hidden. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
