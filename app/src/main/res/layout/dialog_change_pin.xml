<?xml version="1.0" encoding="utf-8"?>
<!--
    "Change login password" dialog — champagne redesign, matching
    dialog_verify_password.xml's card shell, cream inset fields with
    Lucide-style lock icons + eye toggles, and solid teal Save button.

    Ids unchanged: etNewPin, etConfirmPin, btnSavePin, btnCancel — the
    only ones DataSecurityActivity.showChangePinDialog() binds.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:paddingHorizontal="22dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_circle_soft_teal">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_si_key"
            app:tint="#0F6E56"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_change_pin_title_part1"
            android:textColor="#1A1A18"
            android:textSize="19sp"
            android:fontFamily="@font/googlesans_bold"
            android:includeFontPadding="false" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/dialog_change_pin_title_part2"
            android:textColor="#0F6E56"
            android:textSize="19sp"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/dialog_change_pin_subtitle"
        android:textSize="12sp"
        android:textColor="#9A8F79" />

    <!-- New password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="2dp"
        android:text="@string/new_password"
        android:textSize="11sp"
        android:textColor="#9A8F79"
        android:fontFamily="@font/googlesans_semibold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_input">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_lucide_lock"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/etNewPin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingStart="44dp"
            android:paddingEnd="46dp"
            android:hint="@string/new_password"
            android:textSize="14sp"
            android:textColor="#1A1A18"
            android:textColorHint="#A99E88"
            android:singleLine="true"
            android:inputType="textPassword" />

        <ImageView
            android:id="@+id/ivToggleNewPin"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_lucide_eye"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/new_password" />
    </FrameLayout>

    <!-- Confirm password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="2dp"
        android:text="@string/confirm_password"
        android:textSize="11sp"
        android:textColor="#9A8F79"
        android:fontFamily="@font/googlesans_semibold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_input">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_lucide_lock"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/etConfirmPin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingStart="44dp"
            android:paddingEnd="46dp"
            android:hint="@string/confirm_password"
            android:textSize="14sp"
            android:textColor="#1A1A18"
            android:textColorHint="#A99E88"
            android:singleLine="true"
            android:inputType="textPassword" />

        <ImageView
            android:id="@+id/ivToggleConfirmPin"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_lucide_eye"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/confirm_password" />
    </FrameLayout>

    <!-- Save -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSavePin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_login_cta_green"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/save_changes"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:icon="@drawable/ic_lucide_check"
        app:iconTint="#FFFFFF"
        app:iconSize="16dp"
        app:iconGravity="textStart"
        app:iconPadding="7dp"
        app:cornerRadius="14dp"
        app:rippleColor="#33FFFFFF" 
            android:gravity="center"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>

    <!-- Cancel -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:text="@string/cancel"
        android:textColor="#9A2E2E"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textSize="13.5sp"
        android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false"
        android:gravity="center"
        android:background="@drawable/bg_inv_action_close"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:icon="@drawable/ic_close"
        app:iconTint="#B91C1C"
        app:iconSize="16dp"
        app:iconGravity="textStart"
        app:iconPadding="7dp"
        app:cornerRadius="14dp"
        app:rippleColor="#F6D8D4" />

</LinearLayout>
