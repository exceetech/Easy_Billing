<?xml version="1.0" encoding="utf-8"?>
<!-- Add entry form (deposit / withdraw / income / expense). Bound by ManualEntryDialog.form(): flBadge, ivBadge, tvTitleA/B, tvSub, flowStrip, pillFrom, pillTo, barAmount, etAmount, amtError, etNote, modeBlock, modeRow1, modeRow2, btnSave, btnCancel. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_lg_dialog" android:fillViewport="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="20dp" android:paddingBottom="18dp">
        <FrameLayout android:id="@+id/flBadge" android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="center" android:layout_marginBottom="10dp" android:background="@drawable/bg_dialog_soft_amber_circle">
            <ImageView android:id="@+id/ivBadge" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_lucide_plus" app:tint="#8A6526"/>
        </FrameLayout>
        <TextView android:id="@+id/tvEyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mae_eyebrow" android:textSize="10sp" android:letterSpacing="0.16" android:fontFamily="@font/googlesans_semibold" android:textColor="#B8895A" android:gravity="center"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="1dp">
            <TextView android:id="@+id/tvTitleA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mae_title_a" android:textColor="#1A1A18" android:textSize="19sp" android:fontFamily="@font/googlesans_bold" android:includeFontPadding="false"/>
            <TextView android:id="@+id/tvTitleB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/mae_title_b" android:textColor="#0F6E56" android:textSize="19sp" android:textStyle="italic" android:fontFamily="serif" android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView android:id="@+id/tvSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mae_sub" android:textSize="12.5sp" android:textColor="#5B6660" android:gravity="center" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp"/>
        <LinearLayout android:id="@+id/flowStrip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center" android:padding="12dp" android:background="@drawable/bg_lg_card" android:visibility="gone">
            <TextView android:id="@+id/pillFrom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="14dp" android:paddingVertical="7dp" android:textSize="12.5sp" android:fontFamily="@font/googlesans_semibold"/>
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginHorizontal="10dp" android:src="@drawable/ic_lc_chevron_right" app:tint="#9BA7A0"/>
            <TextView android:id="@+id/pillTo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="14dp" android:paddingVertical="7dp" android:textSize="12.5sp" android:fontFamily="@font/googlesans_semibold"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/money_e_amount" android:textSize="10sp" android:textColor="#7C8782" android:fontFamily="@font/googlesans_medium" android:includeFontPadding="false" android:letterSpacing="0.06" android:textAllCaps="true" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/>
        <com.example.easy_billing.ui.glass.GlassClipLinearLayout android:id="@+id/barAmount" android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal" android:background="@drawable/bg_batch_edge_bar" >
            <TextView android:layout_width="54dp" android:layout_height="match_parent" android:gravity="center" android:text="₹" android:textSize="22sp" android:textColor="#1D6E6E" android:fontFamily="serif"/>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E3E8E4"/>
            <EditText android:id="@+id/etAmount" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" android:inputType="numberDecimal" android:textSize="26sp" android:textColor="#1A1A18" android:fontFamily="serif" android:textStyle="bold" android:background="@android:color/transparent" android:paddingStart="0dp" android:paddingEnd="54dp" android:hint="0" android:textColorHint="#B4BDB8" android:importantForAutofill="no"/>
        </com.example.easy_billing.ui.glass.GlassClipLinearLayout>
        <LinearLayout android:id="@+id/amtError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_lc_alert_triangle" app:tint="#B23A3A"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/money_e_amount_bad" android:textSize="11.5sp" android:textColor="#B23A3A" android:fontFamily="@font/googlesans_regular"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/money_e_note" android:textSize="10sp" android:textColor="#7C8782" android:fontFamily="@font/googlesans_medium" android:includeFontPadding="false" android:letterSpacing="0.06" android:textAllCaps="true" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etNote" android:layout_width="match_parent" android:layout_height="46dp" android:background="@drawable/bg_money_edge_bar_champagne" android:paddingHorizontal="14dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:gravity="center_vertical|start" android:includeFontPadding="false" android:inputType="textCapSentences" android:maxLength="40" android:maxLines="1" android:textSize="13.5sp" android:textColor="#1A1A18" android:fontFamily="@font/googlesans_regular" android:textColorHint="#A0ABA4" android:importantForAutofill="no"/>
        <LinearLayout android:id="@+id/modeBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/money_e_mode" android:textSize="10sp" android:textColor="#7C8782" android:fontFamily="@font/googlesans_medium" android:includeFontPadding="false" android:letterSpacing="0.06" android:textAllCaps="true" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:id="@+id/modeRow1" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal"/>
            <LinearLayout android:id="@+id/modeRow2" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:orientation="horizontal"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:text="@string/mae_save" android:textColor="@android:color/white" android:textAllCaps="false" android:textSize="13.5sp" android:fontFamily="@font/googlesans_semibold" android:includeFontPadding="false" android:background="@drawable/bg_lg_cta_gold_14"
        app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp" android:stateListAnimator="@null" app:cornerRadius="14dp" app:icon="@drawable/ic_lc_check" app:iconTint="@android:color/white" app:iconSize="17dp" app:iconGravity="textStart" app:iconPadding="8dp" android:gravity="center"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"
            android:text="@string/dialog_confirm_print_cancel" android:textColor="#9A2E2E" android:textAllCaps="false" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/googlesans_semibold" android:includeFontPadding="false"
            android:background="@drawable/bg_inv_action_close" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp" android:stateListAnimator="@null"
            app:icon="@drawable/ic_close" app:iconTint="#B91C1C" app:iconSize="16dp" app:iconGravity="textStart" app:iconPadding="7dp" app:cornerRadius="14dp" app:rippleColor="#F6D8D4" android:gravity="center"/>
    </LinearLayout>
</ScrollView>
