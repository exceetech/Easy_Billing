<?xml version="1.0" encoding="utf-8"?>
<!--
    Reduce Stock — full-screen champagne page, now reorganised into the
    SAME two-step themed-card chrome as activity_purchase.xml (bg_addp_card
    + tinted header with a numbered step circle + "Required" pill):
    Step 1 "Which batch is this from?" (teal, bg_inv_customer_header /
    bg_step_circle_ring — matches Add Purchase's step 1) holds the batch
    list + running total; Step 2 "Why are you reducing it?" (champagne,
    bg_inv_items_header / bg_step_circle_ring_champagne — matches Add
    Purchase's step 2/4) holds the reason picker and, only when "Return
    to supplier" is chosen, the credit-account toggle. This is a visual
    reorganisation only — every id InventoryActivity.showReduceStockDialog
    binds is unchanged, just moved into the new card chrome:
      tvProductAvatar, tvProductName, tvProductTags, tvCurrentStockLabel, tvStockValue,
      rgReason, rbReturn, rbScrap,
      returnSection, tvTotalLabel, tvBatchCountSub, rvBatches, tvBatchesEmpty, tvBatchRunning,
      btnReasonPicker, tvReasonChoice,
      layoutCreditReturn, cbAdjustCredit, tvReturnAccountName, rowReturnAccount, dividerReturnAccount,
      btnReduceConfirm, btnReduceCancel
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3ECDD">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:navigationIconTint="#1A1A18" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="2dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_reduce_stock_fullscreen_reduce"
                    android:textColor="#B8895A"
                    android:textSize="10sp"
                    android:letterSpacing="0.16"
                    android:fontFamily="@font/googlesans_semibold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="1dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dialog_reduce_stock_fullscreen_take"
                        android:textColor="#1A1A18"
                        android:textSize="23sp"
                        android:letterSpacing="-0.02"
                        android:fontFamily="@font/googlesans_bold"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="@string/dialog_reduce_stock_fullscreen_stock"
                        android:textColor="#791F1F"
                        android:textSize="23sp"
                        android:fontFamily="serif"
                        android:textStyle="italic"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="@string/dialog_reduce_stock_fullscreen_out"
                        android:textColor="#1A1A18"
                        android:textSize="23sp"
                        android:letterSpacing="-0.02"
                        android:fontFamily="@font/googlesans_bold"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Product summary (unchanged plain card, not a numbered step) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_inv_value_card"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvProductAvatar"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="@string/dialog_reduce_stock_fullscreen_br"
                        android:textSize="13sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:textColor="#791F1F"
                        android:background="@drawable/bg_credit_avatar"
                        android:backgroundTint="#FCEBEB"
                        android:includeFontPadding="false"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="11dp">

                        <TextView
                            android:id="@+id/tvProductName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_reduce_stock_fullscreen_product_name"
                            android:textSize="14sp"
                            android:fontFamily="@font/googlesans_medium"
                            android:textColor="#1A1A18"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/tvProductTags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="9.5sp"
                            android:textColor="#8A8272"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="#F1EBDD"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_reduce_stock_fullscreen_available_now"
                            android:textSize="9sp"
                            android:textColor="#9A8F79"/>

                        <TextView
                            android:id="@+id/tvCurrentStockLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:textSize="18sp"
                            android:fontFamily="serif"
                            android:textColor="#1A1A18"
                            android:includeFontPadding="false"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_reduce_stock_fullscreen_stock_value"
                            android:textSize="9sp"
                            android:textColor="#9A8F79"/>

                        <TextView
                            android:id="@+id/tvStockValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:textSize="13.5sp"
                            android:fontFamily="@font/googlesans_semibold"
                            android:textColor="#0F6E56"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- ─ STEP 1 · WHICH BATCH (teal, matches Add Purchase step 1) ─ -->
                <LinearLayout
                    android:id="@+id/returnSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_addp_card"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_customer_header"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">
                        <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                            <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_step_circle_ring"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="1"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="@font/googlesans_bold"/>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dialog_reduce_stock_fullscreen_pick_batches_title"
                                android:textColor="#123B31"
                                android:textSize="15sp"
                                android:fontFamily="@font/googlesans_semibold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dialog_reduce_stock_fullscreen_pick_batches_hint"
                                android:textColor="#3E6F62"
                                android:textSize="11sp"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_red"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="@string/invoice_required"
                            android:textColor="#9B2C2C"
                            android:textSize="10sp"
                            android:fontFamily="@font/googlesans_semibold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvBatchesEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:gravity="center"
                            android:padding="20dp"
                            android:background="@drawable/bg_inv_field_light_grey"
                            android:text="@string/dialog_reduce_stock_fullscreen_no_purchase_batches_available"
                            android:textSize="12sp"
                            android:textColor="#9A8F79"
                            android:visibility="gone"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvBatches"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:descendantFocusability="afterDescendants"/>

                        <!-- Running total — plain field-style row, same
                             bg_inv_field_light_grey treatment as a card-1
                             field box, instead of a separate floating card. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp"
                            android:padding="14dp"
                            android:background="@drawable/bg_inv_field_light_grey">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvTotalLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dialog_reduce_stock_fullscreen_total_to_return"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/googlesans_medium"
                                    android:textColor="#6E6A60"/>

                                <TextView
                                    android:id="@+id/tvBatchCountSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/dialog_reduce_stock_fullscreen_no_batches_selected"
                                    android:textSize="10sp"
                                    android:fontFamily="@font/googlesans_medium"
                                    android:textColor="#8A6526"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvBatchRunning"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="0"
                                android:textSize="26sp"
                                android:fontFamily="serif"
                                android:textStyle="bold"
                                android:textColor="#0F6E56"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="18sp"
                                app:autoSizeMaxTextSize="26sp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- ─ STEP 2 · REASON (champagne, matches Add Purchase step 2) ─ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_addp_card"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_inv_items_header"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">
                        <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                            <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_step_circle_ring_champagne"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="2"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="@font/googlesans_bold"/>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dialog_reduce_stock_fullscreen_reason_title"
                                android:textColor="#5C4423"
                                android:textSize="15sp"
                                android:fontFamily="@font/googlesans_semibold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dialog_reduce_stock_fullscreen_reason_hint"
                                android:textColor="#8A6526"
                                android:textSize="11sp"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_red"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="@string/invoice_required"
                            android:textColor="#9B2C2C"
                            android:textSize="10sp"
                            android:fontFamily="@font/googlesans_semibold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Reason — two big, plainly-labelled selectable
                             rows instead of a hidden dropdown, so both
                             choices are visible at once (Option 19's
                             ThemedDropdown picker is gone; rgReason/
                             rbReturn/rbScrap below still hold the actual
                             selection state unchanged). -->
                        <!-- "Returned to supplier" card — the credit toggle now
                             opens up INSIDE this same card (teal border/tint,
                             icon + title + checkmark on top, a divider, then
                             the toggle row underneath) instead of appearing
                             as a separate grey box further down. The card's
                             background now lives on this outer wrapper so the
                             whole thing (row + toggle) reads as one bordered
                             box; refreshReasonRows() keeps swapping this
                             background between bg_reason_card_selected and
                             _unselected exactly as before. -->
                        <LinearLayout
                            android:id="@+id/cardReasonReturn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_reason_card_selected">

                            <LinearLayout
                                android:id="@+id/rowReasonReturn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="13dp"
                                android:clickable="true"
                                android:focusable="true">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp">
                                    <View android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_circle_soft_teal"/>
                                    <ImageView android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:src="@drawable/ic_lucide_corner_up_left" app:tint="#0F6E56" android:contentDescription="@null"/>
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginStart="12dp">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dialog_reduce_stock_fullscreen_return_to_supplier"
                                        android:textSize="13.5sp"
                                        android:fontFamily="@font/googlesans_semibold"
                                        android:textColor="#1A1A18"/>
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:text="@string/dialog_reduce_stock_fullscreen_return_to_supplier_desc"
                                        android:textSize="10.5sp"
                                        android:textColor="#8A8272"/>
                                </LinearLayout>

                                <View
                                    android:id="@+id/checkReasonReturn"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:background="@drawable/bg_radio_selected"/>
                            </LinearLayout>

                            <!-- Credit-account toggle — now nested inside the
                                 "Returned to supplier" card itself, under a
                                 divider, so it visually "opens" inside that
                                 same box. Same ids as before: layoutCreditReturn,
                                 cbAdjustCredit, tvReturnAccountName, rowReturnAccount,
                                 dividerReturnAccount. -->
                            <LinearLayout
                                android:id="@+id/layoutCreditReturn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingHorizontal="13dp"
                                android:paddingBottom="13dp"
                                android:visibility="visible">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="0.5dp"
                                    android:layout_marginBottom="12dp"
                                    android:background="#CFE3DC"/>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">
                                    <ImageView
                                        android:layout_width="18dp" android:layout_height="18dp"
                                        android:src="@drawable/ic_lucide_wallet" app:tint="#0F6E56" android:contentDescription="@null"/>
                                    <TextView
                                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                        android:layout_marginStart="10dp"
                                        android:text="@string/dialog_reduce_stock_fullscreen_reduce_debt_from_account" android:textColor="#1A1A18" android:textSize="14sp"
                                        android:fontFamily="@font/googlesans_medium"/>
                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbAdjustCredit"
                                        style="@style/EpSwitch"
                                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                </LinearLayout>

                                <View
                                    android:id="@+id/dividerReturnAccount"
                                    android:layout_width="match_parent"
                                    android:layout_height="0.5dp"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginBottom="9dp"
                                    android:background="#EEE7D8"
                                    android:visibility="gone"/>

                                <LinearLayout
                                    android:id="@+id/rowReturnAccount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:visibility="gone">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dialog_reduce_stock_fullscreen_account"
                                        android:textSize="11.5sp"
                                        android:fontFamily="@font/googlesans_medium"
                                        android:textColor="#9A8F79"/>

                                    <TextView
                                        android:id="@+id/tvReturnAccountName"
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:gravity="end"
                                        android:text="@string/dialog_reduce_stock_fullscreen_no_account_selected"
                                        android:textSize="12.5sp"
                                        android:fontFamily="@font/googlesans_medium"
                                        android:textColor="#9A8F79"
                                        android:maxLines="1"
                                        android:ellipsize="end"/>

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginStart="4dp"
                                        android:src="@drawable/ic_chevron_down"
                                        app:tint="#B8895A"
                                        android:rotation="-90"
                                        android:contentDescription="@null"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowReasonScrap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_reason_card_unselected"
                            android:padding="13dp"
                            android:layout_marginTop="10dp"
                            android:clickable="true"
                            android:focusable="true">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp">
                                <View android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_circle_soft_gold"/>
                                <ImageView android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:src="@drawable/ic_lc_alert_triangle" app:tint="#8A6526" android:contentDescription="@null"/>
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dialog_reduce_stock_fullscreen_scrap_damage"
                                    android:textSize="13.5sp"
                                    android:fontFamily="@font/googlesans_semibold"
                                    android:textColor="#1A1A18"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="@string/dialog_reduce_stock_fullscreen_scrap_damage_desc"
                                    android:textSize="10.5sp"
                                    android:textColor="#8A8272"/>
                            </LinearLayout>

                            <View
                                android:id="@+id/checkReasonScrap"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_radio_unselected"/>
                        </LinearLayout>

                        <RadioGroup
                            android:id="@+id/rgReason"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone">

                            <RadioButton
                                android:id="@+id/rbReturn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dialog_reduce_stock_fullscreen_return_to_supplier"
                                android:checked="true"/>

                            <RadioButton
                                android:id="@+id/rbScrap"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dialog_reduce_stock_fullscreen_scrap_damage"/>
                        </RadioGroup>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#F3ECDD">

        <!-- Confirm — same solid-fill structure as btnConfirmReturn in
             activity_sales_return.xml, using the page's red instead of
             Credit Note's teal. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReduceConfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/dialog_reduce_stock_fullscreen_reduce_stock"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="13.5sp"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            app:backgroundTint="@null"
            android:background="@drawable/bg_cta_red"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_lc_check"
            app:iconTint="#FFFFFF"
            app:iconSize="17dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="14dp"/>

        <!-- Cancel — same rose "ghost destructive" treatment as
             btnCancelReturn in activity_sales_return.xml. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReduceCancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/dialog_reduce_stock_fullscreen_cancel"
            android:textColor="#9A2E2E"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:background="@drawable/bg_inv_action_close"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_close"
            app:iconTint="#B91C1C"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconPadding="7dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@null"
            app:rippleColor="#F6D8D4"/>

    </LinearLayout>

</LinearLayout>
