<?xml version="1.0" encoding="utf-8"?>
<!--
    Reduce Stock — full-screen champagne redesign, replacing the old
    dark-gradient MaterialCardView dialog. Same fields/ids as before
    (InventoryActivity.showReduceStockDialog binds them unchanged; only
    rgReason/rbReturn/rbScrap are now a minimal vertical radio list —
    no card, no background, just a dot (bg_radio_dot_reason_selector)
    and label per row with generous spacing — the underlying
    RadioGroup/RadioButton logic in Kotlin is untouched).

    Ids bound by InventoryActivity.showReduceStockDialog:
      tvProductAvatar, tvProductName, tvProductTags, tvCurrentStockLabel, tvStockValue,
      rgReason, rbReturn, rbScrap,
      returnSection, tvTotalLabel, rvBatches, tvBatchesEmpty, tvBatchRunning,
      layoutCreditReturn, cbAdjustCredit, tvReturnAccountName,
      btnReduceConfirm
    (btnReduceCancel is gone — the toolbar back arrow is Cancel now,
    same pattern as dialog_purchase_line.xml)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3ECDD">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:navigationIconTint="#1A1A18" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="2dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_reduce_stock_fullscreen_reduce"
                    android:textColor="#B8895A"
                    android:textSize="10sp"
                    android:letterSpacing="0.16"
                    android:fontFamily="@font/googlesans_semibold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="1dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dialog_reduce_stock_fullscreen_take"
                        android:textColor="#1A1A18"
                        android:textSize="23sp"
                        android:letterSpacing="-0.02"
                        android:fontFamily="@font/googlesans_bold"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="@string/dialog_reduce_stock_fullscreen_stock"
                        android:textColor="#791F1F"
                        android:textSize="23sp"
                        android:fontFamily="serif"
                        android:textStyle="italic"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="@string/dialog_reduce_stock_fullscreen_out"
                        android:textColor="#1A1A18"
                        android:textSize="23sp"
                        android:letterSpacing="-0.02"
                        android:fontFamily="@font/googlesans_bold"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_inv_value_card"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvProductAvatar"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="@string/dialog_reduce_stock_fullscreen_br"
                        android:textSize="13sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:textColor="#791F1F"
                        android:background="@drawable/bg_credit_avatar"
                        android:backgroundTint="#FCEBEB"
                        android:includeFontPadding="false"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="11dp">

                        <TextView
                            android:id="@+id/tvProductName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_reduce_stock_fullscreen_product_name"
                            android:textSize="14sp"
                            android:fontFamily="@font/googlesans_medium"
                            android:textColor="#1A1A18"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/tvProductTags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="9.5sp"
                            android:textColor="#8A8272"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="#F1EBDD"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_reduce_stock_fullscreen_available_now"
                            android:textSize="9sp"
                            android:textColor="#9A8F79"/>

                        <TextView
                            android:id="@+id/tvCurrentStockLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:textSize="18sp"
                            android:fontFamily="serif"
                            android:textColor="#1A1A18"
                            android:includeFontPadding="false"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_reduce_stock_fullscreen_stock_value"
                            android:textSize="9sp"
                            android:textColor="#9A8F79"/>

                        <TextView
                            android:id="@+id/tvStockValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:textSize="13.5sp"
                            android:fontFamily="@font/googlesans_semibold"
                            android:textColor="#0F6E56"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="7dp"
                android:text="@string/dialog_reduce_stock_fullscreen_reason"
                android:textSize="9.5sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/googlesans_semibold"
                android:textColor="#B8895A"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_inv_value_card"
                android:paddingVertical="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_reduce_stock_fullscreen_reason_1"
                    android:textSize="11.5sp"
                    android:textColor="#9A8F79"/>

                <LinearLayout
                    android:id="@+id/btnReasonPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_credit_tile_teal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvReasonChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dialog_reduce_stock_fullscreen_return_to_supplier"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/googlesans_semibold"
                        android:textColor="#085041"/>

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="5dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="#085041"
                        android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rgReason"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/rbReturn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_reduce_stock_fullscreen_return_to_supplier"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbScrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_reduce_stock_fullscreen_scrap_damage"/>
            </RadioGroup>

            <LinearLayout
                android:id="@+id/returnSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="7dp"
                    android:text="@string/dialog_reduce_stock_fullscreen_pick_batches"
                    android:textSize="9.5sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="@font/googlesans_semibold"
                    android:textColor="#B8895A"/>

                <TextView
                    android:id="@+id/tvBatchesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:padding="20dp"
                    android:background="@drawable/bg_inv_value_card"
                    android:text="@string/dialog_reduce_stock_fullscreen_no_purchase_batches_available"
                    android:textSize="12sp"
                    android:textColor="#9A8F79"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBatches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:descendantFocusability="afterDescendants"/>

                <!-- Total value card (Option 1) — white raised card,
                     label + batch-count subtitle on the left, big teal
                     serif figure on the right. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_inv_value_card">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTotalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_reduce_stock_fullscreen_total_to_return"
                            android:textSize="11.5sp"
                            android:fontFamily="@font/googlesans_medium"
                            android:textColor="#9A8F79"/>

                        <TextView
                            android:id="@+id/tvBatchCountSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dialog_reduce_stock_fullscreen_no_batches_selected"
                            android:textSize="10sp"
                            android:fontFamily="@font/googlesans_medium"
                            android:textColor="#8A6526"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBatchRunning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="0"
                        android:textSize="26sp"
                        android:fontFamily="serif"
                        android:textStyle="bold"
                        android:textColor="#0F6E56"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="18sp"
                        app:autoSizeMaxTextSize="26sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="#DDD3BB"/>

                <!-- Credit-account toggle — same card + icon-row +
                     MaterialSwitch structure as "Imported goods" in
                     activity_purchase.xml (style="@style/EpSwitch"). -->
                <LinearLayout
                    android:id="@+id/layoutCreditReturn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_inv_card_cream"
                    android:padding="15dp"
                    android:layout_marginHorizontal="16dp"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_lucide_wallet" app:tint="#B8895A" android:contentDescription="@null"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="@string/dialog_reduce_stock_fullscreen_reduce_debt_from_account" android:textColor="#1A1A18" android:textSize="14sp"
                            android:fontFamily="@font/googlesans_medium"/>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/cbAdjustCredit"
                            style="@style/EpSwitch"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerReturnAccount"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="9dp"
                        android:background="#EEE7D8"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/rowReturnAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_reduce_stock_fullscreen_account"
                            android:textSize="11.5sp"
                            android:fontFamily="@font/googlesans_medium"
                            android:textColor="#9A8F79"/>

                        <TextView
                            android:id="@+id/tvReturnAccountName"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="end"
                            android:text="@string/dialog_reduce_stock_fullscreen_no_account_selected"
                            android:textSize="12.5sp"
                            android:fontFamily="@font/googlesans_medium"
                            android:textColor="#9A8F79"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#B8895A"
                            android:rotation="-90"
                            android:contentDescription="@null"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#F3ECDD">

        <!-- Confirm — same solid-fill structure as btnConfirmReturn in
             activity_sales_return.xml, using the page's red instead of
             Credit Note's teal. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReduceConfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/dialog_reduce_stock_fullscreen_reduce_stock"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="13.5sp"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            app:backgroundTint="@null"
            android:background="@drawable/bg_cta_red"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_lc_check"
            app:iconTint="#FFFFFF"
            app:iconSize="17dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="14dp"/>

        <!-- Cancel — same rose "ghost destructive" treatment as
             btnCancelReturn in activity_sales_return.xml. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReduceCancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/dialog_reduce_stock_fullscreen_cancel"
            android:textColor="#9A2E2E"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/googlesans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:background="@drawable/bg_inv_action_close"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_close"
            app:iconTint="#B91C1C"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconPadding="7dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@null"
            app:rippleColor="#F6D8D4"/>

    </LinearLayout>

</LinearLayout>
