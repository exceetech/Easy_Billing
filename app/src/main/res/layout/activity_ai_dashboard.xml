<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0E6">

    <!-- ── HEADER (toolbar + title row) ── -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="#1A1A18"
        app:navigationIconTint="#1A1A18" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_dashboard_eyebrow"
                android:textColor="#B8895A"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/googlesans_semibold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_dashboard_title_ai"
                    android:textColor="#1A1A18"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:fontFamily="@font/googlesans_bold"
                    android:includeFontPadding="false"
                    android:accessibilityHeading="true"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/ai_dashboard_title_insights_suffix"
                    android:textColor="#0F6E56"
                    android:textSize="21sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <!-- ── AUDIT SCORE (ring + explanation) ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_imp_card"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <FrameLayout android:layout_width="58dp" android:layout_height="58dp">
                        <View android:id="@+id/viewAuditRing"
                            android:layout_width="58dp" android:layout_height="58dp"
                            android:background="@drawable/bg_audit_ring"
                            android:backgroundTint="#0F6E56"/>
                        <TextView android:id="@+id/tvPerformanceScore"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="--"
                            android:textColor="#0F6E56" android:textSize="17sp"
                            android:fontFamily="@font/googlesans_bold"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginStart="14dp" android:layout_marginEnd="22dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/ai_dashboard_audit_score_label" android:textColor="#9A8F79" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvScoreBadge"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="5dp" android:text="@string/dash"
                            android:textColor="#085041" android:textSize="9sp" android:letterSpacing="0.06"
                            android:fontFamily="@font/googlesans_semibold"
                            android:background="@drawable/bg_imp_badge" android:backgroundTint="#DDEEEE"
                            android:paddingHorizontal="7dp" android:paddingVertical="2dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="7dp" android:text="@string/ai_dashboard_audit_score_desc"
                            android:textColor="#9A8F79" android:textSize="11sp" android:lineSpacingMultiplier="1.3"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnScoreInfo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_info_circle"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    app:tint="#9A968C"
                    android:contentDescription="What is the audit score?" />
            </FrameLayout>

            <!-- ── ROW 1: URGENT / LEAKS / WINS (recolored to the champagne
                 red/gold/teal palette instead of the old red/amber/green) ── -->
            <LinearLayout
                android:id="@+id/bentoRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_imp_block_red"
                    android:backgroundTint="#791F1F"
                    android:padding="13dp">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp"
                        android:src="@drawable/ic_kpi_alert" app:tint="#F0C4C4" android:contentDescription="@null"/>
                    <TextView android:id="@+id/tvKpiUrgent"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="0"
                        android:textColor="#FFFFFF" android:textSize="18sp"
                        android:fontFamily="@font/googlesans_bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="1dp" android:text="@string/ai_dashboard_kpi_urgent"
                        android:textColor="#F0C4C4" android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_imp_block_amber"
                    android:backgroundTint="#8A6526"
                    android:padding="13dp">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp"
                        android:src="@drawable/ic_trending_down" app:tint="#F5DBAE" android:contentDescription="@null"/>
                    <TextView android:id="@+id/tvKpiLeaks"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="0"
                        android:textColor="#FFFFFF" android:textSize="18sp"
                        android:fontFamily="@font/googlesans_bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="1dp" android:text="@string/ai_dashboard_kpi_leaks"
                        android:textColor="#F5DBAE" android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_imp_block_green"
                    android:backgroundTint="#085041"
                    android:padding="13dp">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp"
                        android:src="@drawable/ic_kpi_badge_check" app:tint="#9FE1CB" android:contentDescription="@null"/>
                    <TextView android:id="@+id/tvKpiWins"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="0"
                        android:textColor="#FFFFFF" android:textSize="18sp"
                        android:fontFamily="@font/googlesans_bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="1dp" android:text="@string/ai_dashboard_kpi_wins"
                        android:textColor="#9FE1CB" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── ROW 2: TOP PRODUCT VELOCITY (before insights) ── -->
            <LinearLayout
                android:id="@+id/bentoRow3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_imp_card"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_dashboard_top_velocity_title"
                    android:textColor="#1A1A18"
                    android:textSize="14sp"
                    android:fontFamily="@font/googlesans_semibold"
                    android:layout_marginBottom="8dp"/>

                <TableLayout
                    android:id="@+id/tableProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">
                    <TableRow android:paddingVertical="8dp">
                        <TextView
                            android:id="@+id/headerProduct"
                            android:layout_width="0dp"
                            android:layout_weight="2"
                            android:text="@string/ai_dashboard_col_product"
                            android:textColor="#9A8F79"
                            android:textSize="10sp"
                            android:letterSpacing="0.04"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/headerQty"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/ai_dashboard_col_qty"
                            android:gravity="center"
                            android:textColor="#9A8F79"
                            android:textSize="10sp"
                            android:letterSpacing="0.04"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/headerRevenue"
                            android:layout_width="0dp"
                            android:layout_weight="1.2"
                            android:text="@string/ai_dashboard_col_revenue"
                            android:gravity="end"
                            android:textColor="#9A8F79"
                            android:textSize="10sp"
                            android:letterSpacing="0.04"
                            android:textStyle="bold"/>
                    </TableRow>
                </TableLayout>
            </LinearLayout>

            <!-- ── ROW 3: INSIGHTS LIST ── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp">
                <View android:layout_width="3dp" android:layout_height="14dp" android:background="#D4A574"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="@string/ai_insight_header_default"
                    android:textColor="#8A6526"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>
                <TextView
                    android:id="@+id/tvInsightsSummary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text=""
                    android:textColor="#9A8F79"
                    android:textSize="11sp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInsights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/tvInsightsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_dashboard_insights_empty"
                android:textColor="#9A8F79"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/bg_imp_card"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
