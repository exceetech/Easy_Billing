<?xml version="1.0" encoding="utf-8"?>
<!--
    Issued Notes — lists every Credit Note / Debit Note ever issued
    (credit_notes table, noteType 'C'/'D'), behind a segmented tab so
    the heading itself ("Issued notes" / eyebrow "DOCUMENTS") doesn't
    collide with the existing "Credit Accounts" screen's heading.

    Ids bound by CreditDebitNotesActivity:
      toolbar, tabCredit, tabDebit, tvTabCreditLabel, tvTabDebitLabel,
      rvNotes, progressNotes, tvNotesEmpty
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3ECDD">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:titleTextColor="@color/textPrimary"
        app:navigationIconTint="@color/textPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="2dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOCUMENTS"
            android:textColor="#B8895A"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/googlesans_semibold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Issued"
                android:textColor="#1A1A18"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/googlesans_bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="notes"
                android:textColor="#0F6E56"
                android:textSize="21sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNotesSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Against INV-0000"
            android:textSize="11sp"
            android:textColor="#8A6526"
            android:fontFamily="@font/googlesans_medium"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_inv_value_card"
        android:padding="3dp">

        <LinearLayout
            android:id="@+id/tabCredit"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="9dp"
            android:background="@drawable/bg_credit_tile_teal"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabCreditLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Credit notes · 0"
                android:textSize="12.5sp"
                android:fontFamily="@font/googlesans_semibold"
                android:textColor="#085041" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabDebit"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="9dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabDebitLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Debit notes · 0"
                android:textSize="12.5sp"
                android:fontFamily="@font/googlesans_semibold"
                android:textColor="#9A8F79" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <ProgressBar
            android:id="@+id/progressNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNotesEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="32dp"
            android:gravity="center"
            android:text="No notes issued yet"
            android:textSize="12.5sp"
            android:textColor="#9A8F79"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
