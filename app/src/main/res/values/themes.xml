<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= MAIN THEME ================= -->
    <style name="Theme.EasyBilling" parent="Theme.Material3.Light.NoActionBar">

        <item name="android:textViewStyle">@style/AppTextStyle</item>

        <!-- Primary Branding -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primaryLight</item>
        <item name="colorOnPrimaryContainer">@color/textPrimary</item>

        <!-- Secondary Branding -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">#E6F7EC</item>
        <item name="colorOnSecondaryContainer">@color/textPrimary</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorSurfaceVariant">@color/divider</item>
        <item name="colorOnSurfaceVariant">@color/textSecondary</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="colorError">@color/error</item>

        <!-- Default Widget Styles -->
        <item name="materialButtonStyle">@style/Widget.EasyBilling.Button</item>
        <item name="toolbarStyle">@style/Widget.EasyBilling.Toolbar</item>

        <item name="android:textColorHighlight">@android:color/transparent</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="android:autofilledHighlight">@android:color/transparent</item>


    </style>
    
    <!-- ================= AUTH TRANSITION THEME ================= -->
    <style name="Theme.EasyBilling.Auth" parent="Theme.EasyBilling">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <!-- ================= SPLASH THEME ================= -->
    <!-- A windowIsTranslucent theme (like Auth above) never gets the
         Android 12+ system splash screen at all — the OS intentionally
         skips it for translucent/overlay-style windows, which is why the
         icon splash "wasn't shown" while MainActivity was the launcher.
         This opaque theme is only for the tiny redirector SplashActivity,
         so the system splash actually appears before handoff to
         MainActivity. -->
    <style name="Theme.EasyBilling.Splash" parent="Theme.EasyBilling">
        <item name="android:windowSplashScreenBackground">#79B782</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#79B782</item>
        <item name="android:windowBackground">#79B782</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#79B782</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ================= CONFIRM PAYMENT (POPUP) THEME ================= -->
    <!-- ConfirmPaymentActivity is launched as a floating popup over
         SubscriptionActivity rather than a full-screen page — the
         underlying Activity/Intent/ActivityResult plumbing is unchanged,
         only the window presentation. No windowMinWidthMajor/Minor here
         deliberately — those are a PERCENTAGE-of-screen floor, which on
         this landscape-locked app would force the window wide regardless
         of content. The card's actual on-screen size instead comes
         entirely from activity_confirm_payment.xml's own fixed
         width/height (a portrait-proportioned card, not a landscape-wide
         one), so it looks the same on every device. -->
    <style name="Theme.EasyBilling.Dialog" parent="Theme.EasyBilling">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- windowIsFloating pulls in the platform's default floating-
             window drop shadow (windowElevation) unless overridden here —
             that's the shadow around the Confirm and pay card. Zeroed out
             so the card reads as flat, matching the rest of the app's
             flat-card design language instead of a raised/elevated look. -->
        <item name="android:windowElevation">0dp</item>
    </style>

    <!-- ================= RAZORPAY CHECKOUT THEME ================= -->
    <!-- com.razorpay.CheckoutActivity picks up its window theme from
         this Manifest (Razorpay's own docs: "This activity picks up the
         theme from the Manifest file") rather than from whatever Activity
         called checkout.open() — so without an explicit override here it
         was falling back to the app default, which on this screen chain
         (ConfirmPaymentActivity's own translucent Dialog theme) let
         SubscriptionActivity/ConfirmPaymentActivity show through behind
         Razorpay's window instead of a solid backdrop. Deliberately
         opaque + fully solid white, not @color/background (the app's
         champagne page tint) — Razorpay's own checkout UI is designed
         against a plain white surface, and this activity is entirely
         outside our control to re-skin (see the "can I re-theme
         Razorpay's UI" answer), so it should sit on a neutral white
         backdrop rather than clash with the app's warm page color.
         windowIsTranslucent must be true for windowBackground's alpha to
         actually render — with it false, the system forces the window
         fully opaque regardless of the background drawable's own alpha
         channel. #CCFFFFFF = white at 80% opacity (CC = 204/255 ≈ 80%). -->
    <style name="Theme.EasyBilling.RazorpayCheckout" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">#CCFFFFFF</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- ================= BUTTON STYLE ================= -->
    <style name="Widget.EasyBilling.Button" parent="Widget.Material3.Button">

        <item name="shapeAppearance">@style/ShapeAppearance.EasyBilling.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>

        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="backgroundTint">@color/primary</item>

    </style>

    <!-- Rounded Button -->
    <style name="ShapeAppearance.EasyBilling.Button"
        parent="ShapeAppearance.Material3.MediumComponent">

        <item name="cornerSize">12dp</item>

    </style>

    <!-- ================= TOOLBAR ================= -->
    <style name="Widget.EasyBilling.Toolbar"
        parent="Widget.Material3.Toolbar">

        <item name="titleTextColor">@color/white</item>
        <item name="android:background">@color/primary</item>
        <item name="navigationIconTint">@color/white</item>
        <item name="titleTextAppearance">@style/TextAppearance.Material3.TitleLarge</item>

    </style>

</resources>