    <color name="glow_a_mid">#1D0F6E56</color>
    <color name="glow_a_end">#000F6E56</color>
    <color name="glow_b">#496EAFE1</color>
    <color name="glow_b_mid">#246EAFE1</color>
    <color name="glow_b_end">#006EAFE1</color>
</resources>
