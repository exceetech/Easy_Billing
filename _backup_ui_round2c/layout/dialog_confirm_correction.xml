<?xml version="1.0" encoding="utf-8"?>
<!--
    "Save this correction?" confirmation — champagne dialog shell shared with
    dialog_cancel_purchase_confirm.xml. Texts are copied from the result card of
    PurchaseCorrectionActivity at show time.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="20dp" android:fillViewport="false"
    android:overScrollMode="never" android:scrollbars="none">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_lg_dialog"
    android:paddingHorizontal="22dp" android:paddingTop="24dp" android:paddingBottom="20dp">

    <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_circle_soft_teal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
            android:src="@drawable/ic_lc_check" app:tint="#0F6E56" android:contentDescription="@null"/>
    </FrameLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:gravity="center" android:text="@string/correct_qty_eyebrow" android:textColor="#8A6526" android:textSize="11sp"
        android:letterSpacing="0.14" android:fontFamily="@font/googlesans_semibold" android:singleLine="true" android:ellipsize="end"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:orientation="horizontal" android:layout_marginTop="2dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/correct_confirm_title1" android:textColor="#1A1A18" android:textSize="20sp"
            android:fontFamily="@font/googlesans_bold" android:includeFontPadding="false"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="@string/correct_confirm_title2" android:textColor="#0F6E56" android:textSize="20sp"
            android:fontFamily="serif" android:textStyle="italic" android:includeFontPadding="false"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:gravity="center" android:text="@string/correct_confirm_body" android:textColor="#66716B"
        android:textSize="12.5sp" android:lineSpacingExtra="3dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:orientation="vertical" android:background="@drawable/bg_lg_card" android:padding="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/correct_qty_bill_changes" android:textSize="11sp"
            android:fontFamily="@font/googlesans_bold" android:textColor="#5C4A22"/>
        <TextView android:id="@+id/tvConfirmBig" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:fontFamily="serif" android:textStyle="bold" android:textSize="28sp"/>
        <TextView android:id="@+id/tvConfirmLines" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="#1A1A18" android:lineSpacingExtra="4dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tvConfirmSay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/bg_amber_note" android:padding="12dp"
        android:textSize="12.5sp" android:textColor="#5C4A22" android:lineSpacingExtra="2dp"/>

    <TextView android:id="@+id/tvConfirmAccToggle" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:padding="12dp" android:clickable="true" android:focusable="true"
                            android:background="@drawable/bg_acc_bar" android:gravity="center_vertical"
                            android:drawableEnd="@drawable/ic_lc_chevron_right" android:drawableTint="#854F0B"
                            android:text="@string/correct_qty_accountant_show" android:textSize="12.5sp" android:textColor="#854F0B"
                            android:fontFamily="@font/googlesans_semibold"/>
    <LinearLayout android:id="@+id/llConfirmAcc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmSave" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp"
        android:background="@drawable/bg_lg_cta_green_14" app:backgroundTint="@null"
        android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"
        android:text="@string/correct_confirm_yes" android:textAllCaps="false" android:textSize="13.5sp"
        android:textColor="@android:color/white" android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false" android:gravity="center" android:stateListAnimator="@null"
        app:icon="@drawable/ic_lc_check" app:iconTint="@android:color/white" app:iconSize="17dp"
        app:iconGravity="textStart" app:iconPadding="8dp" app:cornerRadius="14dp" app:rippleColor="#33FFFFFF"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmBack" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="9dp"
        android:background="@drawable/bg_dialog_cancel_neutral" app:backgroundTint="@null"
        android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"
        android:text="@string/correct_confirm_back" android:textAllCaps="false" android:textSize="13.5sp"
        android:textColor="#6B5A3A" android:fontFamily="@font/googlesans_semibold"
        android:includeFontPadding="false" android:gravity="center" android:stateListAnimator="@null"
        app:icon="@drawable/ic_chevron_left" app:iconTint="#6B5A3A" app:iconSize="16dp"
        app:iconGravity="textStart" app:iconPadding="8dp" app:cornerRadius="14dp" app:rippleColor="#1F000000"/>
</LinearLayout>
</ScrollView>
