<?xml version="1.0" encoding="utf-8"?>

<!--
  Busy Times — same look as the Trends tab:
  card 1 (teal): hourly bars with morning/afternoon/evening bands, busiest-hour
  box, busiest / average boxes.  card 2 (champagne): ranked hourly breakdown.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="110dp">

        <!-- ============ CARD 1: chart ============ -->
        <com.example.easy_billing.ui.glass.GlassClipLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            
                android:background="@drawable/bg_lg_card"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_lg_hdr_green"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                    <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_step_circle_ring"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lc_clock"
                        app:tint="#FFFFFF"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_overview_busy_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#123B31"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/busy_card_caption"
                        android:textSize="11sp"
                        android:textColor="#0F6E56"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <com.example.easy_billing.util.DayPartBarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"/>

                <TextView
                    android:id="@+id/tvPeakEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/reports_empty_period"
                    android:textColor="#66716B"
                    android:textSize="13sp"
                    android:fontFamily="@font/googlesans_medium"
                    android:visibility="gone"/>

                <!-- Busiest-hour sales box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_trend_total_box"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/busy_total_label"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#5E7A6E"/>
                        <TextView
                            android:id="@+id/tvDelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/dash"
                            android:textSize="11sp"
                            android:fontFamily="@font/googlesans_semibold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:visibility="gone"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvPeakRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dash"
                        android:textSize="19sp"
                        android:fontFamily="serif"
                        android:textStyle="bold"
                        android:textColor="#085041"/>
                </LinearLayout>

                <!-- Busiest / Average — one row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_lg_inv_subcard_accent_green">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_circle_soft_green">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_lc_circle_check"
                                    app:tint="#16A34A"
                                    android:contentDescription="@null"/>
                            </FrameLayout>
                            <TextView
                                android:id="@+id/tvBestLabel"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/busy_best_label"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A18"
                                android:singleLine="true"
                                android:ellipsize="end"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBestValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/dash"
                            android:textSize="18sp"
                            android:fontFamily="serif"
                            android:textStyle="bold"
                            android:textColor="#16A34A"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="12sp"
                            app:autoSizeMaxTextSize="18sp"/>

                        <TextView
                            android:id="@+id/tvBestSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dash"
                            android:textSize="11sp"
                            android:fontFamily="serif"
                            android:textColor="#66716B"
                            android:singleLine="true"
                            android:ellipsize="end"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="0dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_lg_inv_subcard_accent_blue">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_circle_soft_blue">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_lc_indian_rupee"
                                    app:tint="#2A5CA8"
                                    android:contentDescription="@null"/>
                            </FrameLayout>
                            <TextView
                                android:id="@+id/tvAvgLabel"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/busy_avg_label"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A18"
                                android:singleLine="true"
                                android:ellipsize="end"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAvgValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/dash"
                            android:textSize="18sp"
                            android:fontFamily="serif"
                            android:textStyle="bold"
                            android:textColor="#2A5CA8"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="12sp"
                            app:autoSizeMaxTextSize="18sp"/>

                        <TextView
                            android:id="@+id/tvAvgSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dash"
                            android:textSize="11sp"
                            android:fontFamily="serif"
                            android:textColor="#66716B"
                            android:singleLine="true"
                            android:ellipsize="end"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.example.easy_billing.ui.glass.GlassClipLinearLayout>

        <!-- ============ CARD 2: ranked hourly breakdown (champagne) ============ -->
        <com.example.easy_billing.ui.glass.GlassClipLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            
                android:background="@drawable/bg_lg_card"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_lg_hdr_amber"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                    <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_step_circle_ring_champagne"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_si_chart_columns"
                        app:tint="#FFFFFF"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_breakdown_hourly"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#6B4A20"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_caption_hours"
                        android:textSize="11sp"
                        android:textColor="#8A6526"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPeakHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <LinearLayout
                    android:id="@+id/tvBreakdownMore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_growth_positive"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvBreakdownMoreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:text="@string/dash"
                        android:textSize="13sp"
                        android:textColor="#8A6526"
                        android:fontFamily="@font/googlesans_semibold"/>
                    <ImageView
                        android:id="@+id/ivBreakdownMoreChevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="#8A6526"
                        android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>
        </com.example.easy_billing.ui.glass.GlassClipLinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
